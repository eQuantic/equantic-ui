<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The hydration crossing (HydrationCrossingTests): the generator writes the manifest into this
         assembly, where the server reads it, and onto disk, where eqc reads it, as an app's build does. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eQuantic.UI.Compiler\eQuantic.UI.Compiler.csproj" />
    <!-- The code engine, for the one comparison that needs its C# side directly: the cell widths
         against the oracle (CellWidthOracleTests), whose twin half comes from the served bundle. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Code\eQuantic.UI.Code.csproj" />
    <!-- The spreadsheet engine, which the module graph hands every app it compiles: a case builds its
         types as an app does (TranspiledVocabularyConformanceTests). -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Sheet\eQuantic.UI.Sheet.csproj" />
    <!-- The harness imports the runtime helpers from the bundle the Server serves
         (src/eQuantic.UI.Server/wwwroot/runtime.js), and that bundle is a build output of the Server
         now (#273). Building the Server first means every conformance case runs against the runtime of
         THIS tree — it used to read whichever copy was committed, which could lag the source it
         claimed to test. And the Server itself renders the pages whose payload HydrationCrossingTests
         hands to their twins. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Server\eQuantic.UI.Server.csproj" />
    <!-- The component library, which the solution fixture's projects compile against (#624): the
         shared library of a solution holds components, and the app that references it places them. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
    <!-- As the SDK adds it to an app: the generator writes the hydration manifest of the crossing's
         fixture pages (Hydration/), which both halves read. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Generators\eQuantic.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The embedded bun is unpacked by the SDK's own owner (ProgramArchive), so the harness runs the
         bun the tree's zip holds, from where every build runs it (#932). -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Sdk.Tasks\eQuantic.UI.Sdk.Tasks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One metadata reference per assembly for the whole test process, shared by every compilation
         a test creates: a new one per compilation held tens of gigabytes (#481). -->
    <Compile Include="..\Shared\TestReferences.cs" Link="Shared\TestReferences.cs" />
    <!-- How a test starts a program: one deadline over the exit and both streams (#971). -->
    <Compile Include="..\Shared\ChildProcess.cs" Link="Shared\ChildProcess.cs" />
    <!-- A solution written to disk and built as the SDK builds it, an app over the projects it
         references (#624). The compiler's tests read what such a build WROTE, and this suite runs it:
         one fixture, so the two cannot describe two different builds. -->
    <Compile Include="..\eQuantic.UI.Compiler.Tests\ReferencedProjects\Solution.cs" Link="ReferencedProjects\Solution.cs" />
    <Compile Include="..\eQuantic.UI.Compiler.Tests\ReferencedProjects\Built.cs" Link="ReferencedProjects\Built.cs" />
    <Compile Include="..\eQuantic.UI.Compiler.Tests\ReferencedProjects\SharedLibrary.cs" Link="ReferencedProjects\SharedLibrary.cs" />
  </ItemGroup>
</Project>
