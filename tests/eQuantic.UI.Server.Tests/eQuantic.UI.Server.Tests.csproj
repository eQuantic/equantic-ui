<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="Moq" />
    <Using Include="eQuantic.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- How a test starts a program: one deadline over the exit and both streams (#971). -->
    <Compile Include="..\Shared\ChildProcess.cs" Link="Shared\ChildProcess.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Two faces written by the tests' own builder (tests/Shared/TestFont.cs), embedded as the SDK
         embeds an app's: a family no machine has, and no third-party file to licence. -->
    <EmbeddedResource Include="..\Shared\Fonts\*.ttf" LogicalName="eQuantic.UI.Fonts/%(Filename)%(Extension)" />
    <!-- The same face embedded another way, as a library embeds a font for something else: no eQuantic
         build embedded it as a face, so the web serves it only when the theme names it (#1056). -->
    <EmbeddedResource Include="..\Shared\Fonts\Elsewhere\*.ttf" LogicalName="Elsewhere/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eQuantic.UI.Server\eQuantic.UI.Server.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Gtm\eQuantic.UI.Gtm.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Material\eQuantic.UI.Material.csproj" />
    <!-- As the SDK adds it to an app: the generator writes the hydration manifest the server reads
         to know what each fixture page carries to the browser. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Generators\eQuantic.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>