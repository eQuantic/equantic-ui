<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shaped like an APP's test project, on purpose: it references the package and the component
       library an app uses, takes no InternalsVisibleTo, and so reaches only what an app's tests reach.
       That is how it proves "no fixture to copy and no internal type". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eQuantic.UI.Testing\eQuantic.UI.Testing.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Material\eQuantic.UI.Material.csproj" />
    <!-- The app HydrationAssert serves, as an app's test project references the app it tests (#1775). -->
    <ProjectReference Include="..\HydrationSite\HydrationSite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <!-- What the package's buildTransitive folder brings an app's test project: the bun the app was built with,
       written beside the test assembly. A project reference brings no package targets, so it is imported. -->
  <Import Project="..\..\src\eQuantic.UI.Testing\buildTransitive\eQuantic.UI.Testing.targets" />

</Project>
