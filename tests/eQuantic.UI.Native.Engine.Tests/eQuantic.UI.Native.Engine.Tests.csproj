<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This project uses the native track without the native SDK, on purpose: it tests the native
         track. So it says it means to (#324). Every other project of the repository that reaches a
         native assembly meets EQX0001, as an app's would. -->
    <NoWarn>$(NoWarn);EQX0001</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Apple callback tests hand the runtime static [UnmanagedCallersOnly] entry points through
         function pointers, the shape the shells use on a device (#795). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <!-- HandoffStatusTests reads a source probe as syntax, not text. The version is the one
         eQuantic.UI.Native.Build already brings here, so the resolved graph does not move. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Engine\eQuantic.UI.Native.Engine.csproj" />
    <!-- The build tool, so the entitlements manifest is tested against a REAL assembly: this
         test assembly declares the attributes and the reader reads them back off its own PE file. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Build\eQuantic.UI.Native.Build.csproj" />
    <!-- The tasks the SDKs start eqicon with, beside the tests with it, so a case runs the SDK's own
         font step with this build's tool and tasks rather than whatever src/bin last held. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Sdk.Tasks\eQuantic.UI.Sdk.Tasks.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Framework\eQuantic.UI.Native.Framework.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Engine.Reference\eQuantic.UI.Native.Engine.Reference.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Engine.Metal\eQuantic.UI.Native.Engine.Metal.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Engine.Vulkan\eQuantic.UI.Native.Engine.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Components\eQuantic.UI.Native.Components.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Shell.Apple\eQuantic.UI.Native.Shell.Apple.csproj" />
    <!-- The Windows shell, for the same reason the Apple one is here: its bindings are exercised
         against the real system where the system IS Windows, and skip with a reason elsewhere. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Shell.Windows\eQuantic.UI.Native.Shell.Windows.csproj" />
    <!-- The macOS shell, for its key names: a pure mapping, so it is measured on every host. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Shell.MacOS\eQuantic.UI.Native.Shell.MacOS.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Codegen\eQuantic.UI.Codegen.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Hosting\eQuantic.UI.Native.Hosting.csproj" />
    <!-- Referenced as a LIBRARY, not as an analyzer: these tests drive the generator directly
         through CSharpGeneratorDriver and assert its diagnostics. Wired as an analyzer it would
         also run over this project's own code, where there is no program to find. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Native.Generators\eQuantic.UI.Native.Generators.csproj"
                      ReferenceOutputAssembly="true" OutputItemType="" />
    <!-- The SAMPLE is a test subject: the Studio gallery is the SDK's own acceptance surface, and
         walking it is how a real page finds what a unit test never asks. -->
    <ProjectReference Include="..\..\samples\PhotonDesktop\PhotonDesktop.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Charts\eQuantic.UI.Charts.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Spreadsheets\eQuantic.UI.Spreadsheets.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Material\eQuantic.UI.Material.csproj" />
    <!-- The OTHER graph, for ClosedHierarchyTests: the vocabulary's closure has to be asked about
         every assembly that could declare a node, and a scan of the native side alone would report
         nothing about one born in a web realizer. A test project is a leaf, so this is not a
         layering edge — AssemblyLayeringTests deliberately does not name test projects. -->
    <ProjectReference Include="..\..\src\eQuantic.UI.Web\eQuantic.UI.Web.csproj" />
    <ProjectReference Include="..\..\src\eQuantic.UI.Email\eQuantic.UI.Email.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The walk behind "a node belongs to ONE tree", compiled in from the web tests rather than
         copied: the native shells are held to the same rule by the same instrument. -->
    <Compile Include="..\eQuantic.UI.Web.Tests\NodePlacements.cs" Link="Shared\NodePlacements.cs" />
    <!-- The dashboard's signature provider, the one its code screen hands the editor, compiled in so
         its reading of a call is asked here as the panel asks it (LedgerSignaturesTests). The web
         sample is no project this one can reference: it is an app over the web SDK. -->
    <Compile Include="..\..\samples\DefaultUIDashboard\Screens\LedgerSignatures.cs" Link="Samples\LedgerSignatures.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- One metadata reference per assembly for the whole test process, shared by every compilation
         a test creates: a new one per compilation held tens of gigabytes (#481). -->
    <Compile Include="..\Shared\TestReferences.cs" Link="Shared\TestReferences.cs" />
    <!-- How a test starts a program: one deadline over the exit and both streams, and for dotnet a
         build that leaves nothing holding its output (#971). -->
    <Compile Include="..\Shared\ChildProcess.cs" Link="Shared\ChildProcess.cs" />
    <Compile Include="..\Shared\SheetSlotTheme.cs" Link="Shared\SheetSlotTheme.cs" />
    <!-- A TrueType font built in code: a face no machine has installed, with no file to licence. -->
    <Compile Include="..\Shared\TestFont.cs" Link="Shared\TestFont.cs" />
    <!-- Two faces written by that builder, embedded as the SDK embeds an app's, for the shells to
         register (the server's tests embed the same two). -->
    <EmbeddedResource Include="..\Shared\Fonts\*.ttf" LogicalName="eQuantic.UI.Fonts/%(Filename)%(Extension)" />
    <!-- One family, a file at 300, 400 and 700, each glyph a width of its own, so the width a text
         measures says which file set it (#1082). -->
    <EmbeddedResource Include="..\Shared\Fonts\Weights\*.ttf" LogicalName="eQuantic.UI.Fonts/weights/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
