<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Spreadsheets</PackageId>
    <Description>The spreadsheet family of eQuantic.UI: the grid that stands beside Excel and Google Sheets, written once and drawn by every realizer over the engine in eQuantic.UI.Sheet. The formula bar, the name box, the status bar and the toolbar join it as docs/SPREADSHEET-PLAN.md lands them.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The vocabulary, the shared component library it composes (TableView) and the engine it draws:
         a spreadsheet that needed anything platform-specific would be a bug, the same code is realized
         on the web and on Photon. -->
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
    <ProjectReference Include="..\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
    <ProjectReference Include="..\eQuantic.UI.Sheet\eQuantic.UI.Sheet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exactly like eQuantic.UI.Components and eQuantic.UI.Charts: the family's JS lives INSIDE the
         runtime (transpiled modules embedded in runtime.js, byte-pinned to eqc output by
         SharedComponentTranspilationTests), and the sources ship at tools/source so a consumer's eqc
         binds the types a page names. -->
    <Content Include="**\*.cs" Exclude="obj\**;bin\**" PackagePath="tools\source\" />
  </ItemGroup>

</Project>
