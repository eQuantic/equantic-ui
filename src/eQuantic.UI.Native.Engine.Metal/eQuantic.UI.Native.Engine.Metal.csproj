<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Native.Engine.Metal</PackageId>
    <Description>Photon Metal backend (M0 spike) — renders display lists on Apple GPUs via direct Objective-C interop, offscreen. Shaders are runtime-compiled MSL transliterating the engine's normative SDF math; the production path (offline Slang → metallib, plan D3) replaces that once the toolchain lands.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Slang-GENERATED MSL (plan D3): one normative source (Engine/Shaders/Sdf.slang) compiled
         offline; runtime newLibraryWithSource still compiles MSL→binary on device (the metallib
         step joins the packaging work), but the SOURCE now comes from the shared Slang file. -->
    <EmbeddedResource Include="..\eQuantic.UI.Native.Engine\Shaders\Generated\Sdf.metal" LogicalName="Photon.Sdf.metal" />
    <EmbeddedResource Include="..\eQuantic.UI.Native.Engine\Shaders\Generated\Sdf.metallib" LogicalName="Photon.Sdf.metallib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
    <ProjectReference Include="..\eQuantic.UI.Native.Engine\eQuantic.UI.Native.Engine.csproj" />
  </ItemGroup>

</Project>
