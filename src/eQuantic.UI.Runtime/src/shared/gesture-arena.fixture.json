{
  "about": "The arena's cases (#1563), run by GestureArenaFixtureTests against the C# GestureRouter and by gesture-arena.spec.ts against its transpiled twin. Members are listed in hit order, the innermost first: a probe is an ArenaProbe recognizer kept by the router for a detector named like it, whose box starts at its origin; a plain member is a gesture of the SDK's (ArenaMember), which resolves through the entry the down hands it; a sample member is the dashboard's own HoldThenDrag, whose callbacks say what it reported. Each step says what was heard while it ran, in order, and a tick may say when the next deadline is due.",
  "cases": [
    {
      "name": "a lone gesture of the SDK's wins at the close, as it did before any arena",
      "members": [{ "name": "press", "plain": true }],
      "built": [],
      "steps": [
        { "down": [10, 6], "heard": ["press.accept 1"] },
        { "up": [10, 6], "heard": [] }
      ]
    },
    {
      "name": "a lone recognizer wins at the close and still hears its pointer",
