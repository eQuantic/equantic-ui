        { "tab": true, "move": "to A", "focus": "A" },
        { "tab": true, "move": "to B", "focus": "B" },
        { "tab": true, "move": "to C", "focus": "C" },
        { "tab": true, "move": "to A", "focus": "A" }
      ]
    },
