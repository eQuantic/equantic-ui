<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The runtime's TypeScript and its proof. It ships nothing of its own: the bundle an app runs is
        written by eQuantic.UI.Server's BundleRuntime from ../eQuantic.UI.Sdk/Resources/boot.ts, and that
        package carries it. This project once wrote the same bundle a second time into dist/, and CI
        wrote a third, library-shaped one over that path, which is what the separate runtime package
        shipped (#335).
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- The embedded bun of this machine, unpacked where the SDK unpacks it: ResolveEmbeddedBun. -->
    <Import Project="../Shared/EmbeddedBun.targets" />

    <!-- The runtime's own proof, through the same embedded bun — one command on every OS, no Node:
             dotnet build src/eQuantic.UI.Runtime -t:TestRuntime
         Dependencies come from bun.lock as pinned (a drift fails, it is not repaired in passing); tsc
         is the type-check that makes an exhaustive switch fail to compile when a case is missing,
         which the Server's bundle is produced WITHOUT, and vitest runs once and exits. -->
    <Target Name="TestRuntime" DependsOnTargets="ResolveEmbeddedBun">
        <Message Text="eQuantic.UI.Runtime: bun install, tsc, vitest run (embedded bun)..." Importance="high" />
        <ItemGroup>
            <_EqInstallArgument Include="command" Value="install" />
            <_EqInstallArgument Include="lockfile" Value="--frozen-lockfile" />
            <_EqTscArgument Include="command" Value="x" />
            <_EqTscArgument Include="program" Value="tsc" />
            <_EqVitestArgument Include="command" Value="x" />
            <_EqVitestArgument Include="program" Value="vitest" />
            <_EqVitestArgument Include="once" Value="run" />
        </ItemGroup>
        <RunProgram Program="$(_BunPath)" Arguments="@(_EqInstallArgument)" WorkingDirectory="$(MSBuildThisFileDirectory)" />
        <RunProgram Program="$(_BunPath)" Arguments="@(_EqTscArgument)" WorkingDirectory="$(MSBuildThisFileDirectory)" />
        <RunProgram Program="$(_BunPath)" Arguments="@(_EqVitestArgument)" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    </Target>

</Project>
