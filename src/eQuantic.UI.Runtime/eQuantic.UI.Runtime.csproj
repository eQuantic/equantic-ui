<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>eQuantic.UI.Runtime</PackageId>
        <Description>eQuantic UI Runtime environment (Meta-package)</Description>
        <PackageType>Dependency</PackageType>
        <!-- Collect the bundled runtime.js into the package at pack time (after it is generated by
             GenerateRuntimeBundle below). A static <Content Condition="Exists"> would be evaluated
             before any target runs, so a freshly-generated dist would be missed. -->
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectRuntimeBundle</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <IsEQuanticDevMode
            Condition="Exists('../eQuantic.UI.Runtime.Osx64/eQuantic.UI.Runtime.Osx64.csproj')">true</IsEQuanticDevMode>
        <_BootEntry>$(MSBuildThisFileDirectory)../eQuantic.UI.Sdk/Resources/boot.ts</_BootEntry>
        <_RuntimeDist>$(MSBuildThisFileDirectory)dist/index.js</_RuntimeDist>
    </PropertyGroup>

    <!-- Source set that the bundle depends on (drives incremental rebuild of GenerateRuntimeBundle). -->
    <ItemGroup>
        <_RuntimeSources Include="$(MSBuildThisFileDirectory)src/**/*.ts" />
    </ItemGroup>

    <!-- Resolve the embedded Bun (from the sibling platform runtime projects), mirroring the
         Server's ResolveBunForServer. Zero Node: the bundle is produced by the embedded bun. -->
    <Target Name="ResolveBunForRuntime" BeforeTargets="GenerateRuntimeBundle">
        <PropertyGroup>
            <_EqOsArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_EqOsArch>
            <_BunOsxDir Condition="'$(_EqOsArch)' == 'Arm64'">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.OsxArm64/tools/bun</_BunOsxDir>
            <_BunOsxDir Condition="'$(_BunOsxDir)' == ''">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Osx64/tools/bun</_BunOsxDir>
            <_BunOsxPath>$(_BunOsxDir)/bun-darwin</_BunOsxPath>
            <_BunWinPath>$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Win64/tools/bun/bun.exe</_BunWinPath>
            <_BunLinuxPath>$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Linux64/tools/bun/bun-linux</_BunLinuxPath>
            <_BunPath Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(_BunOsxPath)')">$(_BunOsxPath)</_BunPath>
            <_BunPath Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(_BunWinPath)')">$(_BunWinPath)</_BunPath>
            <_BunPath Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(_BunLinuxPath)')">$(_BunLinuxPath)</_BunPath>
        </PropertyGroup>

        <PropertyGroup Condition="'$(_BunPath)' == ''">
            <_BunZipOsx>$(_BunOsxDir)/bun-darwin.zip</_BunZipOsx>
            <_BunZipWin>$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Win64/tools/bun/bun.exe.zip</_BunZipWin>
            <_BunZipLinux>$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Linux64/tools/bun/bun-linux.zip</_BunZipLinux>
        </PropertyGroup>
        <Unzip SourceFiles="$(_BunZipOsx)"
            DestinationFolder="$(_BunOsxDir)"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_BunPath)' == '' And Exists('$(_BunZipOsx)')" />
        <Unzip SourceFiles="$(_BunZipWin)"
            DestinationFolder="$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Win64/tools/bun"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_BunPath)' == '' And Exists('$(_BunZipWin)')" />
        <Unzip SourceFiles="$(_BunZipLinux)"
            DestinationFolder="$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Linux64/tools/bun"
            Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(_BunPath)' == '' And Exists('$(_BunZipLinux)')" />

        <PropertyGroup>
            <_BunPath Condition="'$(_BunPath)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And Exists('$(_BunOsxPath)')">$(_BunOsxPath)</_BunPath>
            <_BunPath Condition="'$(_BunPath)' == '' And $([MSBuild]::IsOSPlatform('Windows')) And Exists('$(_BunWinPath)')">$(_BunWinPath)</_BunPath>
            <_BunPath Condition="'$(_BunPath)' == '' And $([MSBuild]::IsOSPlatform('Linux')) And Exists('$(_BunLinuxPath)')">$(_BunLinuxPath)</_BunPath>
        </PropertyGroup>

        <Exec Command="chmod +x &quot;$(_BunPath)&quot;"
            Condition="'$(_BunPath)' != '' And !$([MSBuild]::IsOSPlatform('Windows'))" />
        <Error Condition="'$(_BunPath)' == ''"
            Text="Bun runtime not found. Ensure eQuantic.UI.Runtime.* projects carry the embedded bun." />
    </Target>

    <!-- Bundle the client runtime (boot.ts -> dist/index.js) with the embedded bun. Same entry the
         Server bundles, so the package's runtime.js and the Server's are produced from one source.
         Incremental: only re-runs when a source .ts (or boot.ts) is newer than the output. -->
    <Target Name="GenerateRuntimeBundle" BeforeTargets="Build"
        Inputs="@(_RuntimeSources);$(_BootEntry);$(MSBuildProjectFullPath)"
        Outputs="$(_RuntimeDist)">
        <Message Text="eQuantic.UI.Runtime: bundling boot.ts -> dist/index.js (bun)..." Importance="high" />
        <MakeDir Directories="$(MSBuildThisFileDirectory)dist" />
        <Exec Command="&quot;$(_BunPath)&quot; build &quot;$(_BootEntry)&quot; --outfile &quot;$(_RuntimeDist)&quot; --minify-syntax --minify-whitespace" />
    </Target>

    <!-- Pack-time collection: include the freshly-bundled runtime.js (+ base CSS) under tools/runtime. -->
    <Target Name="CollectRuntimeBundle" DependsOnTargets="GenerateRuntimeBundle">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_RuntimeDist)" PackagePath="tools/runtime/runtime.js"
                Condition="Exists('$(_RuntimeDist)')" />
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)assets/equantic.css"
                PackagePath="tools/runtime/equantic.css"
                Condition="Exists('$(MSBuildThisFileDirectory)assets/equantic.css')" />
        </ItemGroup>
        <Error Condition="!Exists('$(_RuntimeDist)')"
            Text="eQuantic.UI.Runtime: dist/index.js was not produced — the package would ship without runtime.js." />
    </Target>

</Project>
