<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>eQuantic.UI.Runtime</PackageId>
        <Description>eQuantic UI Runtime environment (Meta-package)</Description>
        <PackageType>Dependency</PackageType>
    </PropertyGroup>

    <PropertyGroup>
        <IsEQuanticDevMode
            Condition="Exists('../eQuantic.UI.Runtime.Osx64/eQuantic.UI.Runtime.Osx64.csproj')">true</IsEQuanticDevMode>
    </PropertyGroup>


    <!-- Package the compiled runtime.js and CSS for consumer projects -->
    <ItemGroup>
        <Content Include="dist\index.js" PackagePath="tools\runtime\runtime.js"
            Condition="Exists('dist\index.js')" />
        <Content Include="assets\equantic.css" PackagePath="tools\runtime\equantic.css"
            Condition="Exists('assets\equantic.css')" />
    </ItemGroup>

</Project>