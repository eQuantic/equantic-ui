<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 is not a choice: it is what Roslyn loads analyzers as. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- The SDK's diagnostics are catalogued in docs/DIAGNOSTICS.md, and
             DiagnosticsDocumentedTests FAILS the build when a code is reported without a row
             there, when a row names a code that no longer exists, or when a code gains a
             reporting site the baseline does not know. Analyzer release tracking would be a
             SECOND hand-maintained table of the same EQ codes, free to drift from the first —
             and the weaker of the two, since it checks only that an id is listed. One
             catalogue, with the guard on it. -->
        <EnableAnalyzerReleaseTracking>false</EnableAnalyzerReleaseTracking>
        <IsRoslynComponent>true</IsRoslynComponent>
        <Description>Writes the other half of an app's Program: the entry point on platforms that have one, and the registration that lets every shell reach the app's CreateApp without reflection.</Description>
        <!-- A source generator ships as an ANALYZER, never a lib: in lib/ the consumer's compiler
             would never load it — dev-mode ProjectReference hid this, and the first app built from
             the packaged SDK had no entry point. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true"
              PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <!-- One rule, two callers: what a bundle key and a URL scheme look like once accepted. The
         builder and the generator cannot reference each other, and they drifted the moment only
         one of them trimmed. -->
    <ItemGroup>
        <Compile Include="../Shared/BundleFactRule.cs" Link="Shared/BundleFactRule.cs" />
    </ItemGroup>

</Project>
