<Project>
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />

    <!--
        What a transpiled module's source map carries (#352): full in Debug (the C# inside, linked
        from the module, for the browser's debugger), none everywhere else. A map with the C# inside
        is the component's source, a [ServerAction]'s body included, and the output folder is a web
        root. `external` writes a map without the C# and without the link, for an error reporter that
        uploads maps itself. Whatever it says, a publish takes no map from eqc's output (below).
    -->
    <PropertyGroup>
        <EQuanticSourceMaps Condition="'$(EQuanticSourceMaps)' == '' And '$(Configuration)' == 'Debug'">full</EQuanticSourceMaps>
        <EQuanticSourceMaps Condition="'$(EQuanticSourceMaps)' == ''">none</EQuanticSourceMaps>
    </PropertyGroup>

    <!--
        Everything in eqc's output folder is written by THIS build: it is build output, as bin and
        obj are, and it is declared where .NET declares that, in DefaultItemExcludes. Three readers
        take it from there.
        - The default Content glob. The static web assets pipeline registers what it finds under
          wwwroot while the project EVALUATES, and the build then rewrites the folder: a file
          registered and then deleted failed the next publish's compression. It happened to the
          maps a Release build removes (#352), and to every shared chunk bun renames when a
          component two pages share changes (#361), in the most ordinary sequence there is: edit,
          then publish.
        - The publish's pre-publish generated content, which takes what a build wrote under wwwroot
          and is not Content, maps included.
        - dotnet watch, which ignores a change that matches it. Without it, every module, map or
          chunk eqc wrote again under dotnet watch was a file added to the project, and dotnet
          watch stopped on the first one (#627, dotnet/sdk#55335).
        An app that includes wwwroot by hand reaches the folder through no default glob, so the
        folder also leaves Content after the project's own items, as it always has.
        `_EQuanticOutputAsStaticWebAssets` below defines the folder from what is on disk once its
        writers have run. All of it takes the compiler's switch: with it off, no writer runs and
        nothing defines the folder again, so its files stay what any file under wwwroot is.
    -->
    <PropertyGroup Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <DefaultItemExcludes>$(DefaultItemExcludes);$(EQuanticOutputPath)**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <Content Remove="$(EQuanticOutputPath)**" />
    </ItemGroup>

    <!--
        WHOSE SOURCE, AND ON WHICH BRANCH. Dev mode swaps the packages for the tree beside the SDK,
        which for a repository OUTSIDE that tree means "whatever branch that repo happens to have
        checked out". A consumer session found this on the native side: it believed it was building
        the released SDK, was actually building an unreviewed feature branch of it, and the branch
        had CHANGED behaviour under it between one build and the next. Neither end had a signal.

        Said once, at high importance, and only for a consumer OUTSIDE the tree — the samples and
        the site scaffolds are always in dev mode and a line on every build is noise nobody reads.
        The comparison is against the REPOSITORY root, `$(_DevRootDir)..`: _DevRootDir is `src/`, and
        measuring against it announces the samples too, since they do not live under src. The branch
        comes out of .git/HEAD rather than from running git, so it costs a file read.
    -->
    <Target Name="EQuanticAnnounceDevSource" BeforeTargets="Build"
            Condition="'$(IsEQuanticDevMode)' == 'true'
                       AND !$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)').StartsWith($([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(_DevRootDir)..'))))))">
        <PropertyGroup>
            <_EqDevHeadFile>$([System.IO.Path]::GetFullPath('$(_DevRootDir)../.git/HEAD'))</_EqDevHeadFile>
        </PropertyGroup>
        <ReadLinesFromFile File="$(_EqDevHeadFile)" Condition="Exists('$(_EqDevHeadFile)')">
            <Output TaskParameter="Lines" PropertyName="_EqDevHead" />
        </ReadLinesFromFile>
        <PropertyGroup>
            <!-- "ref: refs/heads/main" on a branch, a bare SHA when detached (a bisect, a tag). -->
            <_EqDevBranch Condition="'$(_EqDevHead)' != ''">$(_EqDevHead.Replace('ref: refs/heads/', ''))</_EqDevBranch>
            <_EqDevBranch Condition="'$(_EqDevBranch)' == ''">unknown</_EqDevBranch>
        </PropertyGroup>
        <!--
            The branch alone is not enough to answer "is this the same thing I built an hour ago" —
            branches get rebased and reused — and it says nothing at all about UNCOMMITTED work,
            which is the least reproducible state there is and the one with no file to read.

            So one `git describe`, which answers both and one more: `v0.2.0-preview.50-12-g072cc166`
            is the short SHA, how far past the last RELEASE this tree sits, and `-dirty` appended
            when the working tree is modified. Failure is tolerated on purpose — no git, a tarball,
            a shallow copy — and the line still names the branch and the path.
        -->
        <ItemGroup>
            <_EqDescribeArgument Include="repository" Option="-C" Value="$([System.IO.Path]::GetFullPath('$(_DevRootDir)..'))" />
            <_EqDescribeArgument Include="command" Value="describe" />
            <_EqDescribeArgument Include="always" Value="--always" />
            <_EqDescribeArgument Include="dirty" Value="--dirty" />
            <_EqDescribeArgument Include="abbreviation" Value="--abbrev=8" />
        </ItemGroup>
        <RunProgram Program="git" Arguments="@(_EqDescribeArgument)"
              ConsoleToMSBuild="true" StandardOutputImportance="low"
              ContinueOnError="true" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="_EqDevDescribe" />
        </RunProgram>
        <PropertyGroup>
            <_EqDevAt Condition="'$(_EqDevDescribe)' != ''"> @ $(_EqDevDescribe.Trim())</_EqDevAt>
        </PropertyGroup>
        <Message Importance="high"
                 Text="eQuantic.UI: building against SOURCE at $([System.IO.Path]::GetFullPath('$(_DevRootDir)..')) (branch: $(_EqDevBranch)$(_EqDevAt)) — not a released package." />
    </Target>
    <!--
        Where the two tools this SDK runs — eqc (the transpiler) and eqicon (vectors, app icons) —
        are found. ONE question decides both: is this a build from the repository's own tree (the
        samples, the site, a scaffold under test), or a consumer restoring the SDK from NuGet? A
        source tree runs what its ProjectReferences just built — Sdk.props declares them as graph
        edges — never a copy staged beside the SDK by an earlier build: that copy is stale by
        construction, and the dashboard sample once spent a day emitting yesterday's JavaScript and
        reading as proof of today's. A package has no tree here and runs exactly what it shipped
        under tools/. An EqcCliPath the project states wins over both.
    -->
    <PropertyGroup>
        <_SdkToolsDir>$(MSBuildThisFileDirectory)../tools/net10.0/</_SdkToolsDir>
        <_EqSourceTree Condition="Exists('$(MSBuildThisFileDirectory)../../eQuantic.Build/eQuantic.Build.csproj')">true</_EqSourceTree>
        <EqcCliPath Condition="'$(EqcCliPath)' == '' AND '$(_EqSourceTree)' == 'true'">$(MSBuildThisFileDirectory)../../eQuantic.Build/bin/$(Configuration)/net10.0/eqc.dll</EqcCliPath>
        <EqcCliPath Condition="'$(EqcCliPath)' == ''">$(_SdkToolsDir)eqc.dll</EqcCliPath>
        <_EqIconToolDir Condition="'$(_EqSourceTree)' == 'true'">$(MSBuildThisFileDirectory)../../eQuantic.UI.Native.Build/bin/$(Configuration)/net10.0/</_EqIconToolDir>
        <_EqIconToolDir Condition="'$(_EqIconToolDir)' == ''">$(_SdkToolsDir)</_EqIconToolDir>
        <_EqTasksAssembly Condition="'$(_EqSourceTree)' == 'true'">$(MSBuildThisFileDirectory)../../eQuantic.UI.Sdk.Tasks/bin/$(Configuration)/netstandard2.0/eQuantic.UI.Sdk.Tasks.dll</_EqTasksAssembly>
        <_EqTasksAssembly Condition="'$(_EqTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/eQuantic.UI.Sdk.Tasks.dll</_EqTasksAssembly>
        <_EqTaskFactory>AssemblyTaskFactory</_EqTaskFactory>
        <_EqTaskFactory Condition="'$(_EqSourceTree)' == 'true'">TaskHostFactory</_EqTaskFactory>
    </PropertyGroup>
    <!--
        EVERY PROGRAM THIS SDK STARTS, it starts with RunProgram: a program and a list of arguments,
        with no shell between them. MSBuild's Exec writes its command into a script that /bin/sh or
        cmd.exe runs, and each read the command first: with the package folder under a folder named
        `nuget $b`, a build stopped at the first program it started (#841). An argument is an item
        whose Value metadata is the text, after its Option metadata when it names one, so MSBuild
        neither splits it at a semicolon nor expands a wildcard in it; the item's own name is a label.
        A package's assembly is loaded as any task's is (AssemblyTaskFactory, MSBuild's own default).
        A source tree builds the assembly in the same graph that uses it, as it builds eqc, so there
        it is loaded in a task host that ends with the build (TaskHostFactory): a rebuilt assembly is
        the one that runs, and no reused node holds the file.
    -->
    <UsingTask TaskName="eQuantic.UI.Sdk.Tasks.RunProgram" AssemblyFile="$(_EqTasksAssembly)" TaskFactory="$(_EqTaskFactory)" />
    <UsingTask TaskName="eQuantic.UI.Sdk.Tasks.LinkDirectory" AssemblyFile="$(_EqTasksAssembly)" TaskFactory="$(_EqTaskFactory)" />
    <PropertyGroup>
        <_EqOsArch Condition="'$(_EqOsArch)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_EqOsArch>
        <_EqIsArm64 Condition="'$(_EqOsArch)' == 'Arm64'">true</_EqIsArm64>

        <!-- Per-OS + per-architecture embedded-bun package (arm64 native where available, else x64-baseline). -->
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(_EqIsArm64)' == 'true'">eQuantic.UI.Runtime.WinArm64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(_EqIsArm64)' != 'true'">eQuantic.UI.Runtime.Win64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(_EqIsArm64)' == 'true'">eQuantic.UI.Runtime.LinuxArm64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(_EqIsArm64)' != 'true'">eQuantic.UI.Runtime.Linux64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(_EqIsArm64)' == 'true'">eQuantic.UI.Runtime.OsxArm64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(_EqIsArm64)' != 'true'">eQuantic.UI.Runtime.Osx64</BunRuntimePackageId>

        <!-- Zip file name is per-OS (both arch variants of an OS use the same name). -->
        <_BunZipName Condition="$([MSBuild]::IsOSPlatform('Windows'))">bun.exe.zip</_BunZipName>
        <_BunZipName Condition="$([MSBuild]::IsOSPlatform('Linux'))">bun-linux.zip</_BunZipName>
        <_BunZipName Condition="$([MSBuild]::IsOSPlatform('OSX'))">bun-darwin.zip</_BunZipName>
    </PropertyGroup>

    <Target Name="ResolveBunZipPath" BeforeTargets="ResolveBunPath">
        <PropertyGroup>
            <!-- Dev fallback (source tree), keyed by the resolved per-OS+arch runtime package. -->
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../$(BunRuntimePackageId)/tools/bun/$(_BunZipName)')">
                $(MSBuildThisFileDirectory)../../$(BunRuntimePackageId)/tools/bun/$(_BunZipName)</BunZipPath>

            <!-- NuGet package cache: only the matching package's $(Pkg*) is set (conditional refs in Sdk.props). -->
            <BunZipPath Condition="'$(BunZipPath)' == '' and '$(PkgeQuantic_UI_Runtime_OsxArm64)' != ''">$(PkgeQuantic_UI_Runtime_OsxArm64)/tools/bun/$(_BunZipName)</BunZipPath>
            <BunZipPath Condition="'$(BunZipPath)' == '' and '$(PkgeQuantic_UI_Runtime_Osx64)' != ''">$(PkgeQuantic_UI_Runtime_Osx64)/tools/bun/$(_BunZipName)</BunZipPath>
            <BunZipPath Condition="'$(BunZipPath)' == '' and '$(PkgeQuantic_UI_Runtime_WinArm64)' != ''">$(PkgeQuantic_UI_Runtime_WinArm64)/tools/bun/$(_BunZipName)</BunZipPath>
            <BunZipPath Condition="'$(BunZipPath)' == '' and '$(PkgeQuantic_UI_Runtime_Win64)' != ''">$(PkgeQuantic_UI_Runtime_Win64)/tools/bun/$(_BunZipName)</BunZipPath>
            <BunZipPath Condition="'$(BunZipPath)' == '' and '$(PkgeQuantic_UI_Runtime_LinuxArm64)' != ''">$(PkgeQuantic_UI_Runtime_LinuxArm64)/tools/bun/$(_BunZipName)</BunZipPath>
            <BunZipPath Condition="'$(BunZipPath)' == '' and '$(PkgeQuantic_UI_Runtime_Linux64)' != ''">$(PkgeQuantic_UI_Runtime_Linux64)/tools/bun/$(_BunZipName)</BunZipPath>
        </PropertyGroup>
    </Target>

    <Target Name="EnsureBunExtracted" BeforeTargets="ResolveBunPath"
        DependsOnTargets="ResolveBunZipPath">
        <PropertyGroup>
            <BunExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">bun.exe</BunExeName>
            <BunExeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">bun-linux</BunExeName>
            <BunExeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">bun-darwin</BunExeName>

            <BunZipDir Condition="'$(BunZipPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(BunZipPath)'))</BunZipDir>
        </PropertyGroup>
        <PropertyGroup>
            <BunExePath Condition="'$(BunZipDir)' != ''">$(BunZipDir)/$(BunExeName)</BunExePath>
        </PropertyGroup>
        <PropertyGroup Condition="'$(BunExePath)' != ''">
            <BunExePath>$(BunExePath.Trim())</BunExePath>
        </PropertyGroup>

        <!-- Unzip if .exe missing but .zip present -->
        <Message Text="eQuantic.UI: Extracting Bun runtime from '$(BunZipPath)'..."
            Importance="High" Condition="Exists('$(BunZipPath)') And !Exists('$(BunExePath)')" />
        <Unzip
            SourceFiles="$(BunZipPath)"
            DestinationFolder="$(BunZipDir)"
            Condition="Exists('$(BunZipPath)') And !Exists('$(BunExePath)')"
        />

        <!-- Make executable on Linux/Mac -->
        <ItemGroup>
            <_EqBunModeArgument Include="mode" Value="+x" />
            <_EqBunModeArgument Include="bun" Value="$(BunExePath)" />
        </ItemGroup>
        <RunProgram Program="chmod" Arguments="@(_EqBunModeArgument)"
            Condition="Exists('$(BunExePath)') And !$([MSBuild]::IsOSPlatform('Windows'))" />

        <PropertyGroup Condition="Exists('$(BunExePath)')">
            <BunPath>$(BunExePath)</BunPath>
        </PropertyGroup>
    </Target>

    <Target Name="ResolveBunPath" BeforeTargets="CompileEQuanticUI"
        DependsOnTargets="EnsureBunExtracted">
        <PropertyGroup Condition="'$(BunPath)' != ''">
            <BunPath>$(BunPath.Trim())</BunPath>
        </PropertyGroup>
        <Message Text="eQuantic.UI: BunPath resolved to '$(BunPath)'" Importance="High" />
    </Target>

    <!--
        BunPackage: Declare npm packages directly in .csproj (zero package.json).
        Usage: <BunPackage Include="dayjs" Version="1.11.13" />
        Packages are installed to obj/eQuantic/npm/ and symlinked for tool resolution.
    -->
    <Target Name="InstallBunPackages" AfterTargets="ResolveBunPath"
        BeforeTargets="CompileEQuanticUI"
        Condition="'@(BunPackage)' != '' And '$(BunPath)' != ''">

        <PropertyGroup>
            <_BunNpmDir>$(BaseIntermediateOutputPath)eQuantic/npm</_BunNpmDir>
            <_BunNpmNodeModules>$(_BunNpmDir)/node_modules</_BunNpmNodeModules>
        </PropertyGroup>

        <!-- Skip if node_modules already exist (incremental build) -->
        <Message Text="eQuantic.UI: npm packages already installed, skipping..."
            Importance="Normal"
            Condition="Exists('$(_BunNpmNodeModules)')" />

        <!-- Install only if node_modules don't exist -->
        <MakeDir Directories="$(_BunNpmDir)"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <WriteLinesToFile
            File="$(_BunNpmDir)/package.json"
            Lines="{ &quot;private&quot;: true }"
            Overwrite="true"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <Message
            Text="eQuantic.UI: Installing npm packages: @(BunPackage -> '%(Identity)@%(Version)', ', ')..."
            Importance="High"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <!-- One `bun add` a package and version: the packages to add are listed once, under the one
             condition, and the task is batched over what each is handed. Asked before each batch,
             "no node_modules yet" was false from the second on, since the first `bun add` makes it. -->
        <ItemGroup Condition="!Exists('$(_BunNpmNodeModules)')">
            <_EqBunAddCommand Include="command" Value="add" />
            <_EqBunAddPackage Include="@(BunPackage)" Value="%(Identity)@%(Version)" />
        </ItemGroup>
        <RunProgram Program="$(BunPath)" Arguments="@(_EqBunAddCommand);@(_EqBunAddPackage)"
            WorkingDirectory="$(_BunNpmDir)"
            Condition="'%(_EqBunAddPackage.Value)' != ''" />

        <!-- node_modules at the project root for tool resolution, made by the system's own call: the
             Windows half was `mklink /D`, a command of cmd.exe, not a program. What is already there
             stays, a link of an earlier build or a folder of the developer's own. -->
        <LinkDirectory Link="$(MSBuildProjectDirectory)/node_modules"
            Target="$([MSBuild]::NormalizePath('$(_BunNpmDir)', 'node_modules'))" />
    </Target>

    <!--
        A generated file its generator STOPS emitting stays on disk (#253). Roslyn writes the files it
        generates on every compile and deletes none, so obj/.../generated can still hold the factory
        surface of a component the app deleted, and eqc, which reads FILES, transpiles a type that no
        longer exists. Measured on a sample: a compile that RUNS rewrites every generated file, the
        unchanged ones included, so after one, a file older than the compile's start is one it did
        not write. The prune therefore runs only when CoreCompile did, which is when the assembly is
        newer than the start: a skipped compile rewrote nothing, and every file on disk is current.
        That is what a target that wiped the whole directory first got wrong: the compile is skipped
        on an incremental build, nothing rewrote what was deleted, and eqc met no generated surface
        at all — which is why `dotnet clean` used to be the only cure. "The compile ran" compares
        against the EXACT start, and "stale" against two seconds before it: a file system that stores
        whole seconds can then only skip a prune, never delete a file the compile just wrote. A file
        the compile takes as INPUT is not a generator's output and is never a candidate: the SDK's
        own vector catalog (EQuanticVectors) lives in the same folder, written only when its SVGs
        change, and the first cut of this prune deleted it from a sample whose SVGs had not. A
        skipped EQuanticVectors still adds it to @(Compile) (see there), so it is excluded on every
        build, not only on those that rewrote it.
    -->
    <Target Name="_EQuanticMarkCompileStart" BeforeTargets="CoreCompile"
            Condition="'$(EmitCompilerGeneratedFiles)' == 'true'">
        <PropertyGroup>
            <_EQuanticCompileStartTicks>$([System.DateTime]::UtcNow.Ticks)</_EQuanticCompileStartTicks>
            <_EQuanticStaleBeforeTicks>$([System.DateTime]::UtcNow.AddSeconds(-2).Ticks)</_EQuanticStaleBeforeTicks>
        </PropertyGroup>
    </Target>

    <Target Name="_EQuanticPruneStaleGeneratedFiles" AfterTargets="CoreCompile"
            Condition="'$(EmitCompilerGeneratedFiles)' == 'true' And '$(_EQuanticCompileStartTicks)' != '' And '$(CompilerGeneratedFilesOutputPath)' != ''">
        <PropertyGroup>
            <_EQuanticAssemblyPath>@(IntermediateAssembly->'%(FullPath)')</_EQuanticAssemblyPath>
            <_EQuanticCompileRan Condition="Exists('$(_EQuanticAssemblyPath)') And $([System.IO.File]::GetLastWriteTime('$(_EQuanticAssemblyPath)').ToUniversalTime().Ticks) &gt;= $(_EQuanticCompileStartTicks)">true</_EQuanticCompileRan>
        </PropertyGroup>
        <ItemGroup Condition="'$(_EQuanticCompileRan)' == 'true'">
            <_EQuanticGeneratedFile Include="$(CompilerGeneratedFilesOutputPath)/**/*.cs" Exclude="@(Compile)" />
            <_EQuanticStaleGeneratedFile Include="@(_EQuanticGeneratedFile)"
                Condition="$([System.IO.File]::GetLastWriteTime('%(FullPath)').ToUniversalTime().Ticks) &lt; $(_EQuanticStaleBeforeTicks)" />
        </ItemGroup>
        <Delete Files="@(_EQuanticStaleGeneratedFile)" />
        <Message Importance="high" Condition="'@(_EQuanticStaleGeneratedFile)' != ''"
                 Text="eQuantic.UI: removed %(_EQuanticStaleGeneratedFile.Identity), a generated file this compile did not write." />
    </Target>

    <!-- GenerateGlobalUsings must have run before eqc: eqc reads the generated GlobalUsings.g.cs
         into its own compilation (that is how the implicit factory `using static` reaches it), and
         on a FIRST build the file does not exist until the target writes it. -->
    <!--
        THE COMPILE is three targets, chained: what eqc reads (its source roots, and the lists of the
        references, the icon packs and the referenced projects), then what eqc is HANDED (the response
        file), then eqc itself. They were one target, and the middle one is where a value of the
        project reached a shell (#836): it is a target of its own so a test runs it as it ships.
    -->
    <Target Name="_EQuanticCompilerInputs"
        DependsOnTargets="ResolveReferences;FindReferenceAssembliesForReferences;GenerateGlobalUsings"
        Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <PropertyGroup>
            <!-- Standard components source files are packaged in eQuantic.UI.Components package -->
            <!-- Try NuGet cache first (consumer scenario) -->
            <_StandardComponentsDir Condition="'$(PkgeQuantic_UI_Components)' != ''">$(PkgeQuantic_UI_Components)/tools/source</_StandardComponentsDir>

            <!-- Fallback to source tree (development scenario) -->
            <_DevComponentsDir>$(MSBuildThisFileDirectory)../../eQuantic.UI.Components</_DevComponentsDir>
            <_StandardComponentsDir
                Condition="'$(_StandardComponentsDir)' == '' And Exists('$(_DevComponentsDir)')">$(_DevComponentsDir)</_StandardComponentsDir>

            <!-- The SHARED (write-once) component LIBRARY is RUNTIME-PROVIDED: its transpiled modules
                 ship inside runtime.js and eqc routes `using eQuantic.UI.Components` imports
                 there — no per-app scan, and the deliberate name reuse against the standard web
                 components resolves semantically (the page's usings decide). USER-AUTHORED write-once
                 components need no wiring either: they live in the app and flow through the primary
                 scan (docs/SHARED-COMPONENTS-PLAN.md, unification slice 2). -->
            <_EqcSourceDirs>$(MSBuildProjectDirectory);$(_StandardComponentsDir)</_EqcSourceDirs>

            <!-- The chart library is a SECOND shared, runtime-provided library (docs/CHARTS-PLAN.md), and
                 its sources reach eqc the same two ways: the package's tools/source, or the tree. -->
            <_ChartsSourceDir Condition="'$(PkgeQuantic_UI_Charts)' != ''">$(PkgeQuantic_UI_Charts)/tools/source</_ChartsSourceDir>
            <_DevChartsDir>$(MSBuildThisFileDirectory)../../eQuantic.UI.Charts</_DevChartsDir>
            <_ChartsSourceDir Condition="'$(_ChartsSourceDir)' == '' And Exists('$(_DevChartsDir)')">$(_DevChartsDir)</_ChartsSourceDir>
            <_EqcSourceDirs Condition="'$(_ChartsSourceDir)' != '' And Exists('$(_ChartsSourceDir)')">$(_EqcSourceDirs);$(_ChartsSourceDir)</_EqcSourceDirs>

            <!-- The spreadsheet family is a THIRD (docs/SPREADSHEET-PLAN.md), reached the same two ways. -->
            <_SpreadsheetsSourceDir Condition="'$(PkgeQuantic_UI_Spreadsheets)' != ''">$(PkgeQuantic_UI_Spreadsheets)/tools/source</_SpreadsheetsSourceDir>
            <_DevSpreadsheetsDir>$(MSBuildThisFileDirectory)../../eQuantic.UI.Spreadsheets</_DevSpreadsheetsDir>
            <_SpreadsheetsSourceDir Condition="'$(_SpreadsheetsSourceDir)' == '' And Exists('$(_DevSpreadsheetsDir)')">$(_DevSpreadsheetsDir)</_SpreadsheetsSourceDir>
            <_EqcSourceDirs Condition="'$(_SpreadsheetsSourceDir)' != '' And Exists('$(_SpreadsheetsSourceDir)')">$(_EqcSourceDirs);$(_SpreadsheetsSourceDir)</_EqcSourceDirs>
        </PropertyGroup>

        <Error
            Text="eQuantic.UI: Standard components not found. Ensure the eQuantic.UI.Components package (version $(EQuanticUIVersion)) is installed."
            Condition="'$(_StandardComponentsDir)' == '' Or !Exists('$(_StandardComponentsDir)')" />

        <Message Text="eQuantic.UI: Compiling components..." Importance="high" />
        <MakeDir Directories="$(MSBuildProjectDirectory)/$(EQuanticOutputPath)" />

        <!-- Hand eqc the exact assemblies csc compiles against (resolved by ResolveReferences above) so
             its semantic model resolves eQuantic.UI.*, NuGet and project references identically to the
             real build — without this the transpiler can't see base types like HtmlElement.Children and
             degrades member calls (e.g. IList.Add → .add instead of .push). -->
        <MakeDir Directories="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)" />
        <PropertyGroup>
            <_EqcRefsFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)equantic.refs.txt</_EqcRefsFile>
        </PropertyGroup>
        <!-- The reference list is produced by FindReferenceAssembliesForReferences, NOT by
             ResolveReferences — during a full Build this target runs after Compile so the item is
             already populated, but invoked on its own (`dotnet msbuild -t:CompileEQuanticUI`, which
             is exactly what hot reload runs on every save) it was empty, and Overwrite="true"
             truncated a good 316-line file to zero. eqc then fell back to scanning bin/, lost the
             semantic model, and passed named arguments through in SYNTACTIC order — a miscompile
             with no error anywhere. The dependency above is the fix; this condition is the seatbelt,
             because an empty reference set is never worth writing over a good one. -->
        <WriteLinesToFile File="$(_EqcRefsFile)"
            Lines="@(ReferencePathWithRefAssemblies)"
            Overwrite="true" WriteOnlyWhenDifferent="true"
            Condition="'@(ReferencePathWithRefAssemblies)' != ''" />

        <!-- REFERENCE-SOURCE dirs for constant inlining (icon packs): a referenced pack's sources
             enter the compilation SEMANTICALLY so eqc can inline a `static readonly IconGlyph` at the
             use site (tree-shaking each pack to the glyphs used — no per-pack JS module). Reference-
             only: never transpiled. A pack SELF-DECLARES via an EQuanticIconPack.marker in its source
             root, so the SDK discovers whatever pack the developer installed — present or future —
             with no per-pack knowledge and no consumer config, and never over-includes a framework
             assembly (only real packs carry the marker). -->
        <ItemGroup>
            <!-- Package mode (NuGet — the production path): <pkg>/lib/<tfm>/X.dll → <pkg>/tools/source -->
            <_EqcRefSourceCandidate Include="@(ReferencePathWithRefAssemblies->'%(RootDir)%(Directory)../../tools/source')" />
            <!-- Dev mode (monorepo project reference): the pack PROJECT's directory holds its sources. -->
            <_EqcRefSourceCandidate Include="@(ProjectReference->'%(RootDir)%(Directory)')" />
            <!-- Keep ONLY dirs that carry the pack marker (normalized full path, deduped). -->
            <_EqcRefSource Include="@(_EqcRefSourceCandidate->'%(FullPath)')"
                Condition="Exists('%(FullPath)/EQuanticIconPack.marker')" />
            <_EqcRefSourceFinal Include="@(_EqcRefSource->Distinct())" />
        </ItemGroup>
        <PropertyGroup>
            <_EqcRefSourcesFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)equantic.ref-sources.txt</_EqcRefSourcesFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_EqcRefSourcesFile)"
            Lines="@(_EqcRefSourceFinal)"
            Overwrite="true" WriteOnlyWhenDifferent="true"
            Condition="'@(_EqcRefSourceFinal)' != ''" />

        <!-- REFERENCED PROJECTS (#624): every project the app references with a ProjectReference,
             directly or through another, handed to eqc with the assembly MSBuild resolved for it.
             eqc compiles each one's SOURCE in place of that assembly, so a type of a class library a
             page uses is a module of the bundle; read from the assembly it has no source, and the
             page named something nothing defined, with no diagnostic. Derived from what the build
             already resolved: a reference that came from a project carries the project file that
             produced it (MSBuildSourceProjectFile), the transitive ones included. The developer sets
             nothing. Two kinds are left out because they are read another way: the SDK's own
             projects, which an app beside the source tree references in place of packages and whose
             types the runtime provides, and an icon pack, whose constants are inlined where they are
             used (the marker above). -->
        <PropertyGroup>
            <_EqSdkSourceRoot Condition="'$(IsEQuanticDevMode)' == 'true'">$([System.IO.Path]::GetFullPath('$(_DevRootDir)'))</_EqSdkSourceRoot>
            <_EqcProjectsFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)equantic.projects.txt</_EqcProjectsFile>
        </PropertyGroup>
        <ItemGroup>
            <_EqcProjectAssembly Include="@(ReferencePathWithRefAssemblies)"
                Condition="'%(ReferencePathWithRefAssemblies.MSBuildSourceProjectFile)' != ''">
                <EqAssembly>%(FullPath)</EqAssembly>
            </_EqcProjectAssembly>
            <!-- Keyed by the project FILE from here on, so its own directory can be asked of it. -->
            <_EqcReferencedProject Include="@(_EqcProjectAssembly->'%(MSBuildSourceProjectFile)')" />
            <_EqcProject Include="@(_EqcReferencedProject)"
                Condition="!Exists('%(RootDir)%(Directory)EQuanticIconPack.marker') And ('$(_EqSdkSourceRoot)' == '' Or !$([System.String]::Copy('%(FullPath)').StartsWith('$(_EqSdkSourceRoot)')))" />
        </ItemGroup>
    </Target>

    <!--
        WHAT EQC IS HANDED (#836) is a file, and never a shell's argument. A value written into the
        command was read by the shell first: an assembly name `Cash$Flow` reached eqc as `Cash`, and
        a backtick ran as a command; a path holding a `$` met the same end. Every argument is a line of
        a response file now, kept whole as an item's metadata, so a semicolon is not a separator, a
        star is not a glob and a percent sign is not an escape on its way to the file, and eqc reads
        `@<file>` a line an argument. The developer sets nothing.

        The referenced projects' list is two lines a project, the assembly MSBuild resolved for it,
        then its project file: one line `assembly|project file` was cut at the first bar, which a path
        on macOS and Linux may hold. ResolveBunPath is a dependency, because the bundler's path is an
        argument and the hooks named BeforeTargets="CompileEQuanticUI" run after its dependencies.
    -->
    <Target Name="_EQuanticCompilerArguments" DependsOnTargets="_EQuanticCompilerInputs;ResolveBunPath"
        Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <PropertyGroup>
            <_EqcArgumentsPath>$(IntermediateOutputPath)equantic.eqc.rsp</_EqcArgumentsPath>
            <!-- The source roots as one argument, with no line break in it: a root written on
                 several lines of a project file carries them, and a line of the file is an argument.
                 eqc trims the whitespace around each root. -->
            <_EqcSourceDirsArgument>$(_EqcSourceDirs.Replace('&#13;', '').Replace('&#10;', ''))</_EqcSourceDirsArgument>
        </PropertyGroup>
        <WriteLinesToFile File="$(_EqcProjectsFile)"
            Lines="@(_EqcProject->'%(EqAssembly)%0A%(FullPath)')"
            Overwrite="true" WriteOnlyWhenDifferent="true"
            Condition="'@(_EqcProject)' != ''" />
        <ItemGroup>
            <_EqcArgument Remove="@(_EqcArgument)" />
            <_EqcArgument Include="sources" Value="$(_EqcSourceDirsArgument)" />
            <_EqcArgument Include="output" Value="$(MSBuildProjectDirectory)/$(EQuanticOutputPath)" />
            <_EqcArgument Include="refs" Value="--refs" />
            <_EqcArgument Include="refs-file" Value="$(_EqcRefsFile)" />
            <_EqcArgument Include="projects" Value="--projects" Condition="'@(_EqcProject)' != ''" />
            <_EqcArgument Include="projects-file" Value="$(_EqcProjectsFile)" Condition="'@(_EqcProject)' != ''" />
            <!-- Which of those projects references which, from the graph NuGet's restore wrote for the
                 app. Their assemblies cannot say it: a constant read from another project is copied
                 into the reader, so a library that reads only a constant of a project names no
                 reference to it, and eqc compiled it without that project (#887). Only with a value:
                 an empty line is no argument, and the option would take the next one for its file. A
                 build that hands the projects with no graph is then stopped by eqc, saying so. -->
            <_EqcArgument Include="project-assets" Value="--project-assets" Condition="'@(_EqcProject)' != '' And '$(ProjectAssetsFile)' != ''" />
            <_EqcArgument Include="project-assets-file" Value="$(ProjectAssetsFile)" Condition="'@(_EqcProject)' != '' And '$(ProjectAssetsFile)' != ''" />
            <!-- The app's assembly name as MSBuild evaluated it. A project file may set it apart from
                 its own name, and it is the name another assembly knows the app by: a referenced
                 project's InternalsVisibleTo opens its internal types to this name and to no other. -->
            <_EqcArgument Include="assembly-name" Value="--assembly-name" Condition="'$(AssemblyName)' != ''" />
            <_EqcArgument Include="assembly-name-value" Value="$(AssemblyName)" Condition="'$(AssemblyName)' != ''" />
            <_EqcArgument Include="ref-sources" Value="--ref-sources" Condition="'@(_EqcRefSourceFinal)' != ''" />
            <_EqcArgument Include="ref-sources-file" Value="$(_EqcRefSourcesFile)" Condition="'@(_EqcRefSourceFinal)' != ''" />
            <!-- The generated tree for THIS configuration. eqc cannot infer it: a project built Debug
                 and Release has one under each, and sweeping obj would take every generated type
                 twice, resolving to neither while the C# build stays happy. -->
            <_EqcArgument Include="generated" Value="--generated" Condition="'$(CompilerGeneratedFilesOutputPath)' != ''" />
            <_EqcArgument Include="generated-dir" Value="$(MSBuildProjectDirectory)/$(CompilerGeneratedFilesOutputPath)" Condition="'$(CompilerGeneratedFilesOutputPath)' != ''" />
            <_EqcArgument Include="bun" Value="--bun" Condition="'$(BunPath)' != ''" />
            <_EqcArgument Include="bun-path" Value="$(BunPath)" Condition="'$(BunPath)' != ''" />
            <_EqcArgument Include="source-maps" Value="--source-maps" />
            <_EqcArgument Include="source-maps-mode" Value="$(EQuanticSourceMaps)" />
        </ItemGroup>
        <WriteLinesToFile File="$(_EqcArgumentsPath)"
            Lines="@(_EqcArgument->'%(Value)')"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <!-- eqc is handed two arguments: the compiler, and its response file by its full path. -->
    <Target Name="CompileEQuanticUI" BeforeTargets="Build"
        DependsOnTargets="_EQuanticCompilerArguments"
        Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <ItemGroup>
            <_EqcStartArgument Include="compiler" Value="$(EqcCliPath)" />
            <_EqcStartArgument Include="arguments" Value="@$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqcArgumentsPath)'))" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqcStartArgument)" />
    </Target>

    <!--
        A module, a map, a chunk or a culture's catalog eqc STOPS writing is removed by the compile that
        stopped writing it: a removed or renamed component, a shared chunk bun renamed, a culture taken
        out, the maps a Release build does not write. Removed AFTER eqc has written, never before: the
        compile takes seconds, and a folder emptied first served a 404 for every module in between,
        which is where dotnet watch's own refresh of the browser landed on every edit (#627). Measured
        on the dashboard sample, a compile rewrites every file it writes, the unchanged ones included,
        so a file older than its start is one it did not write. "Stale" is two seconds before the start,
        as in the prune of generated sources above: a file system that stores whole seconds can then
        only keep a stale file one compile longer, never delete one the compile just wrote. The runtime
        is not eqc's: CopyEQuanticRuntime writes it, and keeps its source's time when it is unchanged.
    -->
    <Target Name="_EQuanticMarkOutputStart" BeforeTargets="CompileEQuanticUI"
            Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <PropertyGroup>
            <_EQuanticOutputStaleBeforeTicks>$([System.DateTime]::UtcNow.AddSeconds(-2).Ticks)</_EQuanticOutputStaleBeforeTicks>
        </PropertyGroup>
    </Target>

    <Target Name="_EQuanticPruneStaleOutput" AfterTargets="CompileEQuanticUI"
            Condition="'$(EnableEQuanticUICompilation)' == 'true' And '$(_EQuanticOutputStaleBeforeTicks)' != ''">
        <ItemGroup>
            <_EQuanticOutputFile Include="$(EQuanticOutputPath)*.js;$(EQuanticOutputPath)*.js.map;$(EQuanticOutputPath)strings/*.json"
                Exclude="$(EQuanticOutputPath)runtime.js" />
            <_EQuanticStaleOutputFile Include="@(_EQuanticOutputFile)"
                Condition="$([System.IO.File]::GetLastWriteTime('%(FullPath)').ToUniversalTime().Ticks) &lt; $(_EQuanticOutputStaleBeforeTicks)" />
        </ItemGroup>
        <Delete Files="@(_EQuanticStaleOutputFile)" />
    </Target>

    <!--
        No map from eqc's output reaches a publish, whatever EQuanticSourceMaps says (#352). The maps
        are not among the web assets `_EQuanticOutputAsStaticWebAssets` defines, and this filter is the
        second line. An app that removed wwwroot/_equantic/** from Content without defining it again
        saw its second publish ship no bundles at all, with a green build: taking the folder out of
        Content is only half of what that target does.
    -->
    <Target Name="_EQuanticKeepSourceMapsOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <PropertyGroup>
            <_EqPublishedOutput>$([System.String]::Copy('$(EQuanticOutputPath)').Replace('\','/'))</_EqPublishedOutput>
        </PropertyGroup>
        <ItemGroup>
            <_EqPublishedMap Include="@(ResolvedFileToPublish)"
                Condition="'%(Extension)' == '.map' And $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('$(_EqPublishedOutput)'))" />
            <ResolvedFileToPublish Remove="@(_EqPublishedMap)" />
        </ItemGroup>
    </Target>

    <!--
        The runtime beside the app's modules, for the tools that load them outside a server (the VS
        Code preview reads wwwroot/_equantic/runtime.js). A running app never reads this copy: the
        Server answers /_equantic/runtime.js with the bundle it embeds, ahead of the static files.
        So the copy is THAT bundle, byte for byte: from the Server package, or beside a source tree
        from the Server project's own build output. It used to come from a separate runtime package
        holding a library build without `boot` (#335), which no page could have started from.
    -->
    <Target Name="CopyEQuanticRuntime" AfterTargets="CompileEQuanticUI"
        Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <PropertyGroup>
            <_RuntimeSourcePath Condition="'$(PkgeQuantic_UI_Server)' != ''">$(PkgeQuantic_UI_Server)/tools/runtime/runtime.js</_RuntimeSourcePath>
            <_RuntimeSourcePath
                Condition="'$(_RuntimeSourcePath)' == '' And Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Server/wwwroot/runtime.js')">$(MSBuildThisFileDirectory)../../eQuantic.UI.Server/wwwroot/runtime.js</_RuntimeSourcePath>
            <_RuntimeDestPath>$(MSBuildProjectDirectory)/$(EQuanticOutputPath)runtime.js</_RuntimeDestPath>
        </PropertyGroup>

        <Error
            Text="eQuantic.UI: the served runtime was not found. It ships inside the eQuantic.UI.Server package (version $(EQuanticUIVersion)) at tools/runtime/runtime.js; try 'dotnet restore --force'."
            Condition="'$(_RuntimeSourcePath)' == '' Or !Exists('$(_RuntimeSourcePath)')" />

        <Copy SourceFiles="$(_RuntimeSourcePath)" DestinationFiles="$(_RuntimeDestPath)" SkipUnchangedFiles="true" />
        <!-- The base stylesheet an earlier SDK copied here and no page linked (#335): a file its writer
             stopped producing goes with it, as a generator's leftovers do, instead of being served. -->
        <Delete Files="$(MSBuildProjectDirectory)/$(EQuanticOutputPath)equantic.css" />
    </Target>

    <PropertyGroup>
        <GenerateComputedBuildStaticWebAssetsDependsOn>$(GenerateComputedBuildStaticWebAssetsDependsOn);_EQuanticOutputAsStaticWebAssets</GenerateComputedBuildStaticWebAssetsDependsOn>
    </PropertyGroup>

    <!--
        The output folder as web assets, defined from what is ON DISK once its writers have run: the
        compiler (the modules, the chunks bun splits out, the string catalogs), the runtime's copy and
        the app icon. This is the pipeline's own hook for assets a build generates, which runs after
        CoreCompile and before the pipeline resolves its inputs, so the compression, the manifests and
        the publish see this build's files and only those. The parameters are the ones the SDK's own
        discovery of wwwroot passes, so an asset here is what that discovery would have made of the
        file had it existed while the project evaluated. The maps stay out: a debugger reads them from
        disk, and a publish never takes one (#352).
    -->
    <Target Name="_EQuanticOutputAsStaticWebAssets"
        DependsOnTargets="CoreCompile;CompileEQuanticUI;CopyEQuanticRuntime;EQuanticWebAppIcon"
        Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <ItemGroup>
            <_EqOutputFile Include="$(EQuanticOutputPath)**" Exclude="$(EQuanticOutputPath)**/*.map" />
        </ItemGroup>
        <DefineStaticWebAssets
            CandidateAssets="@(_EqOutputFile)"
            FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
            FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
            RelativePathPattern="wwwroot/**"
            SourceType="Discovered"
            SourceId="$(PackageId)"
            ContentRoot="$(MSBuildProjectDirectory)\wwwroot\"
            BasePath="$(StaticWebAssetBasePath)"
            AssetMergeSource="$(StaticWebAssetMergeTarget)">
            <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
            <Output TaskParameter="Assets" ItemName="_EqOutputStaticWebAsset" />
        </DefineStaticWebAssets>
        <DefineStaticWebAssetEndpoints
            CandidateAssets="@(_EqOutputStaticWebAsset)"
            ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
            <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>
    </Target>

    <!--
        The app icon, from the same source the device SDK uses: `Assets/AppIcon.png` (artwork a
        designer made) or `Assets/AppIcon.cs` (an IAppIcon the engine draws). A browser asks for the
        sizes up front and for a manifest describing them, so those are written into wwwroot and the
        shell links them — an app states its icon ONCE and it appears wherever it belongs.
        The property names are shared with eQuantic.UI.Sdk.Native on purpose.
    -->
    <PropertyGroup>
        <EQuanticAssetsDir Condition="'$(EQuanticAssetsDir)' == ''">$(MSBuildProjectDirectory)/Assets</EQuanticAssetsDir>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(EQuanticAssetsDir)/AppIcon.png')">$(EQuanticAssetsDir)/AppIcon.png</EQuanticAppIconSource>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(EQuanticAssetsDir)/AppIcon.cs')">$(EQuanticAssetsDir)/AppIcon.cs</EQuanticAppIconSource>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(MSBuildProjectDirectory)/AppIcon.png')">$(MSBuildProjectDirectory)/AppIcon.png</EQuanticAppIconSource>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(MSBuildProjectDirectory)/AppIcon.cs')">$(MSBuildProjectDirectory)/AppIcon.cs</EQuanticAppIconSource>

        <!-- The name a browser installs the app under. The SAME property the device head uses, so
             an app that cares states it once; absent that, the assembly's name is what .NET would
             have called it anyway. -->
        <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(AssemblyName)</ApplicationTitle>
        <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(MSBuildProjectName)</ApplicationTitle>
    </PropertyGroup>

    <!--
        The app's VECTOR ARTWORK: every `Assets/**/*.svg`, read here and written as one C# class of
        drawing data. Nothing at runtime reads a file — the browser cannot, and a phone would be
        carrying the artwork twice — so an app points at a file and compiles against
        `Vectors.Mark`, which is a compile error when it is wrong.

        It lands under the compiler's own generated tree, which is where eqc already looks (the
        generated-sources flag), so the same drawing reaches C#, the transpiler and both realizers.
    -->
    <PropertyGroup>
        <EQuanticVectorsFile Condition="'$(EQuanticVectorsFile)' == ''">$(IntermediateOutputPath)generated/eQuantic.UI.Vectors/Vectors.g.cs</EQuanticVectorsFile>
        <EQuanticVectorsNamespace Condition="'$(EQuanticVectorsNamespace)' == ''">$(RootNamespace)</EQuanticVectorsNamespace>
        <EQuanticVectorsNamespace Condition="'$(EQuanticVectorsNamespace)' == ''">$(AssemblyName)</EQuanticVectorsNamespace>
    </PropertyGroup>

    <!--
        FAIL LOUD, never skip. `EQuanticVectors` used to carry `Exists(eqicon.dll)` on its own
        Condition, so a missing tool meant no Vectors.g.cs and a CS0103 on `Vectors` two targets
        later — an error about a symbol, for a cause about a tool, on a cold build only. With the
        tool declared as a graph edge it is present in dev mode by construction, and present in
        package mode because the SDK ships it under tools/; the only way to get here without it is a
        broken package or a broken tree, and that deserves its own name.
    -->
    <Target Name="EQuanticRequireIconTool" BeforeTargets="EQuanticVectors;EQuanticFonts;EQuanticWebAppIcon"
        Condition="(Exists('$(EQuanticAssetsDir)') OR '$(EQuanticAppIconSource)' != '') AND !Exists('$(_EqIconToolDir)eqicon.dll')">
        <Error Code="EQ4001"
            Text="This project generates assets with the eQuantic icon tool (the vector and font catalogs from '$(EQuanticAssetsDir)', the app icon from '$(EQuanticAppIconSource)'), and the tool is missing at '$(_EqIconToolDir)eqicon.dll'. In a source-tree build this is a broken build graph (eQuantic.UI.Native.Build did not build first); from a package it is a broken SDK package. Neither is fixed by building twice." />
    </Target>

    <!--
        What the catalog is made from, as ITEMS. A target's Inputs expands no wildcard written in a
        plain string: `$(EQuanticAssetsDir)/**/*.svg` named one file that never exists, MSBuild
        logged "Input file … does not exist", and EQuanticVectors started eqicon on every build of
        every app with an Assets folder. The record of the SET is what notices a deletion, the
        mechanism CoreCompile's own CoreCompileInputs.cache uses: removing an SVG leaves every
        remaining one older than the catalog, and only a list of the set changes. The namespace is
        in the record because it changes the catalog too.
    -->
    <Target Name="_EQuanticVectorInputs" Condition="Exists('$(EQuanticAssetsDir)')">
        <ItemGroup>
            <_EqVectorSource Include="$(EQuanticAssetsDir)/**/*.svg" />
        </ItemGroup>
        <PropertyGroup>
            <_EqVectorInputsFile>$(IntermediateOutputPath)equantic.vectors.inputs</_EqVectorInputsFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_EqVectorInputsFile)"
            Lines="@(_EqVectorSource->'%(FullPath)');namespace=$(EQuanticVectorsNamespace)"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="EQuanticVectors" BeforeTargets="BeforeCompile;CompileEQuanticUI"
        DependsOnTargets="_EQuanticVectorInputs"
        Condition="Exists('$(EQuanticAssetsDir)')"
        Inputs="@(_EqVectorSource);$(_EqVectorInputsFile);$(_EqIconToolDir)eqicon.dll"
        Outputs="$(EQuanticVectorsFile)">
        <ItemGroup>
            <_EqVectorsArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqVectorsArgument Include="command" Value="vectors" />
            <_EqVectorsArgument Include="assets" Option="--assets" Value="$(EQuanticAssetsDir)" />
            <_EqVectorsArgument Include="catalog" Option="--out" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(EQuanticVectorsFile)'))" />
            <_EqVectorsArgument Include="namespace" Option="--namespace" Value="$(EQuanticVectorsNamespace)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqVectorsArgument)" StandardOutputImportance="normal" />
        <!-- eqicon writes only when the catalog changed, so an edit that leaves it the same would
             leave it older than its inputs, and this target would run on every build after. -->
        <Touch Files="$(EQuanticVectorsFile)" Condition="Exists('$(EQuanticVectorsFile)')" />

        <!-- Added HERE, not in a file-scope ItemGroup: an `Exists` condition outside a target is
             answered while MSBuild evaluates the project, which is before this target has written
             anything. A cold build failed on `Vectors` not existing and the next one passed —
             the shape of bug that reads as flaky and is not. It is added when the target is
             SKIPPED too, because MSBuild still runs a skipped target's ItemGroups (output
             inference): that is what keeps the catalog a compile input, and out of the stale-file
             prune above, on every build whose SVGs did not change. -->
        <ItemGroup>
            <Compile Include="$(EQuanticVectorsFile)" Condition="Exists('$(EQuanticVectorsFile)')" />
        </ItemGroup>
    </Target>

    <!--
        The app's FACES: every OpenType file under Assets, embedded in the app's assembly and read by
        eqicon into one class with a FontFamily per family (#1055). The server serves a face from the
        assembly and Photon registers it from there, so the file is copied nowhere else, and the app
        declares nothing: the family, the weights and the italic are read from the file itself.

        Embedded at EVALUATION, where every other EmbeddedResource is: a font is a source file, there
        when MSBuild evaluates the project, and the compile's resource inputs are settled before any
        target of this file runs. The items state each file's resource name once, and the catalog is
        handed that name rather than deriving it a second time. The name is the file's own, with no
        folder: a font file is already named for its family and its style, and two that share a name
        stop the compile on the duplicate resource, naming it.
    -->
    <PropertyGroup>
        <EQuanticFontsFile Condition="'$(EQuanticFontsFile)' == ''">$(IntermediateOutputPath)generated/eQuantic.UI.Fonts/Fonts.g.cs</EQuanticFontsFile>
        <EQuanticFontsNamespace Condition="'$(EQuanticFontsNamespace)' == ''">$(RootNamespace)</EQuanticFontsNamespace>
        <EQuanticFontsNamespace Condition="'$(EQuanticFontsNamespace)' == ''">$(AssemblyName)</EQuanticFontsNamespace>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(EQuanticAssetsDir)')">
        <EmbeddedResource Include="$(EQuanticAssetsDir)/**/*.ttf;$(EQuanticAssetsDir)/**/*.otf" EQuanticFont="true"
            LogicalName="eQuantic.UI.Fonts/%(Filename)%(Extension)" />
    </ItemGroup>

    <!--
        A family from GOOGLE FONTS (#1057): `[assembly: GoogleFont("Inter", FontWeight.Bold)]` anywhere in
        the app's C#. eqicon reads the files that mention it, fetches the file of each cut they declare,
        pins it in fonts.lock.json beside the project (the SDK writes it and the app commits it, as it
        commits NuGet's packages.lock.json) and keeps it under obj, one file a cut. The files are embedded
        here as the faces under Assets are, so the catalog reads them and nothing after it knows a
        provider exists.

        BEFORE AssignTargetPaths, the first target that reads EmbeddedResource. Measured: a target before
        PrepareResources runs after the resource pipeline has read the items, and the face was not
        embedded. Which files mention the attribute is read here, in MSBuild, so an app that declares no
        family starts no program: the tool runs when a file does, or when a lock is left to bring in step.
        A design-time build asks nobody, and embeds what the last build fetched.
    -->
    <PropertyGroup>
        <_EqGoogleFontsLock>$(MSBuildProjectDirectory)/fonts.lock.json</_EqGoogleFontsLock>
        <_EqGoogleFontsDir>$(BaseIntermediateOutputPath)equantic/fonts/google/</_EqGoogleFontsDir>
    </PropertyGroup>
    <Target Name="EQuanticGoogleFonts" BeforeTargets="AssignTargetPaths">
        <ItemGroup>
            <_EqGoogleFontCandidate Include="@(Compile)" Condition="Exists('%(Compile.FullPath)')" />
            <_EqGoogleFontSource Include="@(_EqGoogleFontCandidate)"
                Condition="$([System.IO.File]::ReadAllText('%(_EqGoogleFontCandidate.FullPath)').Contains('GoogleFont'))" />
        </ItemGroup>
        <PropertyGroup>
            <_EqGoogleFontSourcesFile>$(IntermediateOutputPath)equantic.google-fonts.txt</_EqGoogleFontSourcesFile>
            <_EqFetchGoogleFonts Condition="'$(DesignTimeBuild)' != 'true' AND ('@(_EqGoogleFontSource)' != '' OR Exists('$(_EqGoogleFontsLock)'))">true</_EqFetchGoogleFonts>
        </PropertyGroup>
        <Error Code="EQ4001" Condition="'$(_EqFetchGoogleFonts)' == 'true' AND !Exists('$(_EqIconToolDir)eqicon.dll')"
            Text="This project declares families from Google Fonts, which the eQuantic icon tool fetches, and the tool is missing at '$(_EqIconToolDir)eqicon.dll'. In a source-tree build this is a broken build graph (eQuantic.UI.Native.Build did not build first); from a package it is a broken SDK package. Neither is fixed by building twice." />
        <WriteLinesToFile File="$(_EqGoogleFontSourcesFile)" Condition="'$(_EqFetchGoogleFonts)' == 'true'"
            Lines="@(_EqGoogleFontSource->'%(FullPath)')" Overwrite="true" />
        <ItemGroup Condition="'$(_EqFetchGoogleFonts)' == 'true'">
            <_EqGoogleFontsArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqGoogleFontsArgument Include="command" Value="fetch-fonts" />
            <_EqGoogleFontsArgument Include="sources" Option="--sources" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqGoogleFontSourcesFile)'))" />
            <_EqGoogleFontsArgument Include="lock" Option="--lock" Value="$(_EqGoogleFontsLock)" />
            <_EqGoogleFontsArgument Include="dir" Option="--dir" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqGoogleFontsDir)'))" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqGoogleFontsArgument)" StandardOutputImportance="normal"
            Condition="'$(_EqFetchGoogleFonts)' == 'true'" />
        <ItemGroup Condition="Exists('$(_EqGoogleFontsLock)')">
            <_EqGoogleFontFile Include="$(_EqGoogleFontsDir)*.ttf" />
            <EmbeddedResource Include="@(_EqGoogleFontFile)" EQuanticFont="true"
                LogicalName="eQuantic.UI.Fonts/google/%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <!-- What eqicon is handed, two lines a file: its path, then the resource name it is embedded under.
         One line a file, `path|resource`, was cut at the first bar, which a path may hold on macOS and
         Linux, and the record was passed over: a catalog with no face, and a theme that named one did
         not compile. Beside it, the record of the SET, as the vectors keep one: a removed font changes
         no remaining file, and the assembly and the namespace change the catalog too. -->
    <Target Name="_EQuanticFontInputs">
        <ItemGroup>
            <_EqFontSource Include="@(EmbeddedResource->WithMetadataValue('EQuanticFont', 'true'))" />
        </ItemGroup>
        <PropertyGroup>
            <_EqFontListFile>$(IntermediateOutputPath)equantic.fonts.txt</_EqFontListFile>
            <_EqFontInputsFile>$(IntermediateOutputPath)equantic.fonts.inputs</_EqFontInputsFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_EqFontListFile)" Condition="'@(_EqFontSource)' != ''"
            Lines="@(_EqFontSource->'%(FullPath)%0A%(LogicalName)')"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
        <WriteLinesToFile File="$(_EqFontInputsFile)" Condition="'@(_EqFontSource)' != ''"
            Lines="assembly=$(AssemblyName);namespace=$(EQuanticFontsNamespace)"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="EQuanticFonts" BeforeTargets="BeforeCompile;CompileEQuanticUI"
        DependsOnTargets="_EQuanticFontInputs"
        Condition="'@(EmbeddedResource->WithMetadataValue('EQuanticFont', 'true'))' != ''"
        Inputs="@(_EqFontSource);$(_EqFontListFile);$(_EqFontInputsFile);$(_EqIconToolDir)eqicon.dll"
        Outputs="$(EQuanticFontsFile)">
        <ItemGroup>
            <_EqFontsArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqFontsArgument Include="command" Value="fonts" />
            <!-- Joined to the project only when relative: an artifacts layout or a shared obj makes
                 the intermediate path absolute, and a prefix would name a file nobody wrote. -->
            <_EqFontsArgument Include="list" Option="--list" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqFontListFile)'))" />
            <_EqFontsArgument Include="assembly" Option="--assembly" Value="$(AssemblyName)" />
            <_EqFontsArgument Include="catalog" Option="--out" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(EQuanticFontsFile)'))" />
            <_EqFontsArgument Include="namespace" Option="--namespace" Value="$(EQuanticFontsNamespace)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqFontsArgument)" StandardOutputImportance="normal" />
        <Touch Files="$(EQuanticFontsFile)" Condition="Exists('$(EQuanticFontsFile)')" />
        <!-- Added here, and when the target is skipped too, for the reasons the vectors give. -->
        <ItemGroup>
            <Compile Include="$(EQuanticFontsFile)" Condition="Exists('$(EQuanticFontsFile)')" />
        </ItemGroup>
    </Target>

    <Target Name="EQuanticWebAppIcon" BeforeTargets="Build"
        Condition="'$(EQuanticAppIconSource)' != ''">
        <ItemGroup>
            <_EqWebIconArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqWebIconArgument Include="source" Option="--source" Value="$(EQuanticAppIconSource)" />
            <_EqWebIconArgument Include="icons" Option="--web" Value="$(MSBuildProjectDirectory)/wwwroot/_equantic/icons" />
            <_EqWebIconArgument Include="title" Option="--app" Value="$(ApplicationTitle)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqWebIconArgument)" StandardOutputImportance="normal" />
    </Target>

    <!--
        FAIL LOUD, never skip — the compiler's turn. EqcCliPath always has a value now, so the
        warning that fired when it was empty could never fire again; and what it guarded was worse
        than the guard: CompileEQuanticUI skipped in silence and the build shipped a page with no
        JavaScript behind a warning. A missing eqc is a broken tree, a broken package, or a wrong
        EqcCliPath, and it fails here by name before the compiler would have run.
    -->
    <Target Name="EQuanticRequireCompiler" BeforeTargets="CompileEQuanticUI"
        Condition="'$(EnableEQuanticUICompilation)' == 'true' AND !Exists('$(EqcCliPath)')">
        <Error Code="EQ4002"
            Text="The eQuantic compiler (eqc) is missing at '$(EqcCliPath)'. In a source-tree build this is a broken build graph (eQuantic.Build did not build); from a package it is a broken SDK package; with an explicit EqcCliPath it is a path to a file that is not there. Neither is fixed by building twice." />
    </Target>
</Project>