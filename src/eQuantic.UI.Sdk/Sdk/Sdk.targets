<Project>
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
    <PropertyGroup>
        <!-- Use paths relative to the targets file locations -->
        <_SdkToolsDir>$(MSBuildThisFileDirectory)../tools/net10.0/</_SdkToolsDir>
        <_SourceBuildDir>$(MSBuildThisFileDirectory)../../eQuantic.Build/bin/Release/net10.0/</_SourceBuildDir>
        <_SourceBuildDirDebug>$(MSBuildThisFileDirectory)../../eQuantic.Build/bin/Debug/net10.0/</_SourceBuildDirDebug>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(_SdkToolsDir)eqc.dll')">
        <EqcCliPath>$(_SdkToolsDir)eqc.dll</EqcCliPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(EqcCliPath)' == '' And Exists('$(_SourceBuildDir)eqc.dll')">
        <EqcCliPath>$(_SourceBuildDir)eqc.dll</EqcCliPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(EqcCliPath)' == '' And Exists('$(_SourceBuildDirDebug)eqc.dll')">
        <EqcCliPath>$(_SourceBuildDirDebug)eqc.dll</EqcCliPath>
    </PropertyGroup>
    <PropertyGroup>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('Windows'))">
            eQuantic.UI.Runtime.Win64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('Linux'))">
            eQuantic.UI.Runtime.Linux64</BunRuntimePackageId>
        <BunRuntimePackageId Condition="$([MSBuild]::IsOSPlatform('OSX'))">eQuantic.UI.Runtime.Osx64</BunRuntimePackageId>
    </PropertyGroup>

    <Target Name="ResolveBunZipPath" BeforeTargets="ResolveBunPath">
        <PropertyGroup>
            <BunPkgRef>Pkg$(BunRuntimePackageId.Replace('.', '_'))</BunPkgRef>

            <!-- Dev Fallback (Source Tree) -->
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime.Osx64/tools/bun/bun-darwin.zip')">
                $(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime.Osx64/tools/bun/bun-darwin.zip</BunZipPath>
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime.Win64/tools/bun/bun.exe.zip')">
                $(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime.Win64/tools/bun/bun.exe.zip</BunZipPath>
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime.Linux64/tools/bun/bun-linux.zip')">
                $(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime.Linux64/tools/bun/bun-linux.zip</BunZipPath>

            <!-- Package Cache Resolution -->
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$(PkgeQuantic_UI_Runtime_Osx64)' != ''">
                $(PkgeQuantic_UI_Runtime_Osx64)/tools/bun/bun-darwin.zip</BunZipPath>
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$(PkgeQuantic_UI_Runtime_Win64)' != ''">
                $(PkgeQuantic_UI_Runtime_Win64)/tools/bun/bun.exe.zip</BunZipPath>
            <BunZipPath
                Condition="'$(BunZipPath)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$(PkgeQuantic_UI_Runtime_Linux64)' != ''">
                $(PkgeQuantic_UI_Runtime_Linux64)/tools/bun/bun-linux.zip</BunZipPath>

        </PropertyGroup>
    </Target>

    <Target Name="EnsureBunExtracted" BeforeTargets="ResolveBunPath"
        DependsOnTargets="ResolveBunZipPath">
        <PropertyGroup>
            <BunExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">bun.exe</BunExeName>
            <BunExeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">bun-linux</BunExeName>
            <BunExeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">bun-darwin</BunExeName>

            <BunZipDir Condition="'$(BunZipPath)' != ''">
                $([System.IO.Path]::GetDirectoryName('$(BunZipPath)'))</BunZipDir>
        </PropertyGroup>
        <PropertyGroup>
            <BunExePath Condition="'$(BunZipDir)' != ''">$(BunZipDir)/$(BunExeName)</BunExePath>
        </PropertyGroup>
        <PropertyGroup Condition="'$(BunExePath)' != ''">
            <BunExePath>$(BunExePath.Trim())</BunExePath>
        </PropertyGroup>

        <!-- Unzip if .exe missing but .zip present -->
        <Message Text="eQuantic.UI: Extracting Bun runtime from '$(BunZipPath)'..."
            Importance="High" Condition="Exists('$(BunZipPath)') And !Exists('$(BunExePath)')" />
        <Unzip
            SourceFiles="$(BunZipPath)"
            DestinationFolder="$(BunZipDir)"
            Condition="Exists('$(BunZipPath)') And !Exists('$(BunExePath)')"
        />

        <!-- Make executable on Linux/Mac -->
        <Exec Command="chmod +x &quot;$(BunExePath)&quot;"
            Condition="Exists('$(BunExePath)') And !$([MSBuild]::IsOSPlatform('Windows'))" />

        <PropertyGroup Condition="Exists('$(BunExePath)')">
            <BunPath>$(BunExePath)</BunPath>
        </PropertyGroup>
    </Target>

    <Target Name="ResolveBunPath" BeforeTargets="CompileEQuanticUI"
        DependsOnTargets="EnsureBunExtracted">
        <PropertyGroup Condition="'$(BunPath)' != ''">
            <BunPath>$(BunPath.Trim())</BunPath>
            <_BunArg> --bun "$(BunPath)"</_BunArg>
        </PropertyGroup>
        <Message Text="eQuantic.UI: BunPath resolved to '$(BunPath)'" Importance="High" />
    </Target>

    <!--
        BunPackage: Declare npm packages directly in .csproj (zero package.json).
        Usage: <BunPackage Include="tailwindcss-animate" Version="1.0.7" />
        Packages are installed to obj/eQuantic/npm/ and symlinked for tool resolution.
    -->
    <Target Name="InstallBunPackages" AfterTargets="ResolveBunPath"
        BeforeTargets="CompileEQuanticUI"
        Condition="'@(BunPackage)' != '' And '$(BunPath)' != ''">

        <PropertyGroup>
            <_BunNpmDir>$(BaseIntermediateOutputPath)eQuantic/npm</_BunNpmDir>
            <_BunNpmNodeModules>$(_BunNpmDir)/node_modules</_BunNpmNodeModules>
        </PropertyGroup>

        <!-- Skip if node_modules already exist (incremental build) -->
        <Message Text="eQuantic.UI: npm packages already installed, skipping..."
            Importance="Normal"
            Condition="Exists('$(_BunNpmNodeModules)')" />

        <!-- Install only if node_modules don't exist -->
        <MakeDir Directories="$(_BunNpmDir)"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <WriteLinesToFile
            File="$(_BunNpmDir)/package.json"
            Lines="{ &quot;private&quot;: true }"
            Overwrite="true"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <Message
            Text="eQuantic.UI: Installing npm packages: @(BunPackage -> '%(Identity)@%(Version)', ', ')..."
            Importance="High"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <Exec Command="&quot;$(BunPath)&quot; add %(BunPackage.Identity)@%(BunPackage.Version)"
            WorkingDirectory="$(_BunNpmDir)"
            Condition="!Exists('$(_BunNpmNodeModules)')" />

        <!-- Create node_modules symlink at project root for tool resolution -->
        <Exec
            Command="if [ ! -L &quot;node_modules&quot; ]; then ln -s &quot;$(_BunNpmDir)/node_modules&quot; &quot;node_modules&quot;; fi"
            Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            IgnoreExitCode="true" />
        <Exec
            Command="if not exist &quot;node_modules&quot; mklink /D &quot;node_modules&quot; &quot;$(_BunNpmDir)\node_modules&quot;"
            Condition="$([MSBuild]::IsOSPlatform('Windows'))"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            IgnoreExitCode="true" />
    </Target>

    <Target Name="CompileEQuanticUI" BeforeTargets="Build"
        Condition="'$(EnableEQuanticUICompilation)' == 'true' And '$(EqcCliPath)' != ''">
        <PropertyGroup>
            <!-- Standard components source files are packaged in eQuantic.UI.Components package -->
            <!-- Try NuGet cache first (consumer scenario) -->
            <_StandardComponentsDir Condition="'$(PkgeQuantic_UI_Components)' != ''">
                $(PkgeQuantic_UI_Components)/tools/source</_StandardComponentsDir>

            <!-- Fallback to source tree (development scenario) -->
            <_DevComponentsDir>$(MSBuildThisFileDirectory)../../eQuantic.UI.Components</_DevComponentsDir>
            <_StandardComponentsDir
                Condition="'$(_StandardComponentsDir)' == '' And Exists('$(_DevComponentsDir)')">
                $(_DevComponentsDir)</_StandardComponentsDir>
        </PropertyGroup>

        <Error
            Text="eQuantic.UI: Standard components not found. Ensure the eQuantic.UI.Components package (version $(EQuanticUIVersion)) is installed."
            Condition="'$(_StandardComponentsDir)' == '' Or !Exists('$(_StandardComponentsDir)')" />
        <!-- Clean old generated files before compiling -->
        <ItemGroup>
            <_OldGeneratedFiles Include="$(MSBuildProjectDirectory)/$(EQuanticOutputPath)*.js" />
            <_OldGeneratedFiles Include="$(MSBuildProjectDirectory)/$(EQuanticOutputPath)*.js.map" />
        </ItemGroup>
        <Delete Files="@(_OldGeneratedFiles)" Condition="'@(_OldGeneratedFiles)' != ''" />

        <Message Text="eQuantic.UI: Compiling components..." Importance="high" />
        <MakeDir Directories="$(MSBuildProjectDirectory)/$(EQuanticOutputPath)" />
        <Exec
            Command="dotnet $(EqcCliPath) &quot;$(MSBuildProjectDirectory);$(_StandardComponentsDir)&quot; $(MSBuildProjectDirectory)/$(EQuanticOutputPath)$(_BunArg)"
            WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
            StandardOutputImportance="High" />
    </Target>

    <!-- Copy runtime.js and CSS after component compilation -->
    <Target Name="CopyEQuanticRuntime" AfterTargets="CompileEQuanticUI"
        Condition="'$(EnableEQuanticUICompilation)' == 'true'">
        <PropertyGroup>
            <!-- Runtime.js is packaged in eQuantic.UI.Runtime package -->
            <!-- Try NuGet cache first (consumer scenario) -->
            <_RuntimeSourcePath Condition="'$(PkgeQuantic_UI_Runtime)' != ''">
                $(PkgeQuantic_UI_Runtime)/tools/runtime/runtime.js</_RuntimeSourcePath>
            <_CssSourcePath Condition="'$(PkgeQuantic_UI_Runtime)' != ''">
                $(PkgeQuantic_UI_Runtime)/tools/runtime/equantic.css</_CssSourcePath>

            <!-- Fallback to source tree (development scenario) -->
            <_RuntimeSourcePath
                Condition="'$(_RuntimeSourcePath)' == '' And Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime/dist/index.js')">
                $(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime/dist/index.js</_RuntimeSourcePath>
            <_CssSourcePath
                Condition="'$(_CssSourcePath)' == '' And Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime/assets/equantic.css')">
                $(MSBuildThisFileDirectory)../../eQuantic.UI.Runtime/assets/equantic.css</_CssSourcePath>

            <_RuntimeDestPath>$(MSBuildProjectDirectory)/$(EQuanticOutputPath)runtime.js</_RuntimeDestPath>
            <_CssDestPath>$(MSBuildProjectDirectory)/$(EQuanticOutputPath)equantic.css</_CssDestPath>
        </PropertyGroup>

        <Error
            Text="eQuantic.UI: Runtime not found. Ensure the eQuantic.UI.Runtime package (version $(Version)) is installed. Try running 'dotnet restore --force'."
            Condition="'$(_RuntimeSourcePath)' == '' Or !Exists('$(_RuntimeSourcePath)')" />

        <Message Text="eQuantic.UI: Copying runtime.js from '$(_RuntimeSourcePath)' to output..."
            Importance="High" />
        <Message Text="eQuantic.UI: Copying equantic.css from '$(_CssSourcePath)' to output..."
            Importance="High"
            Condition="'$(_CssSourcePath)' != '' And Exists('$(_CssSourcePath)')" />

        <Copy SourceFiles="$(_RuntimeSourcePath)" DestinationFiles="$(_RuntimeDestPath)" />
        <Copy SourceFiles="$(_CssSourcePath)" DestinationFiles="$(_CssDestPath)"
            Condition="'$(_CssSourcePath)' != '' And Exists('$(_CssSourcePath)')" />
    </Target>

    <Target Name="WarnNoCli" BeforeTargets="Build"
        Condition="'$(EnableEQuanticUICompilation)' == 'true' And '$(EqcCliPath)' == ''">
        <Warning
            Text="eQuantic.UI: Compiler CLI not found. Run 'dotnet build src/eQuantic.Build' first." />
    </Target>
</Project>