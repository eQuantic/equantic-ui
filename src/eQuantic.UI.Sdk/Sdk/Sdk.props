<Project>
    <!-- Import Microsoft.NET.Sdk.Web props -->
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

    <PropertyGroup>
        <!-- eQuantic.UI compilation settings -->
        <EnableEQuanticUICompilation>true</EnableEQuanticUICompilation>
        <EQuanticOutputPath>wwwroot/_equantic/</EQuanticOutputPath>

        <!-- Disable default items - we manage UIComponent items -->
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    </PropertyGroup>

    <!--
        Determine eQuantic.UI version to use.
        Priority:
        1. User-specified EQuanticUIVersion property
        2. SDK package version (extracted from MSBuildThisFileDirectory)
        3. Fallback to wildcard (latest) - not recommended for production
    -->
    <PropertyGroup>
        <_EQuanticSdkPath>$(MSBuildThisFileDirectory)..\</_EQuanticSdkPath>
        <_EQuanticSdkNuspecPath>$(_EQuanticSdkPath)equantic.ui.sdk.nuspec</_EQuanticSdkNuspecPath>
    </PropertyGroup>

    <!-- Extract version from SDK package's own version -->
    <PropertyGroup Condition="'$(EQuanticUIVersion)' == '' AND Exists('$(_EQuanticSdkNuspecPath)')">
        <EQuanticUIVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_EQuanticSdkNuspecPath)')),
            '&lt;version&gt;(.+?)&lt;/version&gt;').Groups[1].Value)</EQuanticUIVersion>
    </PropertyGroup>

    <!-- Fallback to wildcard if version still not determined -->
    <PropertyGroup Condition="'$(EQuanticUIVersion)' == ''">
        <EQuanticUIVersion>*</EQuanticUIVersion>
    </PropertyGroup>

    <!--
        Determine development mode (source tree).
    -->
    <PropertyGroup>
        <_DevRootDir>$(MSBuildThisFileDirectory)../../</_DevRootDir>
        <IsEQuanticDevMode
            Condition="Exists('$(_DevRootDir)eQuantic.UI.Primitives/eQuantic.UI.Primitives.csproj')">true</IsEQuanticDevMode>
        <!-- Machine architecture: on macOS we pick the native arm64 bun on Apple Silicon, else the
             x64-baseline build. (OSArchitecture reflects the real machine, even under Rosetta.) -->
        <_EqOsArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_EqOsArch>
    </PropertyGroup>

    <!-- Core eQuantic.UI packages (automatically included by SDK).
         GeneratePathProperty="true" is REQUIRED on the packages whose content (tools/source,
         tools/runtime, tools/bun) the SDK targets resolve via $(Pkg<Id>) — NuGet does NOT create
         those properties otherwise. Without it the consumer (NuGet) build can't locate the standard
         components, runtime.js or the embedded bun, and the targets fail. -->
    <ItemGroup Condition="'$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Primitives" Version="$(EQuanticUIVersion)" />
        <PackageReference Include="eQuantic.UI.Components" Version="$(EQuanticUIVersion)" GeneratePathProperty="true" />
        <PackageReference Include="eQuantic.UI.Web" Version="$(EQuanticUIVersion)" />
        <PackageReference Include="eQuantic.UI.Server" Version="$(EQuanticUIVersion)" />
        <PackageReference Include="eQuantic.UI.Runtime" Version="$(EQuanticUIVersion)" GeneratePathProperty="true" />

        <!-- Platform-specific Bun Runtime Packages (asset-only; resolved purely via $(Pkg*)).
             One per OS+architecture: native arm64 where available, else x64-baseline. -->
        <PackageReference Include="eQuantic.UI.Runtime.WinArm64" Version="$(EQuanticUIVersion)" GeneratePathProperty="true"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_EqOsArch)' == 'Arm64'" />
        <PackageReference Include="eQuantic.UI.Runtime.Win64" Version="$(EQuanticUIVersion)" GeneratePathProperty="true"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_EqOsArch)' != 'Arm64'" />
        <PackageReference Include="eQuantic.UI.Runtime.LinuxArm64" Version="$(EQuanticUIVersion)" GeneratePathProperty="true"
            Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(_EqOsArch)' == 'Arm64'" />
        <PackageReference Include="eQuantic.UI.Runtime.Linux64" Version="$(EQuanticUIVersion)" GeneratePathProperty="true"
            Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(_EqOsArch)' != 'Arm64'" />
        <PackageReference Include="eQuantic.UI.Runtime.OsxArm64" Version="$(EQuanticUIVersion)" GeneratePathProperty="true"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_EqOsArch)' == 'Arm64'" />
        <PackageReference Include="eQuantic.UI.Runtime.Osx64" Version="$(EQuanticUIVersion)" GeneratePathProperty="true"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_EqOsArch)' != 'Arm64'" />
    </ItemGroup>

    <!-- Project references for Dev Mode -->
    <ItemGroup Condition="'$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Web\eQuantic.UI.Web.csproj" />
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Server\eQuantic.UI.Server.csproj" />
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Runtime\eQuantic.UI.Runtime.csproj" />

        <!-- Platform-specific Bun Runtime Project References (one per OS+architecture) -->
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Runtime.WinArm64\eQuantic.UI.Runtime.WinArm64.csproj"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_EqOsArch)' == 'Arm64'" />
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Runtime.Win64\eQuantic.UI.Runtime.Win64.csproj"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_EqOsArch)' != 'Arm64'" />
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Runtime.LinuxArm64\eQuantic.UI.Runtime.LinuxArm64.csproj"
            Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(_EqOsArch)' == 'Arm64'" />
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Runtime.Linux64\eQuantic.UI.Runtime.Linux64.csproj"
            Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(_EqOsArch)' != 'Arm64'" />
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Runtime.OsxArm64\eQuantic.UI.Runtime.OsxArm64.csproj"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_EqOsArch)' == 'Arm64'" />
        <ProjectReference
            Include="$(_DevRootDir)eQuantic.UI.Runtime.Osx64\eQuantic.UI.Runtime.Osx64.csproj"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_EqOsArch)' != 'Arm64'" />
    </ItemGroup>

    <!--
        The app's OWN components join the declarative surface, generated from the compilation:
        define a component, get a factory named after it. A generator rather than a convention
        because it SEES the components — it stays in step with them, and says at compile time when
        two share a name or a component elects two constructors.

        EmitCompilerGeneratedFiles is not a debugging nicety here, it is load-bearing: eqc reads
        FILES, not the csc compilation, so the generated surface reaches the transpiler only by
        being written to disk. Without it the page compiles in C# and eqc emits `this.panel(…)`.
    -->
    <PropertyGroup Condition="'$(EQuanticGenerateFactorySurface)' != 'false'">
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    <ItemGroup Condition="'$(EQuanticGenerateFactorySurface)' != 'false' And '$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Generators\eQuantic.UI.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(EQuanticGenerateFactorySurface)' != 'false' And '$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Generators" Version="$(EQuanticUIVersion)"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- The DECLARATIVE factory surface, available in every file without an import:
         Column(gap: Space.S3, children: [ Text("…"), Button("Up") ]) instead of `new` — the
         methods of eQuantic.UI.Components.UI arrive through a generated global `using static`
         (csc and eqc both read the generated GlobalUsings.g.cs, so the two compilations agree).
         Opt out with <EQuanticImplicitFactoryUsing>false</EQuanticImplicitFactoryUsing>. -->
    <ItemGroup Condition="'$(EQuanticImplicitFactoryUsing)' != 'false'">
        <Using Include="eQuantic.UI.Components.UI" Static="true" />
    </ItemGroup>

    <!--
        WRITE-ONCE is the architecture, so the component bases mean the Primitives ones. Both
        namespaces are imported by every page (Core carries [Page] and [ServerAction], Primitives
        the vocabulary) and both declare these names, so without an alias the base type is
        AMBIGUOUS: the class binds to nothing, SetState stops existing, and every call around it
        fails to resolve — a page that looks perfectly ordinary stops being translatable. Each app
        wrote the alias by hand; it belongs here, once.
    -->
    <ItemGroup Condition="'$(EQuanticImplicitComponentAliases)' != 'false'">
        <Using Include="eQuantic.UI.Primitives.StatefulComponent" Alias="StatefulComponent" />
        <Using Include="eQuantic.UI.Primitives.StatelessComponent" Alias="StatelessComponent" />
    </ItemGroup>

    <ItemGroup>
        <!-- Include all .cs files in Pages/ as UIComponents -->
        <UIComponent Include="Pages/**/*.cs" Exclude="obj/**;bin/**" />

        <!-- Include them as Compile items for IntelliSense -->
        <Compile Include="@(UIComponent)" />

        <!-- Include other .cs files as regular compile items -->
        <Compile Include="**/*.cs" Exclude="Pages/**/*.cs;obj/**;bin/**" />

        <!-- Track L: the developer's .resx are first-class. Embedded here (satellite assemblies
             on the server and on native, no bridge — I18N-PLAN D10), while the VS-convention
             Designer beside each .resx reaches eqc through the ordinary Compile glob above, which
             is what lets the web rewrite `Strings.X` to a runtime lookup (D2). -->
        <EmbeddedResource Include="**/*.resx" Exclude="obj/**;bin/**" />
    </ItemGroup>
</Project>