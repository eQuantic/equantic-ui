<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>eQuantic.UI.Sdk</PackageId>
        <Description>MSBuild SDK for eQuantic UI components.</Description>
        <PackageType>MSBuildSdk</PackageType>
        <!--
            Two tool folders staged into one: eqc and eqicon carry the same Roslyn assemblies, and
            NuGet keeps the first copy and says so once per file. That is the intended outcome, not
            a duplicate to fix.
        -->
        <NoWarn>$(NoWarn);NU5118</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Sdk\**" PackagePath="Sdk" />
        <Content Include="Sdk\Sdk.props" PackagePath="build\eQuantic.UI.Sdk.props" />
        <Content Include="Sdk\Sdk.targets" PackagePath="build\eQuantic.UI.Sdk.targets" />
    </ItemGroup>

    <!-- The two tools the package ships under tools/, as edges of THIS project's build graph: the
         build that precedes the pack builds them, restored with the rest of the graph, as the one
         instance the solution builds. Nothing links against them (ReferenceOutputAssembly=false),
         nothing copies them here (Private=false), and they are not package dependencies
         (PrivateAssets=All) — CollectBuildOutput carries their files instead. -->
    <ItemGroup>
        <ProjectReference Include="..\eQuantic.Build\eQuantic.Build.csproj"
            ReferenceOutputAssembly="false" Private="false" PrivateAssets="All" />
        <ProjectReference Include="..\eQuantic.UI.Native.Build\eQuantic.UI.Native.Build.csproj"
            ReferenceOutputAssembly="false" Private="false" PrivateAssets="All" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);CollectBuildOutput</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="CollectBuildOutput">
        <!-- eqicon is a SECOND tool this SDK runs — the `Assets/*.svg` vector catalog and the web app
             icon both go through it — and it lives in its own project. Both are built by the edges
             above before this target collects them. -->
        <ItemGroup>
            <_BuildOutput Include="..\eQuantic.Build\bin\$(Configuration)\net10.0\**"
                Exclude="..\eQuantic.Build\bin\$(Configuration)\net10.0\*.pdb" />
            <!-- KeepDuplicates=false: both tools carry the same framework assemblies, and NuGet
                 rejects a package that names the same path twice. -->
            <_BuildOutput Include="..\eQuantic.UI.Native.Build\bin\$(Configuration)\net10.0\**"
                Exclude="..\eQuantic.UI.Native.Build\bin\$(Configuration)\net10.0\*.pdb"
                KeepDuplicates="false" />
        </ItemGroup>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_BuildOutput)" PackagePath="tools\net10.0" />
        </ItemGroup>
    </Target>

</Project>