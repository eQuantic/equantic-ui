<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Components</PackageId>
    <Description>The eQuantic.UI component library — components authored ONCE against the abstract vocabulary and tokens (eQuantic.UI.Primitives), realized per target: DOM/CSS on web, Photon pixels on native (docs/SHARED-COMPONENTS-PLAN.md).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Primitives ONLY — a shared component that needed anything platform-specific would be a bug. -->
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library's JS lives INSIDE the runtime (transpiled modules embedded in runtime.js and
         byte-pinned to eqc output — see SharedComponentTranspilationTests); sources still ship at
         tools/source as reference material for consumers/tooling. -->
    <Content Include="**\*.cs" Exclude="obj\**;bin\**" PackagePath="tools\source\" />
  </ItemGroup>

</Project>
