<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\eQuantic.UI.Core\eQuantic.UI.Core.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PackageId>eQuantic.UI.Components</PackageId>
        <Description>Standard UI component library for eQuantic.UI - buttons, inputs, containers, and more.</Description>
    </PropertyGroup>

    <!-- Package source files for compiler type resolution -->
    <ItemGroup>
        <Content Include="**\*.cs" Exclude="obj\**;bin\**" PackagePath="tools\source\" />
    </ItemGroup>

</Project>
