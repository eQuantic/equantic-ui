<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 is not a choice: it is what Roslyn loads analyzers as. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008 asks for AnalyzerReleases.{Shipped,Unshipped}.md. The SDK's diagnostics are
             already catalogued in docs/DIAGNOSTICS.md, and DiagnosticsDocumentedTests FAILS the
             build when a code is reported without a row there, when a row names a code that no
             longer exists, or when a code gains a reporting site its baseline does not know.
             Release tracking would be a SECOND hand-maintained table of the same EQ codes, free
             to drift from the first, and the weaker of the two — it checks only that an id is
             listed. One catalogue, with the guard on it.

             NoWarn rather than <EnableAnalyzerReleaseTracking>false</...>: that switch reaches
             the compiler (it is in the generated editorconfig) but the analyzer shipping with
             Microsoft.CodeAnalysis.CSharp 4.14.0 predates honouring it, so setting it changed
             nothing. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
        <IsRoslynComponent>true</IsRoslynComponent>
        <Description>Generates the declarative factory surface for an app's own components, so a screen reads the same whether the component came from the SDK or from the app.</Description>
        <!-- A source generator ships as an ANALYZER, never a lib: in lib/ the consumer's compiler
             would never load it — dev-mode ProjectReference hid this, and the first app built from
             the packaged SDK had no entry point. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true"
              PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>


    <ItemGroup>
        <!-- The dependency rule, shared with the other assembly rather than written twice: these two
             cannot reference each other, and a rule that drifts here moves constructor arguments. -->
        <Compile Include="../Shared/CapabilityRule.cs" Link="Shared/CapabilityRule.cs" />
    </ItemGroup>
</Project>
