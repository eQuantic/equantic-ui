<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>eQuantic.UI.FontAwesome6Brands</PackageId>
    <Description>Font Awesome 6 Brands icon catalog for eQuantic.UI — write-once IconGlyph data (web + native) generated from the Iconify 'fa6-brands' set.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Primitives ONLY: glyph data is target-neutral by construction. -->
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sources ship for the eqc transpiler (client-side pack modules — see the plan's icon-pack notes). -->
    <Content Include="**\*.cs" Exclude="obj\**;bin\**" PackagePath="tools\source\" />
  </ItemGroup>

</Project>
