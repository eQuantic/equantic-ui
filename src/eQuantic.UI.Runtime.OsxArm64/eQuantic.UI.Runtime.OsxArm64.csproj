<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <!-- Metadata -->
        <PackageId>eQuantic.UI.Runtime.OsxArm64</PackageId>
        <Description>eQuantic UI Runtime for macOS (Apple Silicon / arm64).</Description>
        <Authors>eQuantic Tech</Authors>
    </PropertyGroup>

    <ItemGroup>
        <!-- The zip and nothing else: the SDK unpacks it into the user's cache, never beside it (#364),
             and a bun an older build left here is not packed. -->
        <Content Include="tools\bun\bun-darwin.zip" PackagePath="tools/bun/" />
        <Content Include="build\**" PackagePath="build" />
    </ItemGroup>
</Project>
