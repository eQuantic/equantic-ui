<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>eQuantic.UI.Material</PackageId>
    <Description>Material Design 3 theme for eQuantic.UI — a write-once IAppTheme (M3 baseline color, type scale, shape scale, elevation) that themes the shared components on BOTH web and native. Target-neutral: references eQuantic.UI.Primitives only.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Primitives ONLY: a theme is target-neutral token data, exactly like a component. -->
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="eQuantic.UI.Native.Engine.Tests" />
    <InternalsVisibleTo Include="eQuantic.UI.Web.Tests" />
  </ItemGroup>

</Project>
