<Project>
    <!--
        The native SDK. An app declares WHICH devices it wants and writes C#; every reference, every
        platform minimum and every manifest key below is the framework's, exactly as the generated
        HTML shell is on web. Nothing here is a decision an app author should have to make.
    -->
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <!-- The framework's opinions, not the app's. An app that disagrees still says so. -->
    <PropertyGroup>
        <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
        <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <_DevRootDir>$(MSBuildThisFileDirectory)../../</_DevRootDir>
        <IsEQuanticDevMode
            Condition="Exists('$(_DevRootDir)eQuantic.UI.Primitives/eQuantic.UI.Primitives.csproj')">true</IsEQuanticDevMode>
        <_EqPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_EqPlatform>
    </PropertyGroup>

    <PropertyGroup Condition="'$(EQuanticUIVersion)' == ''">
        <EQuanticUIVersion>*</EQuanticUIVersion>
    </PropertyGroup>

    <!-- 15.0 is where CAMetalLayer, safe-area insets and MTLBinaryArchive are all present. -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(SupportedOSPlatformVersion)' == ''">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- 26 is where adaptive icons, the Choreographer's frame callback and Vulkan all arrived. -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'android' AND '$(SupportedOSPlatformVersion)' == ''">
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!--
        The generator that writes the other half of the app's Program: the entry point where the
        platform has one, and the registration that lets a shell reach CreateApp without looking
        anything up. A generator rather than a build step because it SEES the compilation — it can
        emit a direct call, and say at compile time when there is no program or more than one.
    -->
    <ItemGroup Condition="'$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Native.Generators\eQuantic.UI.Native.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Native.Generators" Version="$(EQuanticUIVersion)"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- The vocabulary, the component library, and the host an app is built and run through:
         the same three on every device. -->
    <ItemGroup Condition="'$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Native.Hosting\eQuantic.UI.Native.Hosting.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Primitives" Version="$(EQuanticUIVersion)" />
        <PackageReference Include="eQuantic.UI.Components" Version="$(EQuanticUIVersion)" />
        <PackageReference Include="eQuantic.UI.Native.Hosting" Version="$(EQuanticUIVersion)" />
    </ItemGroup>

    <!-- The shell for the device this TFM names. -->
    <ItemGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Native.Shell.iOS\eQuantic.UI.Native.Shell.iOS.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Native.Shell.iOS" Version="$(EQuanticUIVersion)" />
    </ItemGroup>

    <!--
        Android's SDK puts its widget toolkit into every file implicitly, and half of it shares names
        with the vocabulary: Button, Dialog, ProgressBar, ScrollView, Space, Switch. A Photon app
        draws with the VOCABULARY, so those go back to being types you ask for by name. An app that
        genuinely wants an Android view still writes one `using` and gets it.
    -->
    <ItemGroup Condition="'$(_EqPlatform)' == 'android'">
        <Using Remove="Android.App" />
        <Using Remove="Android.Widget" />
        <Using Remove="Android.Views" />
        <Using Remove="Android.Content" />
    </ItemGroup>

    <!--
        CONVENTION, the way .NET does it: things the build consumes live in a known folder, the way
        a web app's static files live in wwwroot. `Assets/` is where a Photon app keeps what the
        platform installs, and the root is accepted too for an app small enough not to want a folder.
        `EQuanticAppIconSource` in the project file overrides both — an MSBuild property, because
        this is a BUILD input; appsettings.json is where an app configures what it does at RUN time,
        and splitting one concern across the two is how a project stops being obvious.
    -->
    <!-- The generator asks whether this app declared an icon: on Android that decides whether it
         writes the [Application(Icon)] the launcher reads. -->
    <ItemGroup>
        <CompilerVisibleProperty Include="EQuanticAppIconSource" />
    </ItemGroup>

    <PropertyGroup>
        <EQuanticAssetsDir Condition="'$(EQuanticAssetsDir)' == ''">$(MSBuildProjectDirectory)/Assets</EQuanticAssetsDir>

        <!-- Artwork a designer made, or a tree the engine draws. Both end in the same generated
             catalog, so nobody hand-writes a Contents.json either way. -->
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(EQuanticAssetsDir)/AppIcon.png')">$(EQuanticAssetsDir)/AppIcon.png</EQuanticAppIconSource>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(EQuanticAssetsDir)/AppIcon.cs')">$(EQuanticAssetsDir)/AppIcon.cs</EQuanticAppIconSource>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(MSBuildProjectDirectory)/AppIcon.png')">$(MSBuildProjectDirectory)/AppIcon.png</EQuanticAppIconSource>
        <EQuanticAppIconSource
            Condition="'$(EQuanticAppIconSource)' == '' AND Exists('$(MSBuildProjectDirectory)/AppIcon.cs')">$(MSBuildProjectDirectory)/AppIcon.cs</EQuanticAppIconSource>
    </PropertyGroup>

    <!--
        The launcher icon, derived from Assets/AppIcon into Assets/.generated and picked up HERE, at
        evaluation — because Android reads its resources before any target of ours can run.
        That is also why these are CHECKED IN rather than ignored: a clean clone has to build with
        the right icon on the first pass, and Android's own convention has always been that the
        contents of a resources folder live in the repository. The SDK refreshes them whenever the
        source icon changes; nobody edits them by hand.
    -->
    <PropertyGroup>
        <EQuanticGeneratedAssetsDir Condition="'$(EQuanticGeneratedAssetsDir)' == ''">$(EQuanticAssetsDir)/.generated</EQuanticGeneratedAssetsDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(_EqPlatform)' == 'android'">
        <AndroidResource Include="$(EQuanticGeneratedAssetsDir)/android/res/**/*.png">
            <Link>Resources/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup Condition="'$(_EqPlatform)' == 'android' AND '$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Native.Shell.Android\eQuantic.UI.Native.Shell.Android.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(_EqPlatform)' == 'android' AND '$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Native.Shell.Android" Version="$(EQuanticUIVersion)" />
    </ItemGroup>

    <!-- No target platform: the desktop head, which is where a phone app is iterated on. The
         Reference backend rides along so an app can render a frame offscreen without a window. -->
    <ItemGroup Condition="'$(_EqPlatform)' == '' AND '$(IsEQuanticDevMode)' == 'true'">
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Native.Shell.MacOS\eQuantic.UI.Native.Shell.MacOS.csproj" />
        <ProjectReference Include="$(_DevRootDir)eQuantic.UI.Native.Engine.Reference\eQuantic.UI.Native.Engine.Reference.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(_EqPlatform)' == '' AND '$(IsEQuanticDevMode)' != 'true'">
        <PackageReference Include="eQuantic.UI.Native.Shell.MacOS" Version="$(EQuanticUIVersion)" />
        <PackageReference Include="eQuantic.UI.Native.Engine.Reference" Version="$(EQuanticUIVersion)" />
    </ItemGroup>
</Project>
