<!--
    InitialTargets, because ANDROID validates that every declared resource EXISTS before any
    ordinary target runs — earlier than BeforeBuild, earlier than anything BeforeTargets can reach.
    An imported project contributes its InitialTargets to the one importing it, and they run before
    the build's first target. That is the only hook early enough, and it removes the two workarounds
    this cost before it was found: files committed to the repository, and generation at restore.
    Android only: Apple's packaging takes the catalog from an item an ordinary target hands it, and
    running that target this early is exactly what stops the item from ever arriving.
-->
<Project InitialTargets="EQuanticAndroidIcon">
    <!--
        WHOSE SOURCE, AND ON WHICH BRANCH. Dev mode swaps the packages for the tree beside the SDK,
        which for a repository OUTSIDE that tree means "whatever branch that repo happens to have
        checked out". A consumer session found this the hard way: it believed it was building the
        released SDK, was actually building an unreviewed feature branch of it, and the branch it
        was on had CHANGED behaviour under it between one build and the next.

        Neither end had a signal. So the build says it, once, at high importance — the branch is
        read out of .git/HEAD rather than by running git, so it costs a file read and no process.

        Only for a consumer OUTSIDE the tree: the samples are ALWAYS in dev mode and a line on every
        one of their builds would be noise nobody reads, which is how a warning stops working. The
        comparison is against the REPOSITORY root, `$(_DevRootDir)..` — _DevRootDir is `src/`, and
        measuring against it announces the samples too, since they do not live under src. BOTH sides
        get a trailing separator first: a bare StartsWith makes `/…/equantic-ui-web` look like it
        lives inside `/…/equantic-ui`, and silences the one consumer the line exists for. Those
        siblings are not hypothetical — equantic-ui-web, equantic-ui-compiler and equantic-ui.wiki
        all sit beside this tree.
    -->
    <Target Name="EQuanticAnnounceDevSource" BeforeTargets="Build"
            Condition="'$(IsEQuanticDevMode)' == 'true'
                       AND !$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)').StartsWith($([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(_DevRootDir)..'))))))">
        <PropertyGroup>
            <_EqDevHeadFile>$([System.IO.Path]::GetFullPath('$(_DevRootDir)../.git/HEAD'))</_EqDevHeadFile>
        </PropertyGroup>
        <ReadLinesFromFile File="$(_EqDevHeadFile)" Condition="Exists('$(_EqDevHeadFile)')">
            <Output TaskParameter="Lines" PropertyName="_EqDevHead" />
        </ReadLinesFromFile>
        <PropertyGroup>
            <!-- "ref: refs/heads/main" on a branch, a bare SHA when detached (a bisect, a tag). -->
            <_EqDevBranch Condition="'$(_EqDevHead)' != ''">$(_EqDevHead.Replace('ref: refs/heads/', ''))</_EqDevBranch>
            <_EqDevBranch Condition="'$(_EqDevBranch)' == ''">unknown</_EqDevBranch>
        </PropertyGroup>
        <!--
            The branch alone is not enough to answer "is this the same thing I built an hour ago" —
            branches get rebased and reused — and it says nothing at all about UNCOMMITTED work,
            which is the least reproducible state there is and the one with no file to read.

            So one `git describe`, which answers both and one more: `v0.2.0-preview.50-12-g072cc166`
            is the short SHA, how far past the last RELEASE this tree sits, and `-dirty` appended
            when the working tree is modified. Failure is tolerated on purpose — no git, a tarball,
            a shallow copy — and the line still names the branch and the path.
        -->
        <ItemGroup>
            <_EqDescribeArgument Include="repository" Option="-C" Value="$([System.IO.Path]::GetFullPath('$(_DevRootDir)..'))" />
            <_EqDescribeArgument Include="command" Value="describe" />
            <_EqDescribeArgument Include="always" Value="--always" />
            <_EqDescribeArgument Include="dirty" Value="--dirty" />
            <_EqDescribeArgument Include="abbreviation" Value="--abbrev=8" />
        </ItemGroup>
        <RunProgram Program="git" Arguments="@(_EqDescribeArgument)"
              ConsoleToMSBuild="true" StandardOutputImportance="low"
              ContinueOnError="true" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="_EqDevDescribe" />
        </RunProgram>
        <PropertyGroup>
            <_EqDevAt Condition="'$(_EqDevDescribe)' != ''"> @ $(_EqDevDescribe.Trim())</_EqDevAt>
        </PropertyGroup>
        <Message Importance="high"
                 Text="eQuantic.UI: building against SOURCE at $([System.IO.Path]::GetFullPath('$(_DevRootDir)..')) (branch: $(_EqDevBranch)$(_EqDevAt)) — not a released package." />
    </Target>

    <!--
        A DESKTOP head on Windows is a windowed executable, not a console one: an `Exe` opens a black
        console window behind every Photon window, which no app author asked for and every one of
        them would have to learn to switch off. Decided here, BEFORE the .NET SDK's own targets read
        OutputType, the way MAUI decides it for its Windows head. The runner attaches to the parent's
        console when there is one, so `dotnet run` still prints. Opt out (a tool that wants a real
        console beside its window) with <EQuanticConsole>true</EQuanticConsole>.
    -->
    <!--
        WHICH DEVICE THIS IS, asked where the answer exists.

        Sdk.props asks the same question at line 51, and for the ordinary shape of a mobile app it
        cannot know: `.props` is imported ABOVE the project body, so `<TargetFramework>net10.0-ios
        </TargetFramework>` has not been set yet and the platform reads as EMPTY. It is only a global
        property — known that early — for `-f` and for the inner build of a multi-target project,
        which is why this repository never saw it: WalletMobile is multi-target and the native
        template is desktop-only.

        Measured on a single-target `net10.0-ios` app before this line existed: platform empty, so
        `_EqMacHead` below turned TRUE and an iPhone app was packaged as a macOS head.

        So the question is asked again here, after the body, and only when props could not answer.
        A shape that props DID answer keeps that answer, so nothing that builds today changes.
    -->
    <PropertyGroup Condition="'$(_EqPlatform)' == '' AND '$(TargetFramework)' != ''">
        <_EqPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_EqPlatform>
    </PropertyGroup>

    <!--
        The platform MINIMUMS, here rather than in Sdk.props for a reason worth knowing once: MSBuild
        evaluates every property before it evaluates any item, so the ITEMS up there conditioned on
        the platform read the answer this file just wrote — but a PROPERTY only ever sees what was
        assigned above its own line. Left in Sdk.props these two read an empty platform for a
        single-target app and never fired, and the app silently took the iOS SDK's own default:
        measured at 26.5, an app that refuses to install on anything older than the SDK it was built
        with. An app that names its own minimum still wins.
    -->
    <!-- 15.0 is where CAMetalLayer, safe-area insets and MTLBinaryArchive are all present. -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(SupportedOSPlatformVersion)' == ''">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- 26 is where adaptive icons, the Choreographer's frame callback and Vulkan all arrived. -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'android' AND '$(SupportedOSPlatformVersion)' == ''">
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- And WHICH desktop, for the head with no target platform at all — the same reason and the
         same place. The references that read it live in Sdk.props, which is safe: every property is
         evaluated before any item, so the ItemGroups there see what this writes. -->
    <PropertyGroup Condition="'$(_EqPlatform)' == ''">
        <_EqDesktopShell Condition="'$(_EqDesktopShell)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">Windows</_EqDesktopShell>
        <_EqDesktopShell Condition="'$(_EqDesktopShell)' == ''">MacOS</_EqDesktopShell>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_EqPlatform)' == '' AND '$(OutputType)' == 'Exe' AND '$(EQuanticConsole)' != 'true' AND $([MSBuild]::IsOSPlatform('Windows'))">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <!--
        The SDK does not dictate which Xcode the developer has.

        .NET for iOS fails the build (E0191) unless the installed Xcode's MAJOR.MINOR equals the
        one its SDK pack recommends: pack 26.5 demands Xcode 26.6 exactly, so Xcode 27.0 is an
        error and so would 26.5 be. That is a version comparison, not a capability check — nothing
        was asked of the toolchain and nothing failed.

        MEASURED on the machine this was found on, and the numbers are the argument. Xcode 27.0,
        with the 26.0, 26.5 AND 27.0 iOS packs all installed — and the build resolves 26.5, which
        demands Xcode 26.6:

            This version of .NET for iOS (26.5.10315) requires Xcode 26.6.
            The current version of Xcode is 27.0.

        The 27.0 pack, which matches the installed Xcode exactly, is sitting right beside it and
        never gets a say: WHICH pack resolves is decided by the workload manifest, not by the Xcode
        you have. So "install Xcode 26.6" does not settle anything either — it satisfies today's
        resolved pack and breaks on the next manifest that moves one.

        Telling the app author to install a second Xcode is the shape this product rules out: a
        platform artifact they never asked for, to satisfy a check about a platform detail the SDK
        already resolved. It stays a decision they can take back — setting the property in their own
        csproj wins, because this only fills it in when it is empty, and this file is imported below
        the project body. `NativeSdkEvaluationTests` pins that, from the body rather than from a
        global property: a global one MSBuild refuses to overwrite anyway, so asserting it would
        test MSBuild and leave an unconditional assignment here undetected.

        What this does NOT do is silence a real failure: a toolchain that genuinely cannot build
        still fails, with the error from the thing that failed rather than from a comparison.

        HERE and not in Sdk.props, and that is the whole reason this reaches every app: asked up
        there, the platform is empty for a single-target iOS app and the check stayed ON for the
        ordinary shape of the very thing this turns off. See the note above this file's own platform
        question, which is what this condition reads.
    -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(ValidateXcodeVersion)' == ''">
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
    </PropertyGroup>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

    <!--
        The app manifest an iOS app cannot do without. UILaunchScreen is the one that is not
        cosmetic: without it iOS runs the app in a compatibility window and every safe-area inset it
        reports belongs to that fiction rather than to the phone. An app that wants different
        orientations states them in its own Info.plist — app keys win over these.
    -->
    <ItemGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(OutputType)' == 'Exe'">
        <PartialAppManifest Include="$(MSBuildThisFileDirectory)PhotonApp.plist" />
    </ItemGroup>

    <!--
        THE NATIVE TRACK IS EXPERIMENTAL IN 1.0 (#324). Every native assembly carries .NET's
        [Experimental("EQX0001")], so a project that uses one fails until it says it means to. An app
        built with this SDK chose the native track by choosing the SDK, which is the whole opt-in: the
        id goes into NoWarn here, after the app's own project, so a NoWarn the app sets does not drop
        it. Nothing for the developer to write. A web app that references a native assembly by
        accident still meets EQX0001, which is the case the mark exists for.
    -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);EQX0001</NoWarn>
    </PropertyGroup>

    <!--
        And it is said once, where it matters: when the app is published, which is when something
        built on the track leaves the machine. A line on every build would be read by nobody after
        the first day, which is how a notice stops working.
    -->
    <Target Name="EQuanticNativeTrackIsExperimental" AfterTargets="Publish">
        <Message Importance="high"
                 Text="eQuantic.UI: the native track is experimental in 1.0, so its API may change in a minor release. https://github.com/eQuantic/equantic-ui/wiki/Photon#the-native-track-is-experimental-in-10" />
    </Target>

    <PropertyGroup>
        <!-- A build from this repository's own tree, as opposed to a consumer restoring the SDK from
             NuGet — the same distinction the web Sdk.targets draws. A source tree runs the tool its
             ProjectReference just built (Sdk.props declares the edge); a package runs what it shipped
             under tools/. One question, asked once: a fallback that preferred whichever copy existed
             ran a stale tool on the tree, and hid a missing one from every test that cold-built it. -->
        <_EqSourceTree Condition="Exists('$(MSBuildThisFileDirectory)../../eQuantic.UI.Native.Build/eQuantic.UI.Native.Build.csproj')">true</_EqSourceTree>
        <_EqIconToolDir Condition="'$(_EqSourceTree)' == 'true'">$(MSBuildThisFileDirectory)../../eQuantic.UI.Native.Build/bin/$(Configuration)/net10.0/</_EqIconToolDir>
        <_EqIconToolDir Condition="'$(_EqIconToolDir)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/</_EqIconToolDir>
        <_EqTasksAssembly Condition="'$(_EqSourceTree)' == 'true'">$(MSBuildThisFileDirectory)../../eQuantic.UI.Sdk.Tasks/bin/$(Configuration)/netstandard2.0/eQuantic.UI.Sdk.Tasks.dll</_EqTasksAssembly>
        <_EqTasksAssembly Condition="'$(_EqTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/eQuantic.UI.Sdk.Tasks.dll</_EqTasksAssembly>
        <_EqTaskFactory>AssemblyTaskFactory</_EqTaskFactory>
        <_EqTaskFactory Condition="'$(_EqSourceTree)' == 'true'">TaskHostFactory</_EqTaskFactory>
        <_EqIconDir>$(MSBuildProjectDirectory)/obj/eQuantic</_EqIconDir>
        <_EqAssetsGenerated>$(EQuanticGeneratedAssetsDir)</_EqAssetsGenerated>
        <_EqIconSetDir>$(_EqIconDir)/Assets.xcassets</_EqIconSetDir>

        <!--
            Whether this project is a macOS HEAD, which the three packaging targets below all ask.
            Spelled once here rather than three times on the targets. Whether the TOOL they run
            exists is not part of it: the edge in Sdk.props guarantees it in a source tree and the
            package ships it, so a missing tool is a broken tree or a broken package, and
            EQuanticRequireIconTool names that instead of letting a target skip.
        -->
        <_EqMacHead Condition="'$(_EqPlatform)' == '' AND '$(TargetFramework)' != '' AND '$(OutputType)' == 'Exe' AND '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true' AND '$(EQuanticMacAppBundle)' != 'false'">true</_EqMacHead>

        <!-- And its Windows twin: the head being built INTO an executable on a Windows machine.
             What it owes the app is smaller — no bundle, the .exe IS the app — but the icon the
             taskbar shows comes from the same Assets/AppIcon, and it is embedded below. -->
        <_EqWindowsHead Condition="'$(_EqPlatform)' == '' AND '$(TargetFramework)' != '' AND ('$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe') AND '$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'">true</_EqWindowsHead>
        <_EqWindowsIco>$(_EqIconDir)/$(AssemblyName).ico</_EqWindowsIco>
    </PropertyGroup>
    <!--
        Every program this SDK starts, it starts with RunProgram: a program and a list of arguments,
        with no shell between them (#841), as the web SDK does. A source tree loads the task in a
        task host that ends with the build, since it builds the assembly in the same graph, and a
        package's as any task's is.
    -->
    <UsingTask TaskName="eQuantic.UI.Sdk.Tasks.RunProgram" AssemblyFile="$(_EqTasksAssembly)" TaskFactory="$(_EqTaskFactory)" />

    <!--
        The executable's icon on Windows, from the same Assets/AppIcon — set at EVALUATION by literal
        path, the same trick the Android resources use: the property has to be known before the
        compiler reads it, and the file only has to exist when the compiler runs, which is after the
        target below has written it. An app that names its own ApplicationIcon keeps it.
    -->
    <PropertyGroup Condition="'$(_EqWindowsHead)' == 'true' AND '$(EQuanticAppIconSource)' != '' AND '$(ApplicationIcon)' == ''">
        <ApplicationIcon>$(_EqWindowsIco)</ApplicationIcon>
    </PropertyGroup>

    <!--
        Apple reads the icon's LOCATION from the app manifest rather than from a build property, so
        the tool that writes the catalog writes that too.
        Both platforms collect their assets in a nested build whose evaluation precedes every target
        of ours, so both are named at evaluation by LITERAL path and written by the InitialTarget
        before anything reads them. One rule, two platforms, and nothing committed to a repository.
    -->
    <ItemGroup Condition="'$(_EqPlatform)' == 'ios' AND '$(EQuanticAppIconSource)' != ''">
        <PartialAppManifest Include="$(_EqIconDir)/AppIcon.plist" />
    </ItemGroup>

    <!--
        ONE target: render the icon, then hand the catalog to Apple's packaging. The items are
        created HERE rather than declared up front because a wildcard evaluated before the build
        runs is empty on every clean build — and actool then compiles nothing while reporting
        success. eqicon skips its own work when the icon has not changed, so this stays cheap.
    -->
    <!--
        Also at RESTORE, which is the only pass early enough for Android. Android collects its
        resources during the build's EVALUATION, before any target of ours has run — so a file
        written by a build target is invisible to it however early we hook. Restore is a separate
        invocation that finishes first, and what it leaves on disk the build simply finds.
    -->

    <!--
        An InitialTarget runs in EVERY invocation of the project — restore, design-time, each nested
        build — and before any ordinary target, ResolveProjectReferences included. The old
        `Exists(eqicon.dll)` on its Condition therefore answered "no" on a cold source tree (the edge
        had not been walked yet), skipped in silence, and the build that followed failed with five
        XA2001s about PNG files — an error about resources, for a cause about a tool.
    -->
    <Target Name="EQuanticAndroidIcon"
            Condition="'$(_EqPlatform)' == 'android' AND '$(EQuanticAppIconSource)' != '' AND '$(ExcludeRestorePackageImports)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
        <!--
            An InitialTarget runs before ResolveProjectReferences, so the edge Sdk.props declares has
            not been walked when this needs the tool. Pull that ONE edge now, with the properties
            ResolveProjectReferences would use: the same project instance the solution builds, so
            MSBuild serializes the two requests instead of racing them into one bin/ — which is what
            an inline build under its own properties did. Not during restore (NuGet's own marker; a
            restore builds nothing) and not in a design-time build.
        -->
        <MSBuild Condition="'$(_EqSourceTree)' == 'true' AND '%(ProjectReference.EqBuildTool)' == 'true'"
                 Projects="@(ProjectReference)" Targets="Build"
                 RemoveProperties="%(ProjectReference.GlobalPropertiesToRemove)" />
        <Error Condition="!Exists('$(_EqIconToolDir)eqicon.dll')" Code="EQ4001"
               Text="This app declares an icon ($(EQuanticAppIconSource)) but the eQuantic icon tool is missing at '$(_EqIconToolDir)eqicon.dll'. In a source-tree build this is a broken build graph (eQuantic.UI.Native.Build did not build); from a package the SDK package is broken. Neither is fixed by building twice." />
        <ItemGroup>
            <_EqAndroidIconArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqAndroidIconArgument Include="source" Option="--source" Value="$(EQuanticAppIconSource)" />
            <_EqAndroidIconArgument Include="resources" Option="--android" Value="$(_EqAssetsGenerated)/android/res" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqAndroidIconArgument)" StandardOutputImportance="normal" />
    </Target>

    <!--
        FAIL LOUD, never skip. Every target below that runs the tool used to carry
        `Exists(eqicon.dll)` on its own Condition, so a missing tool meant no bundle, no icon, no
        capability manifest — and no explanation. The tool is a graph edge in a source tree and a
        shipped file in a package, so in either healthy state it is there; this guard names the
        unhealthy one, once, before any of them would have skipped.
    -->
    <Target Name="EQuanticRequireIconTool"
            BeforeTargets="EQuanticResolveMacPackaging;EQuanticMacAppBundle;EQuanticMacAppPackage;EQuanticCapabilityManifest;EQuanticAndroidQueries;EQuanticAppIcon;EQuanticFonts"
            Condition="('$(_EqMacHead)' == 'true' OR '$(_EqPlatform)' == 'ios' OR '$(_EqPlatform)' == 'android' OR '$(EQuanticAppIconSource)' != '' OR '@(EmbeddedResource->WithMetadataValue('EQuanticFont', 'true'))' != '') AND !Exists('$(_EqIconToolDir)eqicon.dll')">
        <Error Code="EQ4001"
               Text="This app needs the eQuantic icon tool (app icon, bundle, capability manifest, Android queries, font catalog) and it is missing at '$(_EqIconToolDir)eqicon.dll'. In a source-tree build this is a broken build graph (eQuantic.UI.Native.Build did not build); from a package the SDK package is broken. Neither is fixed by building twice." />
    </Target>

    <!--
        The macOS head ships as an APPLICATION. Everything the build produced goes inside the
        bundle, the Info.plist states what the system needs to know, and the icon is the same
        Assets/AppIcon that feeds the phones. Without this the head is a process with a window: no
        Dock tile, no menu bar, no app switcher, and nothing the OS will treat as an app.
        Skipped when an app opts out (EQuanticMacAppBundle=false) or is not an executable.
    -->
    <!--
        WHAT SIGNING THIS APP MEANS — resolved once, and read by both the development bundle and
        the shipped one. It used to live inside the single build-time target, which is why there
        was no shipped one: everything an app needs in order to be distributable was tangled with
        the thing that runs after every Build.
    -->
    <Target Name="EQuanticResolveMacPackaging"
            Condition="'$(_EqMacHead)' == 'true'">
        <PropertyGroup>
            <!-- The name the user reads, which a project already states as ApplicationTitle —
                 the same property MAUI uses, so nobody learns a second one. -->
            <_EqAppName>$(AssemblyName)</_EqAppName>
            <_EqAppName Condition="'$(ApplicationTitle)' != ''">$(ApplicationTitle)</_EqAppName>
            <_EqBundleId Condition="'$(EQuanticBundleId)' == ''">com.equantic.$(AssemblyName.ToLowerInvariant())</_EqBundleId>
            <_EqBundleId Condition="'$(EQuanticBundleId)' != ''">$(EQuanticBundleId)</_EqBundleId>
            <_EqIcns>$(_EqIconDir)/$(_EqAppName).icns</_EqIcns>

            <!-- A real identity turns the hardened runtime on WITH it — decided here, before
                 anything reads it, because the entitlements below depend on the answer. It used to
                 be settled further down, next to the codesign call, so an app that set only
                 EQuanticSigningIdentity got hardened signing with NO runtime entitlements: the
                 exact launch failure this whole block exists to prevent, produced by the block. -->
            <EQuanticHardenedRuntime Condition="'$(EQuanticHardenedRuntime)' == '' AND '$(EQuanticSigningIdentity)' != ''">true</EQuanticHardenedRuntime>

            <!--
                What the RUNTIME needs, which the SDK adds because it already knows every fact the
                answer depends on — and because the alternative is an app author learning that .NET
                on macOS has a library-validation problem. Measured on this repo's own sample: a
                framework-dependent app under the hardened runtime dies at LAUNCH loading Microsoft's
                libhostfxr.dylib ("different Team IDs"), before a line of its code runs; and any
                non-AOT app executes JIT-compiled methods from its first instruction.

                SELF-CONTAINED is NOT exempt, which is worth stating because the opposite is the
                reasonable guess: the app ships its own copy of the runtime, so surely validation is
                satisfied. It is not — measured by re-signing one self-contained hardened bundle with
                allow-jit alone and watching it die on libhostfxr exactly like the framework-dependent
                one. Only PublishAot, which loads no dylib at all, gets neither.
            -->
            <_EqRuntimeEntitlements Condition="'$(EQuanticHardenedRuntime)' == 'true' AND '$(PublishAot)' != 'true'">com.apple.security.cs.disable-library-validation;com.apple.security.cs.allow-jit</_EqRuntimeEntitlements>
            <_EqRuntimeEntitlements Condition="'$(EQuanticHardenedRuntime)' == 'true' AND '$(PublishAot)' == 'true'"></_EqRuntimeEntitlements>
        </PropertyGroup>

        <Message Condition="'$(_EqRuntimeEntitlements)' != ''" Importance="normal"
                 Text="eQuantic.UI: hardened runtime — the SDK is declaring what the .NET runtime itself needs ($(_EqRuntimeEntitlements)); your app declares only its own." />

        <!--
            ENTITLEMENTS — what the app needs the SYSTEM to permit, read from its own
            `[assembly: PhotonEntitlement(…)]` declarations.

            ONE of the two families is invisible until release, and that is what makes it dangerous.
            A development build signs ad hoc, WITHOUT the hardened runtime, so the exceptions that
            relax it (`com.apple.security.cs.*`) permit nothing and are asked for by nothing: an app
            that generates code (a scripting VM, a WASM engine) runs perfectly for months and is
            then killed with SIGKILL/CODESIGNING on the first machine that installs the signed
            build. No catch sees it; the process is simply gone.

            The App Sandbox's permissions are NOT that shape and saying so matters here, because
            this block used to read as though nothing at all needed permitting in development. The
            sandbox is enforced from the signature, an ad-hoc one included, so an app declaring
            `com.apple.security.app-sandbox` is sandboxed on the developer's own machine and its
            `network.client` is honoured there. That is why EQ4003 reports only the first family.

            Note which key each shape needs, because the names mislead: the allow-jit in
            _EqRuntimeEntitlements covers pages mapped through MAP_JIT, which is what the .NET
            runtime uses and why the SDK declares it. An app whose engine writes plain executable
            memory instead — wasmtime, so YARA-X — needs allow-unsigned-executable-memory, and
            declares that one itself through PhotonEntitlement.
        -->
        <!--
            The `hardened` argument below carries the CONFIGURATION half of EQ4003, because that
            half is this file's to know and the other half — which of Apple's families a signature
            consults — is the vocabulary's. It is passed VERBATIM, and the tool mirrors the question
            asked a few lines down (`_EqSignOption`) rather than being told the answer: hardening is
            on for `true` and off for every other non-empty value, so `False`, `off` and the typo
            `ture` are all builds without it. EMPTY is the case that is not a mistake at all — an
            ordinary development build that never asked, and the one a warning here used to fire on
            at every single build.
        -->
        <ItemGroup>
            <_EqEntitlementsArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqEntitlementsArgument Include="command" Value="entitlements" />
            <_EqEntitlementsArgument Include="assembly" Option="--assembly" Value="$(TargetDir)$(TargetFileName)" />
            <_EqEntitlementsArgument Include="plist" Option="--plist" Value="$(_EqIconDir)/$(AssemblyName).entitlements" />
            <_EqEntitlementsArgument Include="runtime" Option="--also" Value="$(_EqRuntimeEntitlements)" />
            <_EqEntitlementsArgument Include="hardened" Option="--hardened" Value="$(EQuanticHardenedRuntime)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqEntitlementsArgument)" StandardOutputImportance="normal" />

        <PropertyGroup>
            <_EqEntitlements>$(_EqIconDir)/$(AssemblyName).entitlements</_EqEntitlements>

            <!-- Ad hoc unless the app names a real identity. Ad hoc is right for development and
                 says so honestly: it proves nothing about origin, and it is what lets a local app be
                 treated as an app at all. It also carries entitlements — an ad-hoc signed app IS
                 sandboxed when it declares the App Sandbox — so what development does not exercise
                 is the hardened runtime, not entitlements as a whole. A published build sets
                 EQuanticSigningIdentity to a Developer ID and gets the hardened runtime with it,
                 because notarization requires both. -->
            <_EqSignIdentity>-</_EqSignIdentity>
            <_EqSignIdentity Condition="'$(EQuanticSigningIdentity)' != ''">$(EQuanticSigningIdentity)</_EqSignIdentity>
        </PropertyGroup>
        <!-- The entitlements only when the app declared some: signing WITH an empty entitlements file
             is not the same as signing without one, and it grants nothing while still changing the
             signature. -->
        <ItemGroup>
            <_EqSignOption Include="hardened runtime" Option="--options" Value="runtime" Condition="'$(EQuanticHardenedRuntime)' == 'true'" />
            <_EqSignOption Include="entitlements" Option="--entitlements" Value="$(_EqEntitlements)" Condition="Exists('$(_EqEntitlements)')" />
        </ItemGroup>

        <!--
            An entitlement the app declares but never gets is the failure this whole block exists to
            prevent, and it IS reported — as EQ4003, by the eqicon call above, which is the only
            thing here that knows which keys the answer depends on.

            It used to be a <Warning> on this spot, and it was wrong three ways. It claimed
            entitlements "are only consulted under the hardened runtime", which holds for
            `com.apple.security.cs.*` and NOT for the App Sandbox's permissions — the sample that
            fired it declares `network.client`, whose gate is the sandbox and which an ad-hoc
            signature honours. It advised setting EQuanticSigningIdentity, a branch that cannot
            reach it, because the property above turns the hardened runtime on with the identity. And
            it fired on every development build, where there is no certificate, the bundle is
            ad-hoc signed, and there is nothing the developer could have done differently.
        -->
    </Target>

    <!--
        THE DEVELOPMENT BUNDLE, beside the build output: what `dotnet run` launches and what a
        debugger attaches to. Ad-hoc signed, from the build's own files.
    -->
    <Target Name="EQuanticMacAppBundle" AfterTargets="Build"
            DependsOnTargets="EQuanticResolveMacPackaging"
            Condition="'$(_EqMacHead)' == 'true'">
        <PropertyGroup>
            <!-- ALWAYS beside the build output, never beside the sources. In an outer multi-TFM
                 pass TargetDir is empty, and a bundle written there lands in the project folder —
                 where the next build reads its own obj/ back as source files and fails on
                 duplicate assembly attributes. -->
            <_EqBundleDir>$([MSBuild]::EnsureTrailingSlash('$(TargetDir)'))$(_EqAppName).app</_EqBundleDir>
        </PropertyGroup>

        <!--
            ANOTHER BUILD OF THIS APP IS NOT PAYLOAD OF THIS ONE. .NET nests its output
            directories: a RID-specific build lands in `bin/<config>/<tfm>/<rid>/` and its publish
            tree inside that again — both UNDER the plain build's own output directory. So a
            developer who publishes for osx-arm64 and then builds again has an entire second copy of
            the app inside the directory the development bundle is assembled from.

            The failure is not quiet, which is the one mercy: codesign refuses the whole bundle over
            the disk image it finds in there, and an ordinary `dotnet build` fails with a signing
            error naming a file nobody put there.

            Recognised by CONTENT rather than by name: a subdirectory holding this app's own
            assembly is another build of it. A rule that matched "publish" or a RID-shaped name
            instead would be guessing, and would take an app's own content folder with it.
        -->
        <ItemGroup>
            <_EqOutputChild Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)', '*', System.IO.SearchOption.TopDirectoryOnly))"
                            Condition="Exists('$(TargetDir)')" />
            <_EqOtherBuild Include="%(_EqOutputChild.Identity)"
                           Condition="Exists('%(_EqOutputChild.Identity)/$(TargetFileName)')" />
            <_EqOtherBuild Include="%(_EqOutputChild.Identity)/publish"
                           Condition="Exists('%(_EqOutputChild.Identity)/publish')" />
            <_EqOtherBuild Include="$(TargetDir)publish" Condition="Exists('$(TargetDir)publish')" />
        </ItemGroup>
        <PropertyGroup>
            <!-- GUARDED: GetFullPath of an empty string is not "the current directory", it is
                 MSB4184 — the whole build fails on a property that is normally set by the SDK and
                 is not guaranteed to be. Nothing here needs PublishDir to exist; the sibling-build
                 rule below finds a publish tree anyway. -->
        </PropertyGroup>
        <ItemGroup>
            <_EqBundleExclude Include="publish" Value="$([System.IO.Path]::GetFullPath('$(PublishDir)'))" Condition="'$(PublishDir)' != ''" />
            <_EqBundleExclude Include="@(_EqOtherBuild)" Value="%(Identity)" />
        </ItemGroup>

        <ItemGroup Condition="'$(EQuanticAppIconSource)' != ''">
            <_EqMacIconArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqMacIconArgument Include="source" Option="--source" Value="$(EQuanticAppIconSource)" />
            <_EqMacIconArgument Include="icns" Option="--macos" Value="$(_EqIcns)" />
        </ItemGroup>
        <RunProgram Condition="'$(EQuanticAppIconSource)' != ''"
              Program="dotnet" Arguments="@(_EqMacIconArgument)" StandardOutputImportance="normal" />

        <!--
            The bundle AND its payload in one call. What belongs inside is decided in C#
            (MacAppPayload) rather than by a glob, because every one of those rules was learned from
            a bundle that failed to sign, and a glob is where they cannot be tested.

            The publish directory is excluded BY PATH: it lives under the build output, and a
            build-output bundle that swallows it ships an entire second copy of the app inside
            itself — 86 MB of it, measured on this repo's own desktop sample after one publish.
        -->
        <ItemGroup>
            <_EqMacBundleArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqMacBundleArgument Include="command" Value="bundle" />
            <_EqMacBundleArgument Include="app" Option="--app" Value="$(_EqBundleDir)" />
            <_EqMacBundleArgument Include="executable" Option="--exec" Value="$(AssemblyName)" />
            <_EqMacBundleArgument Include="name" Option="--name" Value="$(_EqAppName)" />
            <_EqMacBundleArgument Include="identifier" Option="--id" Value="$(_EqBundleId)" />
            <_EqMacBundleArgument Include="version" Option="--version" Value="$(Version)" />
            <_EqMacBundleArgument Include="icns" Option="--icns" Value="$(_EqIcns)" />
            <_EqMacBundleArgument Include="capabilities" Option="--capabilities" Value="$(TargetDir)$(TargetFileName)" />
            <_EqMacBundleArgument Include="payload" Option="--payload" Value="$(TargetDir)" />
            <_EqMacBundleArgument Include="@(_EqBundleExclude)" Option="--exclude" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqMacBundleArgument)" StandardOutputImportance="normal" />
        <ItemGroup>
            <_EqMacModeArgument Include="mode" Value="+x" />
            <_EqMacModeArgument Include="executable" Value="$(_EqBundleDir)/Contents/MacOS/$(AssemblyName)" />
        </ItemGroup>
        <RunProgram Program="chmod" Arguments="@(_EqMacModeArgument)" />

        <!--
            And SIGN it, ad hoc, under the bundle's own identifier. Without this the identity is
            whatever the apphost was signed as — "apphost" — and a capability that asks who is
            calling gets an answer that names nothing. Ad hoc is right for a development build: it
            proves nothing about origin, which is honest, and it is what a local app needs to be
            treated as an app at all. A shipped build re-signs with a real identity.

            A signing failure FAILS THE BUILD. It used to be a warning, and the .app kept whatever
            signature the previous build left — an identity that silently flips is how a TCC grant
            (Full Disk Access) evaporates between builds, and nobody connects a lost permission to
            a warning that scrolled past yesterday. A loud build is the cheap version of that hour.
        -->
        <ItemGroup>
            <_EqMacSignArgument Include="force" Value="--force" />
            <_EqMacSignArgument Include="deep" Value="--deep" />
            <_EqMacSignArgument Include="identity" Option="--sign" Value="$(_EqSignIdentity)" />
            <_EqMacSignArgument Include="@(_EqSignOption)" />
            <_EqMacSignArgument Include="identifier" Option="--identifier" Value="$(_EqBundleId)" />
            <_EqMacSignArgument Include="bundle" Value="$(_EqBundleDir)" />
        </ItemGroup>
        <RunProgram Program="codesign" Arguments="@(_EqMacSignArgument)" StandardOutputImportance="normal" />
    </Target>

    <!--
        THE SHIPPED BUNDLE — the one `dotnet publish` produces, and the reason this target exists at
        all.

        Until it did, the .app was assembled from the BUILD output and `publish/` held loose files
        with no bundle in it. Every publish decision therefore stopped at the bundle's door:
        trimming, self-contained, single-file, AOT. Measured on this repo's desktop sample with
        PublishTrimmed on: publish 23 MB, bundle 172 MB — the app you would ship was seven times the
        app you asked for, and none of the trimming reached it.

        The bundle lands INSIDE the publish directory, next to the loose files, which is where MAUI
        puts its own and therefore where tooling already looks.
    -->
    <Target Name="EQuanticMacAppPackage" AfterTargets="Publish"
            DependsOnTargets="EQuanticResolveMacPackaging"
            Condition="'$(_EqMacHead)' == 'true'">
        <PropertyGroup>
            <!-- Two steps rather than one nested call. The nested form parses and works — this
                 target published a signed bundle and a disk image with it — but a reader has to
                 count quotes to be sure, and that is a poor reason to make anyone read carefully. -->
            <_EqPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_EqPublishDir>
            <_EqPublishDir>$([MSBuild]::EnsureTrailingSlash('$(_EqPublishDir)'))</_EqPublishDir>
            <_EqShipDir>$(_EqPublishDir)$(_EqAppName).app</_EqShipDir>
            <_EqDmg>$(_EqPublishDir)$(_EqAppName).dmg</_EqDmg>
            <_EqNotaryZip>$(_EqIconDir)/$(AssemblyName).notarize.zip</_EqNotaryZip>
            <_EqNotaryBy Condition="'$(EQuanticNotaryProfile)' != ''">profile</_EqNotaryBy>
            <_EqNotaryBy Condition="'$(_EqNotaryBy)' == '' AND '$(EQuanticNotaryAppleId)' != '' AND '$(EQuanticNotaryTeamId)' != '' AND '$(EQuanticNotaryPassword)' != ''">credentials</_EqNotaryBy>

            <!-- Credentials, never the project's business to hold: either a notarytool keychain
                 profile a developer stored once, or the three values a CI holds as secrets. Both
                 spellings, because a laptop has a keychain and a build agent does not. -->
        </PropertyGroup>
        <ItemGroup>
            <_EqNotaryCredential Include="profile" Option="--keychain-profile" Value="$(EQuanticNotaryProfile)" Condition="'$(_EqNotaryBy)' == 'profile'" />
            <_EqNotaryCredential Include="apple id" Option="--apple-id" Value="$(EQuanticNotaryAppleId)" Condition="'$(_EqNotaryBy)' == 'credentials'" />
            <_EqNotaryCredential Include="team" Option="--team-id" Value="$(EQuanticNotaryTeamId)" Condition="'$(_EqNotaryBy)' == 'credentials'" />
            <_EqNotaryCredential Include="password" Option="--password" Value="$(EQuanticNotaryPassword)" Condition="'$(_EqNotaryBy)' == 'credentials'" />
        </ItemGroup>

        <ItemGroup Condition="'$(EQuanticAppIconSource)' != ''">
            <_EqShipIconArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqShipIconArgument Include="source" Option="--source" Value="$(EQuanticAppIconSource)" />
            <_EqShipIconArgument Include="icns" Option="--macos" Value="$(_EqIcns)" />
        </ItemGroup>
        <RunProgram Condition="'$(EQuanticAppIconSource)' != ''"
              Program="dotnet" Arguments="@(_EqShipIconArgument)" StandardOutputImportance="normal" />

        <ItemGroup>
            <_EqShipBundleArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqShipBundleArgument Include="command" Value="bundle" />
            <_EqShipBundleArgument Include="app" Option="--app" Value="$(_EqShipDir)" />
            <_EqShipBundleArgument Include="executable" Option="--exec" Value="$(AssemblyName)" />
            <_EqShipBundleArgument Include="name" Option="--name" Value="$(_EqAppName)" />
            <_EqShipBundleArgument Include="identifier" Option="--id" Value="$(_EqBundleId)" />
            <_EqShipBundleArgument Include="version" Option="--version" Value="$(Version)" />
            <_EqShipBundleArgument Include="icns" Option="--icns" Value="$(_EqIcns)" />
            <_EqShipBundleArgument Include="capabilities" Option="--capabilities" Value="$(TargetDir)$(TargetFileName)" />
            <_EqShipBundleArgument Include="payload" Option="--payload" Value="$(_EqPublishDir)" />
            <_EqShipBundleArgument Include="disk image" Option="--exclude" Value="$(_EqDmg)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqShipBundleArgument)" StandardOutputImportance="normal" />
        <ItemGroup>
            <_EqShipModeArgument Include="mode" Value="+x" />
            <_EqShipModeArgument Include="executable" Value="$(_EqShipDir)/Contents/MacOS/$(AssemblyName)" />
        </ItemGroup>
        <RunProgram Program="chmod" Arguments="@(_EqShipModeArgument)" />
        <ItemGroup>
            <_EqShipSignArgument Include="force" Value="--force" />
            <_EqShipSignArgument Include="deep" Value="--deep" />
            <_EqShipSignArgument Include="identity" Option="--sign" Value="$(_EqSignIdentity)" />
            <_EqShipSignArgument Include="@(_EqSignOption)" />
            <_EqShipSignArgument Include="identifier" Option="--identifier" Value="$(_EqBundleId)" />
            <_EqShipSignArgument Include="bundle" Value="$(_EqShipDir)" />
        </ItemGroup>
        <RunProgram Program="codesign" Arguments="@(_EqShipSignArgument)" StandardOutputImportance="normal" />

        <!-- Ad hoc is fine on a laptop and is NOT distributable: Gatekeeper refuses it on any
             machine that did not build it. Said once, at publish, where it is actionable. -->
        <Warning Condition="'$(EQuanticSigningIdentity)' == ''"
                 Text="This bundle is signed AD HOC, which Gatekeeper refuses on every machine but this one. Set EQuanticSigningIdentity to a Developer ID Application certificate to ship it." />

        <!--
            NOTARIZATION — Apple scanning the signed app and issuing a ticket, without which a
            downloaded app is refused with "cannot be opened because the developer cannot be
            verified". Three steps that are always the same three steps, so the SDK does them: zip
            the way notarytool expects (ditto, keeping the bundle), submit and WAIT, then staple the
            ticket into the bundle so it verifies with no network at all.
        -->
        <Message Condition="'$(_EqNotaryBy)' != ''" Importance="high"
                 Text="eQuantic.UI: submitting $(_EqAppName).app for notarization — Apple decides how long this takes." />
        <ItemGroup Condition="'$(_EqNotaryBy)' != ''">
            <_EqNotaryZipArgument Include="create" Value="-c" />
            <_EqNotaryZipArgument Include="zip" Value="-k" />
            <_EqNotaryZipArgument Include="keep parent" Value="--keepParent" />
            <_EqNotaryZipArgument Include="bundle" Value="$(_EqShipDir)" />
            <_EqNotaryZipArgument Include="archive" Value="$(_EqNotaryZip)" />
            <_EqNotarySubmitArgument Include="tool" Value="notarytool" />
            <_EqNotarySubmitArgument Include="command" Value="submit" />
            <_EqNotarySubmitArgument Include="archive" Value="$(_EqNotaryZip)" />
            <_EqNotarySubmitArgument Include="@(_EqNotaryCredential)" />
            <_EqNotarySubmitArgument Include="wait" Value="--wait" />
            <_EqStapleArgument Include="tool" Value="stapler" />
            <_EqStapleArgument Include="command" Value="staple" />
            <_EqStapleArgument Include="bundle" Value="$(_EqShipDir)" />
        </ItemGroup>
        <RunProgram Condition="'$(_EqNotaryBy)' != ''" Program="ditto" Arguments="@(_EqNotaryZipArgument)" />
        <RunProgram Condition="'$(_EqNotaryBy)' != ''" Program="xcrun" Arguments="@(_EqNotarySubmitArgument)"
              EchoOff="true" StandardOutputImportance="high" />
        <RunProgram Condition="'$(_EqNotaryBy)' != ''" Program="xcrun" Arguments="@(_EqStapleArgument)"
              StandardOutputImportance="normal" />
        <Delete Condition="'$(_EqNotaryBy)' != ''" Files="$(_EqNotaryZip)" />

        <!-- Notarizing an AD-HOC signature cannot succeed — Apple has nothing to attach a ticket
             to. Better to say which of the two is missing than to let notarytool answer it in its
             own vocabulary five minutes later. -->
        <Warning Condition="'$(_EqNotaryBy)' != '' AND '$(EQuanticSigningIdentity)' == ''"
                 Text="Notarization needs a real signature: set EQuanticSigningIdentity as well, or Apple has nothing to issue a ticket for." />

        <!--
            THE DISK IMAGE, when the app is distributed as one. Built from the stapled bundle, so
            the ticket travels inside it and the app verifies offline the moment it is dragged out;
            the image itself is signed with the same identity so the download is not a stranger.
        -->
        <Delete Condition="'$(EQuanticPackageFormat)' == 'Dmg'" Files="$(_EqDmg)" />
        <ItemGroup Condition="'$(EQuanticPackageFormat)' == 'Dmg'">
            <_EqDiskImageArgument Include="command" Value="create" />
            <_EqDiskImageArgument Include="volume" Option="-volname" Value="$(_EqAppName)" />
            <_EqDiskImageArgument Include="bundle" Option="-srcfolder" Value="$(_EqShipDir)" />
            <_EqDiskImageArgument Include="overwrite" Value="-ov" />
            <_EqDiskImageArgument Include="format" Option="-format" Value="UDZO" />
            <_EqDiskImageArgument Include="image" Value="$(_EqDmg)" />
            <_EqDiskImageSignArgument Include="force" Value="--force" />
            <_EqDiskImageSignArgument Include="identity" Option="--sign" Value="$(_EqSignIdentity)" />
            <_EqDiskImageSignArgument Include="image" Value="$(_EqDmg)" />
        </ItemGroup>
        <RunProgram Condition="'$(EQuanticPackageFormat)' == 'Dmg'"
              Program="hdiutil" Arguments="@(_EqDiskImageArgument)" StandardOutputImportance="normal" />
        <RunProgram Condition="'$(EQuanticPackageFormat)' == 'Dmg' AND '$(EQuanticSigningIdentity)' != ''"
              Program="codesign" Arguments="@(_EqDiskImageSignArgument)" StandardOutputImportance="normal" />

        <Message Importance="high" Text="eQuantic.UI: $(_EqShipDir)" />
        <Message Condition="'$(EQuanticPackageFormat)' == 'Dmg'" Importance="high" Text="eQuantic.UI: $(_EqDmg)" />
    </Target>

    <!--
        The keys an Apple platform reads, from what the app declared on its builder: the sentence
        behind each permission, and the URL schemes that open the app. The generator put the
        declarations on the assembly; this reads them back off the compiled output and writes the
        partial manifest. One statement in C#, and no app author opens an Info.plist, which is the
        promise the whole SDK is making. The app's identifier names its URL type, as the Mac's
        bundle does.
    -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'ios'">
        <_EqCapabilityPlist>$(_EqIconDir)/Capabilities.plist</_EqCapabilityPlist>
    </PropertyGroup>

    <!-- The MSBuild-resolved reference list, for TOOLING rather than for eqc: the native SDK never
         transpiles, but the VS Code design host builds a Roslyn compilation of the project and needs
         the exact assemblies csc compiles against — without them named arguments are emitted in
         syntactic order, silently. Same file, same rules as the web SDK's: the item comes from
         FindReferenceAssembliesForReferences (declared as a dependency, since standalone invocations
         see it empty otherwise), and an empty set is never worth writing over a good one. -->
    <Target Name="EQuanticDesignRefs" AfterTargets="Compile"
        DependsOnTargets="ResolveReferences;FindReferenceAssembliesForReferences">
        <MakeDir Directories="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)equantic.refs.txt"
            Lines="@(ReferencePathWithRefAssemblies)"
            Overwrite="true" WriteOnlyWhenDifferent="true"
            Condition="'@(ReferencePathWithRefAssemblies)' != ''" />
    </Target>

    <!--
        The app's FACES, as the web SDK reads them (#1055): every OpenType file under Assets embedded
        in the app's assembly under a resource name of its own, and read by eqicon into one class with
        a FontFamily per family. Photon registers a face from the assembly the first time text asks
        for its family, so nothing is copied into the bundle.

        Android packs every file under `Assets/` into the package's assets by default, so the fonts
        leave that set here, after .NET's targets added them: a face shipped twice is twice the bytes
        and one of them unread.
    -->
    <PropertyGroup>
        <EQuanticFontsFile Condition="'$(EQuanticFontsFile)' == ''">$(IntermediateOutputPath)generated/eQuantic.UI.Fonts/Fonts.g.cs</EQuanticFontsFile>
        <EQuanticFontsNamespace Condition="'$(EQuanticFontsNamespace)' == ''">$(RootNamespace)</EQuanticFontsNamespace>
        <EQuanticFontsNamespace Condition="'$(EQuanticFontsNamespace)' == ''">$(AssemblyName)</EQuanticFontsNamespace>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(EQuanticAssetsDir)')">
        <EmbeddedResource Include="$(EQuanticAssetsDir)/**/*.ttf;$(EQuanticAssetsDir)/**/*.otf" EQuanticFont="true"
            LogicalName="eQuantic.UI.Fonts/%(Filename)%(Extension)" />
        <AndroidAsset Remove="$(EQuanticAssetsDir)/**/*.ttf;$(EQuanticAssetsDir)/**/*.otf" />
    </ItemGroup>

    <!--
        A family from GOOGLE FONTS (#1057): `[assembly: GoogleFont("Inter", FontWeight.Bold)]` anywhere in
        the app's C#. eqicon reads the files that mention it, fetches the file of each cut they declare,
        pins it in fonts.lock.json beside the project (the SDK writes it and the app commits it, as it
        commits NuGet's packages.lock.json) and keeps it under obj, one file a cut. The files are embedded
        here as the faces under Assets are, so the catalog reads them and nothing after it knows a
        provider exists.

        BEFORE AssignTargetPaths, the first target that reads EmbeddedResource. Measured: a target before
        PrepareResources runs after the resource pipeline has read the items, and the face was not
        embedded. Which files mention the attribute is read here, in MSBuild, so an app that declares no
        family starts no program: the tool runs when a file does, or when a lock is left to bring in step.
        A design-time build asks nobody, and embeds what the last build fetched.
    -->
    <PropertyGroup>
        <_EqGoogleFontsLock>$(MSBuildProjectDirectory)/fonts.lock.json</_EqGoogleFontsLock>
        <_EqGoogleFontsDir>$(BaseIntermediateOutputPath)equantic/fonts/google/</_EqGoogleFontsDir>
    </PropertyGroup>
    <Target Name="EQuanticGoogleFonts" BeforeTargets="AssignTargetPaths">
        <ItemGroup>
            <_EqGoogleFontCandidate Include="@(Compile)" Condition="Exists('%(Compile.FullPath)')" />
            <_EqGoogleFontSource Include="@(_EqGoogleFontCandidate)"
                Condition="$([System.IO.File]::ReadAllText('%(_EqGoogleFontCandidate.FullPath)').Contains('GoogleFont'))" />
        </ItemGroup>
        <PropertyGroup>
            <_EqGoogleFontSourcesFile>$(IntermediateOutputPath)equantic.google-fonts.txt</_EqGoogleFontSourcesFile>
            <_EqFetchGoogleFonts Condition="'$(DesignTimeBuild)' != 'true' AND ('@(_EqGoogleFontSource)' != '' OR Exists('$(_EqGoogleFontsLock)'))">true</_EqFetchGoogleFonts>
        </PropertyGroup>
        <Error Code="EQ4001" Condition="'$(_EqFetchGoogleFonts)' == 'true' AND !Exists('$(_EqIconToolDir)eqicon.dll')"
            Text="This project declares families from Google Fonts, which the eQuantic icon tool fetches, and the tool is missing at '$(_EqIconToolDir)eqicon.dll'. In a source-tree build this is a broken build graph (eQuantic.UI.Native.Build did not build first); from a package it is a broken SDK package. Neither is fixed by building twice." />
        <WriteLinesToFile File="$(_EqGoogleFontSourcesFile)" Condition="'$(_EqFetchGoogleFonts)' == 'true'"
            Lines="@(_EqGoogleFontSource->'%(FullPath)')" Overwrite="true" />
        <ItemGroup Condition="'$(_EqFetchGoogleFonts)' == 'true'">
            <_EqGoogleFontsArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqGoogleFontsArgument Include="command" Value="fetch-fonts" />
            <_EqGoogleFontsArgument Include="sources" Option="--sources" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqGoogleFontSourcesFile)'))" />
            <_EqGoogleFontsArgument Include="lock" Option="--lock" Value="$(_EqGoogleFontsLock)" />
            <_EqGoogleFontsArgument Include="dir" Option="--dir" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqGoogleFontsDir)'))" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqGoogleFontsArgument)" StandardOutputImportance="normal"
            Condition="'$(_EqFetchGoogleFonts)' == 'true'" />
        <ItemGroup Condition="Exists('$(_EqGoogleFontsLock)')">
            <_EqGoogleFontFile Include="$(_EqGoogleFontsDir)*.ttf" />
            <EmbeddedResource Include="@(_EqGoogleFontFile)" EQuanticFont="true"
                LogicalName="eQuantic.UI.Fonts/google/%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <!-- What eqicon is handed, two lines a file: its path, then the resource name it is embedded under.
         One line a file, `path|resource`, was cut at the first bar, which a path may hold on macOS and
         Linux, and the record was passed over: a catalog with no face, and a theme that named one did
         not compile. Beside it, the record of the SET, as the vectors keep one: a removed font changes
         no remaining file, and the assembly and the namespace change the catalog too. -->
    <Target Name="_EQuanticFontInputs">
        <ItemGroup>
            <_EqFontSource Include="@(EmbeddedResource->WithMetadataValue('EQuanticFont', 'true'))" />
        </ItemGroup>
        <PropertyGroup>
            <_EqFontListFile>$(IntermediateOutputPath)equantic.fonts.txt</_EqFontListFile>
            <_EqFontInputsFile>$(IntermediateOutputPath)equantic.fonts.inputs</_EqFontInputsFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_EqFontListFile)" Condition="'@(_EqFontSource)' != ''"
            Lines="@(_EqFontSource->'%(FullPath)%0A%(LogicalName)')"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
        <WriteLinesToFile File="$(_EqFontInputsFile)" Condition="'@(_EqFontSource)' != ''"
            Lines="assembly=$(AssemblyName);namespace=$(EQuanticFontsNamespace)"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="EQuanticFonts" BeforeTargets="BeforeCompile"
        DependsOnTargets="_EQuanticFontInputs"
        Condition="'@(EmbeddedResource->WithMetadataValue('EQuanticFont', 'true'))' != ''"
        Inputs="@(_EqFontSource);$(_EqFontListFile);$(_EqFontInputsFile);$(_EqIconToolDir)eqicon.dll"
        Outputs="$(EQuanticFontsFile)">
        <ItemGroup>
            <_EqFontsArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqFontsArgument Include="command" Value="fonts" />
            <!-- Joined to the project only when relative: an artifacts layout or a shared obj makes
                 the intermediate path absolute, and a prefix would name a file nobody wrote. -->
            <_EqFontsArgument Include="list" Option="--list" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_EqFontListFile)'))" />
            <_EqFontsArgument Include="assembly" Option="--assembly" Value="$(AssemblyName)" />
            <_EqFontsArgument Include="catalog" Option="--out" Value="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(EQuanticFontsFile)'))" />
            <_EqFontsArgument Include="namespace" Option="--namespace" Value="$(EQuanticFontsNamespace)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqFontsArgument)" StandardOutputImportance="normal" />
        <Touch Files="$(EQuanticFontsFile)" Condition="Exists('$(EQuanticFontsFile)')" />
        <!-- Added here, and when the target is skipped too: MSBuild still runs a skipped target's
             ItemGroups, which keeps the catalog a compile input on every build its fonts did not
             change. An `Exists` outside a target is answered before the file is written. -->
        <ItemGroup>
            <Compile Include="$(EQuanticFontsFile)" Condition="Exists('$(EQuanticFontsFile)')" />
        </ItemGroup>
    </Target>

    <!--
        TWO moments, and each has its reason.

        WRITTEN after the compiler, because the declarations are read off the compiled assembly.

        HANDED OVER when Apple's packaging writes the FINAL manifest, not when it compiles the first
        one. It compiles a first manifest early in the build, from the PartialAppManifest items
        collected by then, and merges what later steps contribute (the asset catalog's keys, a
        Core ML model's) as it writes the bundle's Info.plist. Added to PartialAppManifest after
        Compile, as this was, the file arrived after the first and was never part of the second:
        an iPhone app declared its camera sentence in C# and shipped without it (#872).

        The early list has a public door, CollectAppManifestsDependsOn, and it is the wrong one
        here: a target on it that needs the compiled assembly drags Compile in front of the rest of
        the build, and the compiler then runs before the app's resources are prepared. Measured: an
        app's .resx is no longer embedded in its assembly. So this uses the late list, whose names
        are the iOS SDK's own and carry its underscore. scripts/check-ios-launch.sh compares the
        built Info.plist with this file, so a release of that SDK that renames them fails there
        instead of shipping an app without its keys.
    -->
    <Target Name="EQuanticCapabilityManifest" AfterTargets="Compile"
            Condition="'$(_EqPlatform)' == 'ios'">
        <ItemGroup>
            <_EqCapabilitiesArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqCapabilitiesArgument Include="command" Value="capabilities" />
            <_EqCapabilitiesArgument Include="assembly" Option="--assembly" Value="@(IntermediateAssembly)" />
            <_EqCapabilitiesArgument Include="plist" Option="--plist" Value="$(_EqCapabilityPlist)" />
            <_EqCapabilitiesArgument Include="id" Option="--id" Value="$(ApplicationId)"
                Condition="'$(ApplicationId)' != ''" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqCapabilitiesArgument)" StandardOutputImportance="normal" />
    </Target>

    <!-- Its own target, because a build of several runtime identifiers writes the final manifest
         in an outer build that compiles nothing: the inner builds wrote the file, and the outer one
         still has to hand it over. -->
    <Target Name="EQuanticContributeCapabilityManifest" BeforeTargets="_WriteAppManifest"
            Condition="'$(_EqPlatform)' == 'ios'">
        <ItemGroup Condition="Exists('$(_EqCapabilityPlist)')">
            <_PostCompilePartialAppManifest Include="$(_EqCapabilityPlist)" />
        </ItemGroup>
    </Target>

    <!--
        The links an Android app may ASK the system about. Since Android 11 an app sees only the
        apps its manifest lists under queries, so "does something open this link" answers no for
        every scheme that is not there. The Android build writes the manifest from attributes and
        has none for that element, so the SDK writes it as a fragment (an AndroidManifestOverlay,
        the Android SDK's own item for one) from what the compiled assembly declares: the web's two
        schemes, and each builder.Workspace.Opens… line. No app author opens an AndroidManifest.xml.

        Before the merge, which is after the compiler: the declarations are read off the compiled
        assembly.
    -->
    <PropertyGroup Condition="'$(_EqPlatform)' == 'android'">
        <_EqAndroidQueries>$(_EqIconDir)/Queries.xml</_EqAndroidQueries>
        <_EqAndroidMergedManifest>$(IntermediateOutputPath)android/AndroidManifest.xml</_EqAndroidMergedManifest>
    </PropertyGroup>

    <Target Name="EQuanticAndroidQueries" BeforeTargets="_ManifestMerger"
            Condition="'$(_EqPlatform)' == 'android'">
        <ItemGroup>
            <_EqQueriesArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqQueriesArgument Include="command" Value="queries" />
            <_EqQueriesArgument Include="assembly" Option="--assembly" Value="@(IntermediateAssembly)" />
            <_EqQueriesArgument Include="manifest" Option="--manifest" Value="$(_EqAndroidQueries)" />
        </ItemGroup>
        <RunProgram Program="dotnet" Arguments="@(_EqQueriesArgument)" StandardOutputImportance="normal" />
        <ItemGroup Condition="Exists('$(_EqAndroidQueries)')">
            <AndroidManifestOverlay Include="$(_EqAndroidQueries)" />
        </ItemGroup>
    </Target>

    <!--
        The merge does not count its overlays among its inputs, so an app that adds
        builder.Workspace.OpensMail() and builds again would keep the manifest it had. The fragment
        is rewritten only when what it says changed, and a merged manifest older than it is stale:
        removing it is what makes the merge run.
    -->
    <Target Name="EQuanticAndroidQueriesChanged" BeforeTargets="_ManifestMerger"
            AfterTargets="EQuanticAndroidQueries"
            Condition="'$(_EqPlatform)' == 'android'"
            Inputs="$(_EqAndroidQueries)" Outputs="$(_EqAndroidMergedManifest)">
        <Delete Files="$(_EqAndroidMergedManifest)" />
    </Target>

    <Target Name="EQuanticAppIcon"
            Condition="'$(EQuanticAppIconSource)' != ''"
            BeforeTargets="_CompileAppManifest;_CoreCompileImageAssets;_CompileImageAssets;_UpdateAndroidResgen;CoreCompile">
        <PropertyGroup>
            <!-- No TargetFramework during restore: write EVERYTHING the app's platforms could ask
                 for. Deriving four small PNGs nobody reads costs less than a build that cannot see
                 the one it needs. -->
            <_EqIconOption Condition="'$(TargetFramework)' == ''">--android</_EqIconOption>
            <_EqIconOutput Condition="'$(TargetFramework)' == ''">$(_EqAssetsGenerated)/android/res</_EqIconOutput>
            <_EqIconOption Condition="'$(_EqPlatform)' == 'ios'">--out</_EqIconOption>
            <_EqIconOutput Condition="'$(_EqPlatform)' == 'ios'">$(_EqIconSetDir)</_EqIconOutput>
            <_EqIconOption Condition="'$(_EqWindowsHead)' == 'true'">--windows</_EqIconOption>
            <_EqIconOutput Condition="'$(_EqWindowsHead)' == 'true'">$(_EqWindowsIco)</_EqIconOutput>
        </PropertyGroup>
        <ItemGroup Condition="'$(_EqPlatform)' == 'ios'">
            <!-- Items born inside a target carry no provenance, and Apple's packaging asks for it.
                 Only the LOCAL one: DefiningProjectFullPath is MSBuild's own reserved metadata. -->
            <ImageAsset Include="$(_EqIconSetDir)/**/*">
                <LocalDefiningProjectFullPath>$(MSBuildProjectFullPath)</LocalDefiningProjectFullPath>
                <LocalMSBuildProjectFullPath>$(MSBuildProjectFullPath)</LocalMSBuildProjectFullPath>
            </ImageAsset>
        </ItemGroup>
        <ItemGroup Condition="'$(_EqIconOption)' != ''">
            <_EqAppIconArgument Include="tool" Value="$(_EqIconToolDir)eqicon.dll" />
            <_EqAppIconArgument Include="source" Option="--source" Value="$(EQuanticAppIconSource)" />
            <_EqAppIconArgument Include="output" Option="$(_EqIconOption)" Value="$(_EqIconOutput)" />
        </ItemGroup>
        <RunProgram Condition="'$(_EqIconOption)' != ''"
              Program="dotnet" Arguments="@(_EqAppIconArgument)" StandardOutputImportance="normal" />
    </Target>

</Project>
