<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>eQuantic.UI.Sdk.Native</PackageId>
        <Description>MSBuild SDK for eQuantic UI apps on devices: an app names the platforms it runs on and writes C#. The shells, the platform minimums and the app manifest come from here.</Description>
        <PackageType>MSBuildSdk</PackageType>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Sdk\**" PackagePath="Sdk" />
    </ItemGroup>

    <!-- The tool the package ships under tools/, as an edge of THIS project's build graph: the
         build that precedes the pack builds it, restored with the rest of the graph, as the one
         instance the solution builds. Nothing links against it (ReferenceOutputAssembly=false),
         nothing copies it here (Private=false), and it is not a package dependency
         (PrivateAssets=All) — CollectIconTool carries its files instead. -->
    <ItemGroup>
        <ProjectReference Include="..\eQuantic.UI.Native.Build\eQuantic.UI.Native.Build.csproj"
            ReferenceOutputAssembly="false" Private="false" PrivateAssets="All" />
    </ItemGroup>

    <!--
        eqicon travels INSIDE the package, collected at pack time from the build the edge above
        guarantees — the shape the web SDK uses for eqc. Sdk.targets looks for it at
        `<package>/tools/net10.0/`, and a package without it fails by name (EQ4001) the moment an
        app needs it, where it used to silently stop drawing app icons and vector catalogs.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);CollectIconTool</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="CollectIconTool">
        <ItemGroup>
            <_IconTool Include="..\eQuantic.UI.Native.Build\bin\$(Configuration)\net10.0\**"
                Exclude="..\eQuantic.UI.Native.Build\bin\$(Configuration)\net10.0\*.pdb" />
        </ItemGroup>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_IconTool)" PackagePath="tools\net10.0" />
        </ItemGroup>
    </Target>

</Project>
