<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>eQuantic.UI.Sdk.Native</PackageId>
        <Description>MSBuild SDK for eQuantic UI apps on devices: an app names the platforms it runs on and writes C#. The shells, the platform minimums and the app manifest come from here.</Description>
        <PackageType>MSBuildSdk</PackageType>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Sdk\**" PackagePath="Sdk" />
    </ItemGroup>

    <!--
        eqicon travels INSIDE the package, staged at pack time from a build of its own project in
        the pack's configuration — the shape the web SDK already uses for eqc. Sdk.targets looks for
        it at `<package>/tools/net10.0/`, and every target that runs it is guarded by Exists(): a
        package without it does not fail, it silently stops drawing app icons and vector catalogs,
        which is what shipped until this.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);CollectIconTool</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="CollectIconTool">
        <!-- Restore;Build, not Build. `Build` alone assumes someone has already restored that project,
             which is true on a machine that has built this repo before and false on every other one —
             CI packs from a clean checkout and got NETSDK1004 for a missing project.assets.json. -->
        <MSBuild Projects="..\eQuantic.UI.Native.Build\eQuantic.UI.Native.Build.csproj" Targets="Restore;Build"
            Properties="Configuration=$(Configuration)" />
        <ItemGroup>
            <_IconTool Include="..\eQuantic.UI.Native.Build\bin\$(Configuration)\net10.0\**"
                Exclude="..\eQuantic.UI.Native.Build\bin\$(Configuration)\net10.0\*.pdb" />
        </ItemGroup>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_IconTool)" PackagePath="tools\net10.0" />
        </ItemGroup>
    </Target>

</Project>
