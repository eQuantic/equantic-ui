<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The macOS platform shell for the Photon engine: a real NSWindow + CAMetalLayer host driving PhotonHost with OS input — zero third-party dependencies (slim typed objc_msgSend bindings, the Metal-spike pattern).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../eQuantic.UI.Primitives/eQuantic.UI.Primitives.csproj" />
<ProjectReference Include="../eQuantic.UI.Native.Hosting/eQuantic.UI.Native.Hosting.csproj" />
    <ProjectReference Include="../eQuantic.UI.Native.Shell.Apple/eQuantic.UI.Native.Shell.Apple.csproj" />
    <ProjectReference Include="../eQuantic.UI.Native.Engine/eQuantic.UI.Native.Engine.csproj" />
    <ProjectReference Include="../eQuantic.UI.Native.Engine.Metal/eQuantic.UI.Native.Engine.Metal.csproj" />
    <ProjectReference Include="../eQuantic.UI.Native.Engine.Reference/eQuantic.UI.Native.Engine.Reference.csproj" />
    <ProjectReference Include="../eQuantic.UI.Native.Framework/eQuantic.UI.Native.Framework.csproj" />
    <ProjectReference Include="../eQuantic.UI.Native.Components/eQuantic.UI.Native.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The accessibility bridge is internal — AppKit reaches it through accessibilityChildren, never
         through a call — but what it hands AppKit is the claim to prove, and only AppKit can answer
         it: the suite builds the elements through the real dispatch on a Mac and reads each role
         back from the element, the way the window's own self-test does (#338). -->
    <InternalsVisibleTo Include="eQuantic.UI.Native.Engine.Tests" />
  </ItemGroup>

</Project>
