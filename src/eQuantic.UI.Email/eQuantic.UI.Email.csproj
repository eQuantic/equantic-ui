<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Email</PackageId>
    <Description>eQuantic.UI EMAIL REALIZER — lowers the shared abstract components (eQuantic.UI.Primitives) to the HTML an email client will actually render: nested tables instead of flex, every style inline, every color literal. A third realizer beside web and Photon; the medium is merely more restrictive. Track M — wiki/EmailRealizer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two alternatives are internal — a message is rendered through EmailRenderer, never by
         picking a visitor — but the contract that binds them is that they REFUSE THE SAME NODES,
         and a whole-message test cannot see it: the HTML part is built first and throws, so the
         text walk is never reached. The suite asks each visitor directly instead. -->
    <InternalsVisibleTo Include="eQuantic.UI.Email.Tests" />
  </ItemGroup>

</Project>
