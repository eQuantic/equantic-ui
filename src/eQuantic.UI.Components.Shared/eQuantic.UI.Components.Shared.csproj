<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Components.Shared</PackageId>
    <Description>eQuantic.UI SHARED component library — components authored ONCE against the abstract vocabulary and tokens (eQuantic.UI.Primitives), realized per target (DOM/CSS on web, Photon pixels on native). Staging assembly: merges into eQuantic.UI.Components as the web realizer lands (docs/SHARED-COMPONENTS-PLAN.md).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Primitives ONLY — a shared component that needed anything platform-specific would be a bug. -->
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Self-contained packaging (like eQuantic.UI.Components): the C# sources ship at tools/source
         so the SDK adds them to the eqc scan and every app transpiles the shared components to JS. -->
    <Content Include="**\*.cs" Exclude="obj\**;bin\**" PackagePath="tools\source\" />
  </ItemGroup>

</Project>
