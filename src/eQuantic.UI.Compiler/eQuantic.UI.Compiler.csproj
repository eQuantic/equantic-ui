<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\eQuantic.UI.Codegen\eQuantic.UI.Codegen.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Compiler</PackageId>
    <Description>Roslyn-based C# to TypeScript/JavaScript compiler for eQuantic.UI components.</Description>
    <!-- The C# 15 preview syntax APIs (WithElementSyntax, Break/ContinueStatementSyntax.Name, …)
         are [Experimental] in Roslyn 5.9. Understanding preview language IS this component's job —
         eqc parses with LanguageVersion.Preview on purpose (see Services/ParseDefaults) — so the
         experimental gate is acknowledged deliberately here, and nowhere else. -->
    <NoWarn>$(NoWarn);RSEXPERIMENTAL006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Scripts\merge-maps.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


    <ItemGroup>
        <!-- The dependency rule, shared with the other assembly rather than written twice: these two
             cannot reference each other, and a rule that drifts here moves constructor arguments. -->
        <Compile Include="../Shared/CapabilityRule.cs" Link="Shared/CapabilityRule.cs" />
    </ItemGroup>
</Project>