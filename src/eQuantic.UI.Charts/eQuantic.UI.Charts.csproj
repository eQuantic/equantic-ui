<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Charts</PackageId>
    <Description>Charts for eQuantic.UI, written once and drawn by every realizer — bars today, the rest of the chart layer as docs/CHARTS-PLAN.md lands it. Colour comes from the theme's data palette; marks are the engine's own shapes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Primitives and the shared component library ONLY — a chart that needed anything
         platform-specific would be a bug: the same code is realized on the web and on Photon. -->
    <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
    <ProjectReference Include="..\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exactly like eQuantic.UI.Components: the library's JS lives INSIDE the runtime (transpiled
         modules embedded in runtime.js, byte-pinned to eqc output by SharedComponentTranspilationTests),
         and the sources ship at tools/source so a consumer's eqc binds the types a page names. -->
    <Content Include="**\*.cs" Exclude="obj\**;bin\**" PackagePath="tools\source\" />
  </ItemGroup>

</Project>
