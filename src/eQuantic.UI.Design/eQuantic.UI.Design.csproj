<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Shipped inside the VS Code extension, never on its own. -->
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>eqdesign</AssemblyName>
        <!-- The protocol is newline-delimited JSON on stdout; nothing else may be written there. -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\eQuantic.UI.Compiler\eQuantic.UI.Compiler.csproj" />
        <!-- ThemeBridge: the preview must be handed the same theme JSON the SSR shell hands the
             client, or every component that reads a token renders unthemed (and some throw). -->
        <ProjectReference Include="..\eQuantic.UI.Web\eQuantic.UI.Web.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Material\eQuantic.UI.Material.csproj" />
        <!-- The render CHILD travels with the host: eqphoton.dll lands beside eqdesign.dll in every
             build and publish, so "next to my own assembly" is the one place it ever needs looking
             for. -->
        <ProjectReference Include="..\eQuantic.UI.Design.Photon\eQuantic.UI.Design.Photon.csproj" />
    </ItemGroup>

</Project>
