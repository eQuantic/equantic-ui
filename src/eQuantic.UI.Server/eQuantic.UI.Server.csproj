<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>eQuantic.UI.Server</PackageId>
    <Description>ASP.NET Core integration for eQuantic.UI - Server Actions and hosting.</Description>
    <!-- The runtime this package SERVES is also the one it SHIPS as a file (tools/runtime/runtime.js),
         which the SDK copies beside an app's modules for the tools that load them outside a server.
         Collected by a target, after BundleRuntime has written it: a static item with an Exists
         condition is answered at evaluation, before the bundle exists on a clean build. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectServedRuntime</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\eQuantic.UI.Web\eQuantic.UI.Web.csproj" />
    <!-- eqc composes the runtime's map after the bundle is written (BundleRuntime), so a cold build has to
         order it before this project. Nothing links against it, nothing copies it here, and it is not a
         dependency of the package: the Server ships the map, never the tool. -->
    <ProjectReference Include="..\eQuantic.Build\eQuantic.Build.csproj"
      ReferenceOutputAssembly="false" Private="false" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- wwwroot/runtime.js is a BUILD OUTPUT, never a committed file: BundleRuntime below writes it
         from ../eQuantic.UI.Sdk/Resources/boot.ts before every build, and it is embedded from there.
         It used to be committed too, and a runtime change that did not happen to rebuild this project
         shipped a Server serving the previous runtime (#273). An explicit Include is an item whether or
         not the file exists at evaluation, so a clean clone builds; the compiler reads it after the
         bundle is written. -->
    <None Remove="wwwroot/runtime.js" />
    <EmbeddedResource Include="wwwroot/runtime.js">
      <LogicalName>eQuantic.UI.Server.runtime.js</LogicalName>
    </EmbeddedResource>
    <!-- The runtime's map, written beside it by the same target and composed by eqc down to the SDK's C#
         where eqc transpiled a module of it (#1108). Answered in Development alone, for the error
         overlay to name a frame inside the SDK. -->
    <None Remove="wwwroot/runtime.js.map" />
    <EmbeddedResource Include="wwwroot/runtime.js.map">
      <LogicalName>eQuantic.UI.Server.runtime.js.map</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\app-shell.html">
      <LogicalName>eQuantic.UI.Server.Templates.app-shell.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Resolve Bun path from embedded runtime packages -->
  <Target Name="ResolveBunForServer" BeforeTargets="BundleRuntime">
    <PropertyGroup>
      <!-- Per-OS+arch bun dir: native arm64 where available, else x64-baseline. -->
      <_EqOsArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_EqOsArch>
      <_BunOsxDir Condition="'$(_EqOsArch)' == 'Arm64'">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.OsxArm64/tools/bun</_BunOsxDir>
      <_BunOsxDir Condition="'$(_BunOsxDir)' == ''">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Osx64/tools/bun</_BunOsxDir>
      <_BunWinDir Condition="'$(_EqOsArch)' == 'Arm64'">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.WinArm64/tools/bun</_BunWinDir>
      <_BunWinDir Condition="'$(_BunWinDir)' == ''">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Win64/tools/bun</_BunWinDir>
      <_BunLinuxDir Condition="'$(_EqOsArch)' == 'Arm64'">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.LinuxArm64/tools/bun</_BunLinuxDir>
      <_BunLinuxDir Condition="'$(_BunLinuxDir)' == ''">$(MSBuildThisFileDirectory)../eQuantic.UI.Runtime.Linux64/tools/bun</_BunLinuxDir>
      <!-- Dev paths (source tree) -->
      <_BunOsxPath>$(_BunOsxDir)/bun-darwin</_BunOsxPath>
      <_BunWinPath>$(_BunWinDir)/bun.exe</_BunWinPath>
      <_BunLinuxPath>$(_BunLinuxDir)/bun-linux</_BunLinuxPath>

      <!-- Resolve based on OS -->
      <_BunPath Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(_BunOsxPath)')">$(_BunOsxPath)</_BunPath>
      <_BunPath Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(_BunWinPath)')">$(_BunWinPath)</_BunPath>
      <_BunPath Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(_BunLinuxPath)')">$(_BunLinuxPath)</_BunPath>
    </PropertyGroup>

    <!-- Extract from zip if executable doesn't exist -->
    <PropertyGroup Condition="'$(_BunPath)' == ''">
      <_BunZipOsx>$(_BunOsxDir)/bun-darwin.zip</_BunZipOsx>
      <_BunZipWin>$(_BunWinDir)/bun.exe.zip</_BunZipWin>
      <_BunZipLinux>$(_BunLinuxDir)/bun-linux.zip</_BunZipLinux>
    </PropertyGroup>

    <!-- Unzip Bun if needed -->
    <Unzip
      SourceFiles="$(_BunZipOsx)"
      DestinationFolder="$(_BunOsxDir)"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(_BunPath)' == '' And Exists('$(_BunZipOsx)')" />
    <Unzip
      SourceFiles="$(_BunZipWin)"
      DestinationFolder="$(_BunWinDir)"
      Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(_BunPath)' == '' And Exists('$(_BunZipWin)')" />
    <Unzip
      SourceFiles="$(_BunZipLinux)"
      DestinationFolder="$(_BunLinuxDir)"
      Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(_BunPath)' == '' And Exists('$(_BunZipLinux)')" />

    <!-- Re-resolve after extraction -->
    <PropertyGroup>
      <_BunPath Condition="'$(_BunPath)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And Exists('$(_BunOsxPath)')">$(_BunOsxPath)</_BunPath>
      <_BunPath Condition="'$(_BunPath)' == '' And $([MSBuild]::IsOSPlatform('Windows')) And Exists('$(_BunWinPath)')">$(_BunWinPath)</_BunPath>
      <_BunPath Condition="'$(_BunPath)' == '' And $([MSBuild]::IsOSPlatform('Linux')) And Exists('$(_BunLinuxPath)')">$(_BunLinuxPath)</_BunPath>
    </PropertyGroup>

    <!-- Make executable on Unix -->
    <Exec Command="chmod +x &quot;$(_BunPath)&quot;"
      Condition="'$(_BunPath)' != '' And !$([MSBuild]::IsOSPlatform('Windows'))" />

    <Error Condition="'$(_BunPath)' == ''"
      Text="Bun runtime not found. Ensure eQuantic.UI.Runtime.* projects are built first." />

    <Message Text="Using Bun from: $(_BunPath)" Importance="high" />
  </Target>

  <!-- No Inputs/Outputs on purpose: the bundle's inputs are the whole runtime source tree, which a
       list here would drift from. It runs on every build and costs about a second. -->
  <!-- Collects what the BUILD wrote, and never bundles again: a pack with no build would otherwise
       write a second bundle after the compiler had embedded the first. -->
  <Target Name="CollectServedRuntime">
    <ItemGroup>
      <TfmSpecificPackageFile Include="wwwroot/runtime.js" PackagePath="tools/runtime/runtime.js" />
    </ItemGroup>
    <Error Condition="!Exists('wwwroot/runtime.js')"
      Text="eQuantic.UI.Server: wwwroot/runtime.js was not produced, and the package would ship no runtime." />
  </Target>

  <!-- The bundle and its map. bun writes an external map only into an output folder, so the entry is
       named there. The map leads to the runtime's TypeScript; ComposeRuntimeMap leads it on to the C#. -->
  <Target Name="BundleRuntime" BeforeTargets="BeforeBuild" DependsOnTargets="ResolveBunForServer">
    <Message Text="Bundling eQuantic UI Runtime..." Importance="high" />
    <MakeDir Directories="wwwroot" />
    <Exec Command="&quot;$(_BunPath)&quot; build ../eQuantic.UI.Sdk/Resources/boot.ts --outdir wwwroot --entry-naming &quot;runtime.[ext]&quot; --sourcemap=external --minify-syntax --minify-whitespace" />
  </Target>

  <!-- eqc leads each module it transpiled from the SDK's C# on to that C#, through the map committed beside
       the module, and names every source from src/ with no text (#1108). After the references are built,
       since eqc is one of them, and before the resources are, since the map is embedded. -->
  <Target Name="ComposeRuntimeMap" BeforeTargets="PrepareResources" DependsOnTargets="BundleRuntime;ResolveProjectReferences">
    <PropertyGroup>
      <_EqcForRuntimeMap>$(MSBuildThisFileDirectory)../eQuantic.Build/bin/$(Configuration)/net10.0/eqc.dll</_EqcForRuntimeMap>
    </PropertyGroup>
    <Error Condition="!Exists('$(_EqcForRuntimeMap)')"
      Text="eQuantic.UI.Server: eqc was not built at '$(_EqcForRuntimeMap)', and the runtime's map cannot be composed. The ProjectReference to eQuantic.Build orders it; a build that skipped it is a broken graph." />
    <Exec Command="dotnet &quot;$(_EqcForRuntimeMap)&quot; compose-map wwwroot/runtime.js.map --names-from &quot;$(MSBuildThisFileDirectory)..&quot;" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="eQuantic.UI.Server.Tests" />
    <!-- The conformance harness writes a .NET dictionary as its pairs by the rule the wire uses,
         EqJson.DictionaryEntries, rather than by a list of its own that could drift from it. -->
    <InternalsVisibleTo Include="eQuantic.UI.Conformance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The name a twin gives a member, shared with eqc and the generator: the server writes each value
         of the hydration manifest under it, so the twin adopts it into the member that reads it. -->
    <Compile Include="../Shared/TwinName.cs" Link="Shared/TwinName.cs" />
  </ItemGroup>

</Project>
