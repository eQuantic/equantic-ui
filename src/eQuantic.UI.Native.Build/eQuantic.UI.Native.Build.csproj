<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Embedded into the SDK packages as a tool — never published on its own. -->
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>eqicon</AssemblyName>
        <Description>Renders an app's icon — declared in C# as an IAppIcon — into the asset catalog its platform installs from.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\eQuantic.UI.Codegen\eQuantic.UI.Codegen.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Native.Components\eQuantic.UI.Native.Components.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Native.Engine.Reference\eQuantic.UI.Native.Engine.Reference.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Native.Shell.Apple\eQuantic.UI.Native.Shell.Apple.csproj" />
        <!-- Both text stacks, so a C# icon's lettering is real glyphs on whichever machine builds it —
             CoreText on a Mac, DirectWrite on Windows. Managed assemblies that touch nothing until
             asked, so each is inert on the other's OS. -->
        <ProjectReference Include="..\eQuantic.UI.Native.Shell.Windows\eQuantic.UI.Native.Shell.Windows.csproj" />
    </ItemGroup>

</Project>
