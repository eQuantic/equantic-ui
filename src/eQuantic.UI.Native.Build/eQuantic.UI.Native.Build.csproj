<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Embedded into the SDK packages as a tool — never published on its own. -->
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>eqicon</AssemblyName>
        <Description>Renders an app's icon — declared in C# as an IAppIcon — into the asset catalog its platform installs from.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\eQuantic.UI.Codegen\eQuantic.UI.Codegen.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Primitives\eQuantic.UI.Primitives.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Components\eQuantic.UI.Components.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Native.Components\eQuantic.UI.Native.Components.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Native.Engine.Reference\eQuantic.UI.Native.Engine.Reference.csproj" />
        <ProjectReference Include="..\eQuantic.UI.Native.Shell.Apple\eQuantic.UI.Native.Shell.Apple.csproj" />
    </ItemGroup>

    <!-- Keep the native SDK's tools folder in step, exactly as eqc does for the web SDK. -->
    <Target Name="UpdateNativeSdkTools" AfterTargets="Build">
        <ItemGroup>
            <_IconToolFiles Include="$(OutputPath)**/*" Exclude="$(OutputPath)*.pdb" />
        </ItemGroup>
        <!-- Both SDKs run this tool: a phone installs an icon and so does a browser. -->
        <Copy SourceFiles="@(_IconToolFiles)"
            DestinationFiles="@(_IconToolFiles->'..\eQuantic.UI.Sdk.Native\tools\net10.0\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_IconToolFiles)"
            DestinationFiles="@(_IconToolFiles->'..\eQuantic.UI.Sdk\tools\net10.0\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
