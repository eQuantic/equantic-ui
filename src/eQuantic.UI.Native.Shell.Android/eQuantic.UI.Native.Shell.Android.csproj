<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsBindingProject>false</IsBindingProject>
        <Description>The Android platform shell for the Photon engine: an Activity whose SurfaceView the engine presents into, driven by the Choreographer, with touches routed into the same PhotonHost pipeline every other shell uses.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../eQuantic.UI.Primitives/eQuantic.UI.Primitives.csproj" />
        <ProjectReference Include="../eQuantic.UI.Native.Engine/eQuantic.UI.Native.Engine.csproj" />
        <ProjectReference Include="../eQuantic.UI.Native.Engine.Reference/eQuantic.UI.Native.Engine.Reference.csproj" />
        <ProjectReference Include="../eQuantic.UI.Native.Framework/eQuantic.UI.Native.Framework.csproj" />
        <ProjectReference Include="../eQuantic.UI.Native.Components/eQuantic.UI.Native.Components.csproj" />
        <ProjectReference Include="../eQuantic.UI.Native.Hosting/eQuantic.UI.Native.Hosting.csproj" />
    </ItemGroup>

</Project>
