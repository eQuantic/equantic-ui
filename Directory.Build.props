<Project>
    <PropertyGroup>
        <Version>0.2.0-preview.55</Version>
        <Authors>eQuantic</Authors>
        <Company>eQuantic</Company>
        <Product>eQuantic.UI</Product>
        <Copyright>Copyright © 2026 eQuantic</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/eQuantic/equantic-ui</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- What nuget.org indexes and shows beside every package: the site, the search tags, and a
             description for the packages that have none of their own (a project's own <Description>
             wins, because the project file is evaluated after this one). -->
        <PackageProjectUrl>https://ui.equantic.tech</PackageProjectUrl>
        <PackageTags>dotnet;csharp;ui;components;cross-platform;write-once;aspnetcore;ssr;gpu;metal;vulkan;flutter-inspired;transpiler;design-system;ios;android;macos;windows</PackageTags>
        <Description>eQuantic.UI — write components once in C#; realized as DOM and CSS on the web or as GPU pixels on macOS, iOS, Android and Windows. No JavaScript, no Swift, no platform files, one .NET SDK.</Description>

        <!-- The doc comments are the only description of a component's parameters that exists, and
             the visual editor's inspector reads them off the SYMBOL. An app's own components arrive
             in that compilation as source, so their prose is already there; the framework's arrive
             as metadata, and Roslyn can only read comments for those from the XML beside the
             assembly. Without this the inspector could describe a developer's own Button and not
             ours. CS1591 is off because "missing a doc comment" is not a build error here — the
             comments that exist are the point, not blanket coverage. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- The tree built with ~170 warnings nobody had ever read, because every build command in
             this repo and its CI greps for `error`. They were not cosmetic: an Android API-30 call
             under an API-29 guard, two unguarded calls that would throw on any device below 28, an
             iOS override promising non-null where UIKit passes null, a doc comment left on a method
             that had moved, and a test that set a flag it never asserted. Each of those printed on
             every build for months.

             A warning nobody reads is not a warning, so the build fails on one. That is also what
             a consumer building the SDK from source inherits — equantic-code took on 71 of these
             and lost the zero-warning bar it was holding, which is how they were noticed at all. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)assets\Icon.png" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>