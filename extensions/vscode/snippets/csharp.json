{
  "eQuantic Page": {
    "prefix": "eq-page",
    "body": [
      "[Page(\"/${1:route}\", Title = \"${2:Title}\")]",
      "public sealed class ${3:Name} : StatefulComponent",
      "{",
      "    private int _count;",
      "",
      "    public override VisualNode Build(ComponentContext context)",
      "    {",
      "        var theme = context.Theme;",
      "",
      "        return Box(new BoxStyle",
      "        {",
      "            Width = SizeValue.Fill,",
      "            Background = theme.Background,",
      "            Padding = EdgeInsets.All(Space.S6),",
      "        },",
      "        Column(gap: Space.S4, children: [",
      "            Text(\\$\"Count: {_count}\", TypeRole.Display, theme.TextPrimary),",
      "            Button(\"Up\", onPressed: () => SetState(() => _count++)),",
      "            $0",
      "        ]));",
      "    }",
      "}"
    ],
    "description": "A routable eQuantic.UI page — write-once StatefulComponent, declarative factories"
  },
  "eQuantic Stateless Component": {
    "prefix": "eq-comp",
    "body": [
      "public sealed class ${1:Name} : StatelessComponent",
      "{",
      "    public ${1}(${2:string label})",
      "    {",
      "        ${3:Label} = ${4:label};",
      "    }",
      "",
      "    public ${5:string} ${3:Label} { get; init; }",
      "",
      "    public override VisualNode Build(ComponentContext context)",
      "    {",
      "        var theme = context.Theme;",
      "",
      "        return Box(new BoxStyle",
      "        {",
      "            Padding = EdgeInsets.All(Space.S4),",
      "            Background = theme.Surface,",
      "            CornerRadius = new CornerRadii(theme.Shape(ShapeScale.Medium)),",
      "        },",
      "        Column(gap: Space.S1, children: [",
      "            $0",
      "        ]));",
      "    }",
      "}"
    ],
    "description": "A write-once component. The build generates a factory named after it, so callers write Name(...) with no new."
  },
  "eQuantic Stateful Component": {
    "prefix": "eq-stateful",
    "body": [
      "public sealed class ${1:Name} : StatefulComponent",
      "{",
      "    private ${2:bool} ${3:_open};",
      "",
      "    public override VisualNode Build(ComponentContext context)",
      "    {",
      "        var theme = context.Theme;",
      "",
      "        return Column(gap: Space.S2, children: [",
      "            Button(\"${4:Toggle}\", onPressed: () => SetState(() => ${3:_open} = !${3:_open})),",
      "            $0",
      "        ]);",
      "    }",
      "}"
    ],
    "description": "A component with internal state, mutated through SetState"
  },
  "eQuantic Server Action": {
    "prefix": "eq-action",
    "body": [
      "[ServerAction]",
      "public async Task<${1:string}> ${2:LoadData}(${3})",
      "{",
      "    $0",
      "}"
    ],
    "description": "A method executed on the server and called from the browser by RPC"
  },
  "eQuantic Row": {
    "prefix": "eq-row",
    "body": ["Row(gap: Space.${1:S2}, children: [", "    $0", "])"],
    "description": "A horizontal flex container"
  },
  "eQuantic Column": {
    "prefix": "eq-col",
    "body": ["Column(gap: Space.${1:S4}, children: [", "    $0", "])"],
    "description": "A vertical flex container"
  }
}
