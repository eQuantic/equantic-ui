{
  "name": "equantic-ui",
  "displayName": "eQuantic UI",
  "description": "Live preview and visual editing for eQuantic.UI screens, straight from the C# buffer.",
  "version": "0.1.0",
  "publisher": "equantic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eQuantic/equantic-ui"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "equanticUI.openPreview",
        "title": "Open Preview",
        "category": "eQuantic UI",
        "icon": "$(preview)"
      },
      {
        "command": "equanticUI.startInspect",
        "title": "Inspect Elements",
        "category": "eQuantic UI",
        "icon": "$(inspect)"
      },
      {
        "command": "equanticUI.stopInspect",
        "title": "Stop Inspecting",
        "category": "eQuantic UI",
        "icon": "$(inspect)"
      },
      {
        "command": "equanticUI.restartSidecar",
        "title": "Restart Design Host",
        "category": "eQuantic UI",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "equanticUI.openPreview",
          "when": "resourceLangId == csharp && !activeWebviewPanelId",
          "group": "navigation"
        },
        {
          "command": "equanticUI.startInspect",
          "when": "activeWebviewPanelId == 'equanticUI.preview' && !equanticUI.inspecting",
          "group": "navigation@1"
        },
        {
          "command": "equanticUI.stopInspect",
          "when": "activeWebviewPanelId == 'equanticUI.preview' && equanticUI.inspecting",
          "group": "navigation@1"
        },
        {
          "command": "equanticUI.restartSidecar",
          "when": "activeWebviewPanelId == 'equanticUI.preview'",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "equanticUI.startInspect",
          "when": "false"
        },
        {
          "command": "equanticUI.stopInspect",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "eQuantic UI",
      "properties": {
        "equanticUI.sidecarPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `eqdesign.dll` (the design host). Leave empty to use the copy shipped with the extension."
        },
        "equanticUI.runtimePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `runtime.js`. Leave empty to use the one the project's own build produced at `wwwroot/_equantic/runtime.js`."
        },
        "equanticUI.compileDebounceMs": {
          "type": "number",
          "default": 400,
          "description": "How long typing must pause before the preview recompiles."
        },
        "equanticUI.diagnoseDebounceMs": {
          "type": "number",
          "default": 150,
          "description": "How long typing must pause before errors are re-checked. Cheaper than a compile, so it runs sooner."
        }
      }
    },
    "snippets": [
      {
        "language": "csharp",
        "path": "./snippets/csharp.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/verify-webview.mjs",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "verify": "node scripts/verify-webview.mjs",
    "test": "npm run compile && node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
