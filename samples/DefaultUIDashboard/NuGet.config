<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The sample builds against the framework's PROJECTS (Sdk.props swaps every eQuantic package for its
    project beside a source tree), so its only source is the one the framework's own dependencies come
    from. It named a local folder of packed eQuantic packages, which no flow writes any more: the restore
    of the sample needs the framework's third-party packages too (tusdotnet, since the Server receives
    uploads), and a folder that does not exist answered NU1301 for them.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
