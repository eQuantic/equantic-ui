<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>eQuantic.Wallet.iOS</RootNamespace>
    <ApplicationId>tech.equantic.wallet</ApplicationId>
    <ApplicationTitle>Wallet</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <!--
    The APP is shared source, not a shared binary: the same two files the desktop head compiles.
    A project reference would drag the macOS shell onto a phone, which is the opposite of the point.
  -->
  <ItemGroup>
    <Compile Include="../WalletMobile/WalletApp.cs" Link="WalletApp.cs" />
    <Compile Include="../WalletMobile/WalletData.cs" Link="WalletData.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/eQuantic.UI.Primitives/eQuantic.UI.Primitives.csproj" />
    <ProjectReference Include="../../src/eQuantic.UI.Components/eQuantic.UI.Components.csproj" />
    <ProjectReference Include="../../src/eQuantic.UI.Native.Shell.iOS/eQuantic.UI.Native.Shell.iOS.csproj" />
  </ItemGroup>

</Project>
