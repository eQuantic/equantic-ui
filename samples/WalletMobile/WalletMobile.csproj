<Project>
    <!-- The native SDK is consumed from the LOCAL checkout, exactly as the website consumes the web
         one: a gap found here must be fixable in the framework and visible on the next build. As a
         package this line is the project's `Sdk="eQuantic.UI.Sdk.Native"` attribute. -->
    <Import Project="../../src/eQuantic.UI.Sdk.Native/Sdk/Sdk.props" />

    <PropertyGroup>
        <!-- The devices this app runs on. Everything else — which shell, which platform minimum,
             which manifest keys — follows from these. -->
        <TargetFrameworks>net10.0;net10.0-ios;net10.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>

        <ApplicationId>tech.equantic.wallet</ApplicationId>
        <ApplicationTitle>Wallet</ApplicationTitle>
    </PropertyGroup>

    <!-- The screens, written once in a class library the web head references too. This head keeps
         only what is its own: the device it asks for, the entitlements and the command line. -->
    <ItemGroup>
        <ProjectReference Include="../WalletShared/WalletShared.csproj" />
    </ItemGroup>

    <Import Project="../../src/eQuantic.UI.Sdk.Native/Sdk/Sdk.targets" />
</Project>
