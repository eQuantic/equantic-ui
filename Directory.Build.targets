<Project>
    <!--
      NU5128 says the nuspec declares a dependency group for a framework with no lib/ or ref/ beside
      it. For twelve packages here that is the DESIGN, not a mistake: a package with
      IncludeBuildOutput=false ships content — runtime.js, an embedded bun, an MSBuild SDK, the
      templates, a generator under analyzers/ — and carries dependencies so a consumer restores the
      rest. There is no assembly to add, so the warning's own remedy ("add lib or ref assemblies")
      is the one thing that would be wrong.

      In .targets rather than .props: this reads IncludeBuildOutput, which each project sets AFTER
      Directory.Build.props has been evaluated. Conditioned on it rather than listed, so a new
      content-only package is covered the day it is written and a package that grows an assembly
      loses the exemption by itself.
    -->
    <PropertyGroup Condition="'$(IncludeBuildOutput)' == 'false'">
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <!--
      THE PUBLIC API IS DECLARED, so a break fails the pull request that makes it (#242).

      Every public symbol of a shipping assembly is written down in PublicAPI.Shipped.txt, and a
      change that is not declared fails the build: RS0016 names a signature that appeared, RS0017
      one that went. With TreatWarningsAsErrors on since #126, that is a failure rather than a
      note. The release notes' list of breaks then comes from the build — the *REMOVED* lines of a
      release and the diff of the Shipped files between two tags — instead of from a signature
      diff someone remembers to run. Twice it was not: .54 shipped three real breaks unlisted,
      and .55 had to have the tool rebuilt because it lived in a scratchpad that was gone.

      DERIVED, never listed. A project ships an assembly when it packs and includes its build
      output, which is the same pair of properties the exemption above reads, and for the same
      reason it is read HERE: both are set in each project's body, after Directory.Build.props has
      been evaluated. So the twelve that ship content rather than a library — the two generators,
      the runtime and its six bun packages, the two SDKs, the templates — are out by what they
      already say about themselves, and a new package is covered the day it is written.

      AND A PACKAGE DIRECTORY, which is the half those two properties cannot say. This file governs
      the whole repository, so without it the condition also caught five projects that ship nothing
      and only leave the properties at their SDK defaults: the three samples, the AOT harness and
      tools/AuthoringProbe. They stayed quiet by accident — the analyzer says nothing until a
      PublicAPI file exists — and the day one appeared they would have failed a build that
      `scripts/public-api.sh` cannot fix, because its own project set is src/*/[!.]*.csproj.
      TWO DEFINITIONS OF ONE SET IS THE BUG.

      So this matches that glob rather than merely "somewhere under src/": the project's PARENT
      directory must be src/ itself. Under-src/ was the first attempt and it was still wider than
      the script, because the two template consumers live at
      src/eQuantic.UI.Templates/templates/<name>/ and leave both properties at their defaults —
      nested, so `src/*/[!.]*.csproj` never sees them. One rule, spelled the same on both sides.
    -->
    <PropertyGroup>
        <_EqPackageSourceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)src'))</_EqPackageSourceRoot>
        <_EqProjectParent>$([MSBuild]::NormalizeDirectory($([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)'))))</_EqProjectParent>
        <_EqDeclaresPublicApi>false</_EqDeclaresPublicApi>
        <_EqDeclaresPublicApi Condition="'$(IsPackable)' != 'false' AND '$(IncludeBuildOutput)' != 'false' AND '$(_EqProjectParent)' == '$(_EqPackageSourceRoot)'">true</_EqDeclaresPublicApi>
    </PropertyGroup>

    <ItemGroup Condition="'$(_EqDeclaresPublicApi)' == 'true'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0"
                          PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <!--
      AND THE FILES MUST EXIST, which the item group above cannot say. An AdditionalFiles include
      naming a file that is not there produces no item and no complaint, and the analyzer reports
      NOTHING at all until it has one — so a new packable project under src/ compiles green with
      its entire public surface undeclared, and every later change to that surface goes unnoticed
      too. The instrument that was supposed to fail would simply never have started.

      It is the same hole the release step refuses at (`ship`), a whole release later. This is that
      refusal moved to the build that creates the project, where fixing it costs one command.
      `scripts/public-api.sh update` creates the pair before it builds anything, so it remains the
      bootstrap and is never blocked by this.
    -->
    <Target Name="EqRequireDeclaredPublicApi" BeforeTargets="CoreCompile"
            Condition="'$(_EqDeclaresPublicApi)' == 'true'">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt') OR !Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
               Text="$(MSBuildProjectName) ships an assembly, so its public API must be declared — but PublicAPI.Shipped.txt and/or PublicAPI.Unshipped.txt is missing beside the project. Without both, the public API analyzer reports nothing and the whole surface would ship undeclared. Run ./scripts/public-api.sh update, then read the diff it writes: that diff is the API review." />
    </Target>

    <!--
      WHAT A RELEASE PROMISES, AND TO WHICH ASSEMBLY (#899, #324).

      Every project that ships an assembly has a surface class:
        contract      what an app compiles against. The compatibility promise covers it.
        tool          the SDK's own tools: the compiler and the code writers. A package publishes
                      them (the site's playground compiles C# through the compiler's), and their
                      surface serves the SDK. It is never promised.
        experimental  the native track, which 1.0 does not promise yet.
      Derived from the name here and nowhere else, and a project may set _EqSurface itself. A new
      project is contract, the stricter answer and the one the promise covers.

      The class is written into the assembly as AssemblyMetadata, .NET's own key and value, so a
      test, a tool or a person reads it from what ships. An experimental assembly carries .NET's own
      ExperimentalAttribute too: a project that uses one fails with EQX0001 until it says it means
      to. Measured before it was chosen, on three class libraries: an assembly marked with the same
      id uses another one in silence, so the native assemblies need nothing between them, and
      eQuantic.UI.Sdk.Native suppresses the id for the app that chose the native track.
    -->
    <PropertyGroup Condition="'$(_EqDeclaresPublicApi)' == 'true'">
        <_EqSurface Condition="'$(_EqSurface)' == '' AND $(MSBuildProjectName.StartsWith('eQuantic.UI.Native.'))">experimental</_EqSurface>
        <_EqSurface Condition="'$(_EqSurface)' == '' AND ('$(MSBuildProjectName)' == 'eQuantic.UI.Compiler' OR '$(MSBuildProjectName)' == 'eQuantic.UI.Codegen')">tool</_EqSurface>
        <_EqSurface Condition="'$(_EqSurface)' == ''">contract</_EqSurface>
        <_EqUnshippedFile Condition="'$(_EqUnshippedFile)' == ''">$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt</_EqUnshippedFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(_EqDeclaresPublicApi)' == 'true'">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>eQuantic.Surface</_Parameter1>
            <_Parameter2>$(_EqSurface)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExperimentalAttribute" Condition="'$(_EqSurface)' == 'experimental'">
            <_Parameter1>EQX0001</_Parameter1>
            <UrlFormat>https://github.com/eQuantic/equantic-ui/wiki/Photon#the-native-track-is-experimental-in-10</UrlFormat>
        </AssemblyAttribute>
    </ItemGroup>

    <!--
      This repository's own projects that ship nothing use the native track because they are the
      SDK: the native assemblies' tests, the icon tool, the Photon design host. A project that ships
      nothing passes nothing on, so the mark has nobody here to warn. A shipping assembly never gets
      this: a contract assembly that used the native track would pass it on to every app, and the
      native ones are marked themselves, which silences it between them.
    -->
    <PropertyGroup Condition="'$(_EqDeclaresPublicApi)' != 'true'">
        <NoWarn>$(NoWarn);EQX0001</NoWarn>
    </PropertyGroup>

    <!--
      A STABLE VERSION REMOVES NO MEMBER OF THE CONTRACT (#323).

      The preview's rule (CLAUDE.md, "No member survives to keep an old shape alive") removes a member
      the day its shape changes, and it holds while the version carries a prerelease label. The day
      the label goes, at the 1.0 cut, the promise starts: a contract project's PublicAPI.Unshipped.txt
      holds no *REMOVED* line, since the release would break every app that upgrades. The way on is an
      [Obsolete] that names the major it leaves in, and the removal itself in that major's preview.
      Read here, at the build, so it fails the pull request that removes the member and not the
      release a week later, and the release's own step needs no check of its own.

      The lines go through a task written in C#, never through MSBuild's items or its text: a
      declared signature holds `*` and `?`, which an item takes for a wildcard (#880 measured what
      else MSBuild does to text on its way).
    -->
    <UsingTask TaskName="EqRefuseRemovalAtStableVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Unshipped ParameterType="System.String" Required="true" />
            <Project ParameterType="System.String" Required="true" />
            <Version ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Linq" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                const string Mark = "*REMOVED*";
                var removed = System.IO.File.Exists(Unshipped)
                    ? System.IO.File.ReadAllLines(Unshipped).Where(line => line.StartsWith(Mark)).Select(line => line.Substring(Mark.Length)).ToList()
                    : new System.Collections.Generic.List<string>();
                if (removed.Count > 0)
                    Log.LogError(
                        Project + " is part of the contract, and its PublicAPI.Unshipped.txt removes " + removed.Count
                        + " member(s) at version " + Version + ", which carries no prerelease label: " + string.Join(" | ", removed.Take(3))
                        + (removed.Count > 3 ? " | ..." : "")
                        + ". A stable version removes no member of the contract. Mark the member [Obsolete] with an EQO id, a URL and the major it leaves in (CLAUDE.md),"
                        + " or move the version to the next major's preview, where the removal belongs.");
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="EqStableVersionRemovesNoContractMember" BeforeTargets="CoreCompile"
            Condition="'$(_EqDeclaresPublicApi)' == 'true' AND '$(_EqSurface)' == 'contract' AND '$(Version.Contains(`-`))' == 'false'">
        <EqRefuseRemovalAtStableVersion Unshipped="$(_EqUnshippedFile)" Project="$(MSBuildProjectName)" Version="$(Version)" />
    </Target>

    <!--
      A PACKAGE'S README IS THE REPOSITORY'S, WITH ITS PICTURES' ADDRESSES WRITTEN OUT (#880).

      README.md names a picture by its path in the repository, `assets/readme/<file>`, so GitHub
      draws it on every branch, in a fork, and in the pull request that takes it again. nuget.org
      draws nothing from a relative path: there a picture needs its full address, and it names the
      release's own tag, `v<PackageVersion>`, so a package's page goes on showing the screens of
      ITS version, whatever main shows later.

      A program writes the copy, and the README's text never crosses MSBuild. It was tried: on a
      Mac MSBuild takes a backslash in an item for a path separator, so the README's `\e` was
      packed as `/e`, and WriteLinesToFile cuts an item at every semicolon and reads the `%20` of a
      badge's address as a space. A task written here is compiled when a project first packs, 0.3
      seconds a process, and holds no file of the tree.

      ReadmeCapturesTests runs the target and compares what it wrote with README.md, byte for
      byte but for the addresses, and scripts/check-package-readme.cs reads the readme inside
      every package CI packs.
    -->
    <UsingTask TaskName="AddressReadmePictures" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Readme ParameterType="System.String" Required="true" />
            <Pictures ParameterType="System.String" Required="true" />
            <Address ParameterType="System.String" Required="true" />
            <Destination ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var text = File.ReadAllText(Readme).Replace("](" + Pictures, "](" + Address);
                if (!File.Exists(Destination) || File.ReadAllText(Destination) != text)
                {
                    Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(Destination)));
                    File.WriteAllText(Destination, text);
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <PropertyGroup>
        <EqPackageReadme Condition="'$(EqPackageReadme)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'package-readme', 'README.md'))</EqPackageReadme>
    </PropertyGroup>

    <Target Name="WritePackageReadme" BeforeTargets="_GetPackageFiles">
        <AddressReadmePictures
            Readme="$(MSBuildThisFileDirectory)README.md"
            Pictures="assets/readme/"
            Address="$(RepositoryUrl.Replace('https://github.com/', 'https://raw.githubusercontent.com/'))/v$(PackageVersion)/assets/readme/"
            Destination="$(EqPackageReadme)" />
        <ItemGroup>
            <None Include="$(EqPackageReadme)" Pack="true" PackagePath="\" />
        </ItemGroup>
    </Target>

    <!--
      Development helper target: clears NuGet cache for eQuantic packages
      Usage: dotnet msbuild -t:ClearEQuanticCache
    -->
    <Target Name="ClearEQuanticCache">
        <PropertyGroup>
            <_NuGetCache>$(NuGetPackageRoot)</_NuGetCache>
            <_NuGetCache Condition="'$(_NuGetCache)' == ''">$(HOME)/.nuget/packages</_NuGetCache>
        </PropertyGroup>

        <ItemGroup>
            <!-- REACTIVE, never a list: the hand-written list was written when the SDK had ten
                 packages and silently stopped covering it — no native package, no sdk.native, no
                 arm64 runtime was ever cleared, so a local-feed consumer rebuilt the SDK and kept
                 restoring the stale 1.0.0-dev from the cache. Whatever equantic.ui.* the cache
                 holds is what gets cleared. -->
            <_EQuanticCacheDirs
                Include="$([System.IO.Directory]::GetDirectories('$(_NuGetCache)', 'equantic.*'))"
                Condition="Exists('$(_NuGetCache)')" />
        </ItemGroup>

        <RemoveDir Directories="@(_EQuanticCacheDirs)" />
        <Message Text="Cleared eQuantic packages from NuGet cache: $(_NuGetCache)" Importance="high" />
    </Target>

</Project>
