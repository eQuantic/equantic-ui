<Project>
    <!--
      NU5128 says the nuspec declares a dependency group for a framework with no lib/ or ref/ beside
      it. For twelve packages here that is the DESIGN, not a mistake: a package with
      IncludeBuildOutput=false ships content — runtime.js, an embedded bun, an MSBuild SDK, the
      templates, a generator under analyzers/ — and carries dependencies so a consumer restores the
      rest. There is no assembly to add, so the warning's own remedy ("add lib or ref assemblies")
      is the one thing that would be wrong.

      In .targets rather than .props: this reads IncludeBuildOutput, which each project sets AFTER
      Directory.Build.props has been evaluated. Conditioned on it rather than listed, so a new
      content-only package is covered the day it is written and a package that grows an assembly
      loses the exemption by itself.
    -->
    <PropertyGroup Condition="'$(IncludeBuildOutput)' == 'false'">
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <!--
      THE PUBLIC API IS DECLARED, so a break fails the pull request that makes it (#242).

      Every public symbol of a shipping assembly is written down in PublicAPI.Shipped.txt, and a
      change that is not declared fails the build: RS0016 names a signature that appeared, RS0017
      one that went. With TreatWarningsAsErrors on since #126, that is a failure rather than a
      note. The release notes' list of breaks then comes from the build — the *REMOVED* lines of a
      release and the diff of the Shipped files between two tags — instead of from a signature
      diff someone remembers to run. Twice it was not: .54 shipped three real breaks unlisted,
      and .55 had to have the tool rebuilt because it lived in a scratchpad that was gone.

      DERIVED, never listed. A project ships an assembly when it packs and includes its build
      output, which is the same pair of properties the exemption above reads, and for the same
      reason it is read HERE: both are set in each project's body, after Directory.Build.props has
      been evaluated. So the twelve that ship content rather than a library — the two generators,
      the runtime and its six bun packages, the two SDKs, the templates — are out by what they
      already say about themselves, and a new package is covered the day it is written.
    -->
    <ItemGroup Condition="'$(IsPackable)' != 'false' AND '$(IncludeBuildOutput)' != 'false'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0"
                          PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <!--
      Development helper target: clears NuGet cache for eQuantic packages
      Usage: dotnet msbuild -t:ClearEQuanticCache
    -->
    <Target Name="ClearEQuanticCache">
        <PropertyGroup>
            <_NuGetCache>$(NuGetPackageRoot)</_NuGetCache>
            <_NuGetCache Condition="'$(_NuGetCache)' == ''">$(HOME)/.nuget/packages</_NuGetCache>
        </PropertyGroup>

        <ItemGroup>
            <!-- REACTIVE, never a list: the hand-written list was written when the SDK had ten
                 packages and silently stopped covering it — no native package, no sdk.native, no
                 arm64 runtime was ever cleared, so a local-feed consumer rebuilt the SDK and kept
                 restoring the stale 1.0.0-dev from the cache. Whatever equantic.ui.* the cache
                 holds is what gets cleared. -->
            <_EQuanticCacheDirs
                Include="$([System.IO.Directory]::GetDirectories('$(_NuGetCache)', 'equantic.*'))"
                Condition="Exists('$(_NuGetCache)')" />
        </ItemGroup>

        <RemoveDir Directories="@(_EQuanticCacheDirs)" />
        <Message Text="Cleared eQuantic packages from NuGet cache: $(_NuGetCache)" Importance="high" />
    </Target>

</Project>
