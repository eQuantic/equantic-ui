# Dependencies
node_modules/
.pnpm-store/
bun.lockb

# Build outputs
bin/
obj/
dist/
out/
nupkgs/
*.nupkg

# Tools (large binaries)
# Tools (large binaries) - Runtime Packages
src/eQuantic.UI.Runtime.*/tools/bun/bun
src/eQuantic.UI.Runtime.*/tools/bun/bun-darwin
src/eQuantic.UI.Runtime.*/tools/bun/bun-linux
src/eQuantic.UI.Runtime.*/tools/bun/bun.exe
!src/eQuantic.UI.Runtime.*/tools/bun/*.zip
src/eQuantic.UI.Sdk/tools/
# Refreshed by eQuantic.UI.Native.Build on every build and staged into the package at PACK time
# (CollectIconTool) — tracking it committed a Debug binary and churned on every configuration flip.
src/eQuantic.UI.Sdk.Native/tools/

# IDE
.idea/
.vs/
*.user
*.suo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Test results
TestResults/
coverage/
# …but a test project's Coverage/ folder holds INSTRUMENTS, which are source and not tool output.
# The rule above is case-insensitive on macOS and on Windows, so it swallows `Coverage/` whole: two
# test files and a committed BCL baseline once shipped in no commit while the commit message said
# otherwise. That was patched for ONE project, which left the mine armed everywhere else — and it
# went off again the next time somebody added a Coverage folder to another test project. Negated
# for every test project, so the next one does not have to discover it a third time.
!tests/**/Coverage/
!tests/**/Coverage/**

**/wwwroot/_equantic/*
# Embedded bun: only the .zip is tracked; the extracted binary is produced at build time.
src/eQuantic.UI.Runtime.*/tools/bun/bun-darwin
src/eQuantic.UI.Runtime.*/tools/bun/bun-linux
src/eQuantic.UI.Runtime.*/tools/bun/bun.exe

# Playwright e2e output
tests/e2e/playwright-report/
tests/e2e/test-results/

# The VS Code extension's packaging output: 30 MB of published host, and the archive itself.
extensions/vscode/host/
extensions/vscode/runtime/
extensions/vscode/*.vsix
extensions/vscode/icon.png

# Only the marker, never the packages a local build drops there.
artifacts/packages/*
!artifacts/packages/.gitkeep

# Local NuGet feed for end-to-end consumer validation (the recipe: wiki BuildFlow,
# "Consuming an unreleased SDK from local packages"):
# packed on demand, never committed.
artifacts/local-feed/
